local DefaultProperties = {
	BorderSizePixel = 0,
	BackgroundColor3 = Color3.fromRGB(0, 55, 75),
	FontFace = Font.fromName("Sarpanch"),
	TextColor3 = Color3.fromRGB(255, 255, 255),
	TextScaled = true,
	ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	StrokeSizingMode = Enum.StrokeSizingMode.ScaledSize,
	ScrollBarThickness = 0,
	ScrollBarImageTransparency = 1,
	ResetOnSpawn = false
}

local LeaveTechnicalAttributesAndTags = false

function DecompileAssets()
	local function LoadInstance(InstanceToLoad, InstanceParent, StarterDecompile)
		for Name, Properties in InstanceToLoad do
			local NewInstance = Instance.new(Properties.ClassName)
			NewInstance.Name = Properties.Name

			if NewInstance.ClassName == "ScreenGui" then
				NewInstance.Enabled = false
			elseif NewInstance.ClassName == "Part" or NewInstance.ClassName == "WedgePart" then
				NewInstance.TopSurface = Enum.SurfaceType.Smooth
				NewInstance.BottomSurface = Enum.SurfaceType.Smooth
			end

			for DefaultProperty, Value in DefaultProperties do
				local HasProperty, _ = pcall(function()
					NewInstance[DefaultProperty] = NewInstance[DefaultProperty]
				end)

				if HasProperty and Properties[DefaultProperty] == nil then
					if DefaultProperty ~= "BackgroundColor3" or (DefaultProperty == "BackgroundColor3" and NewInstance.BackgroundTransparency < 1) then
						NewInstance[DefaultProperty] = Value
					end
				end
			end

			for Property, Value in Properties do
				if Property == "Files" then
					LoadInstance(Value, NewInstance)
				elseif Property == "Tags" then
					for _, TagName in Value do
						NewInstance:AddTag(TagName)
					end
				elseif Property == "Attributes" then
					for AttributeName, AttributeValue in Value do
						NewInstance:SetAttribute(AttributeName, AttributeValue)
					end
				elseif Property == "ColorMapContent" or Property == "Texture" or Property == "SoundId" then
					if Property == "ColorMapContent" or Property == "Texture" then
						NewInstance.Texture = "rbxassetid://"..Value
					else
						NewInstance[Property] = "rbxassetid://"..Value
					end
				elseif Property == "MeshId" then
					NewInstance:ApplyMesh(game.InsertService:CreateMeshPartAsync("rbxassetid://"..Value,
						Properties.CollisionFidelity or Enum.CollisionFidelity.Box,
						Properties.RenderFidelity or Enum.RenderFidelity.Automatic)
					)
				elseif Property == "Scale" then
					NewInstance:ScaleTo(Value)
				elseif Property == "CFrame" then
					if NewInstance.ClassName == "Model" then
						NewInstance:PivotTo(Value)
					end
				else
					if Property ~= "ClassName" and Property ~= "RenderFidelity" and Property ~= "CollisionFidelity" then
						NewInstance[Property] = Value
					end
				end
			end
			
			if StarterDecompile then
				local function ObjectPropertySet(InstanceTo)	
					for _, PropertyInitial in {"Part", "Attachment"} do
						local Property1 = PropertyInitial.."0"
						local Property2 = PropertyInitial.."1"
						
						local HasProperty1 = pcall(function()
							return InstanceTo[Property1]
						end)
						
						local HasProperty2 = pcall(function()
							return InstanceTo[Property2]
						end)
						
						if HasProperty1 and HasProperty2 then
							for _, Tag in InstanceTo:GetTags() do
								if string.find(Tag, "CompileWeld") then
									local WeldNumber = string.split(Tag, " ")[2]
									
									for _, CompileInstance1 in NewInstance:GetDescendants() do
										if CompileInstance1:HasTag("CompileInstance1 "..WeldNumber) or CompileInstance1:HasTag("CompileInstance2 "..WeldNumber) then
											for _, CompileInstance2 in NewInstance:GetDescendants() do
												if CompileInstance2:HasTag("CompileInstance1 "..WeldNumber) or CompileInstance2:HasTag("CompileInstance2 "..WeldNumber) then
													local Part0 = nil
													local Part1 = nil

													if CompileInstance1:HasTag("CompileInstance1 "..WeldNumber) and CompileInstance2:HasTag("CompileInstance2 "..WeldNumber) then
														Part0 = CompileInstance1
														Part1 = CompileInstance2
													elseif CompileInstance1:HasTag("CompileInstance2 "..WeldNumber) and CompileInstance2:HasTag("CompileInstance1 "..WeldNumber) then
														Part0 = CompileInstance2
														Part1 = CompileInstance1
													else
														if NewInstance:HasTag("CompileInstance1 "..WeldNumber) then
															if CompileInstance1:HasTag("CompileInstance2 "..WeldNumber) then
																Part0 = NewInstance
																Part1 = CompileInstance1
															elseif CompileInstance2:HasTag("CompileInstance2 "..WeldNumber) then
																Part0 = NewInstance
																Part1 = CompileInstance2
															end
														elseif NewInstance:HasTag("CompileInstance2 "..WeldNumber) then
															if CompileInstance1:HasTag("CompileInstance1 "..WeldNumber) then
																Part0 = CompileInstance1
																Part1 = NewInstance
															elseif CompileInstance2:HasTag("CompileInstance1 "..WeldNumber) then
																Part0 = CompileInstance2
																Part1 = NewInstance
															end
														end
													end

													if Part0 and Part1 then
														InstanceTo[Property1] = Part0
														InstanceTo[Property2] = Part1
													end
												end
											end
										end
									end
								end
							end
						end
					end
					
					for ClassName, Property in {
						["Model"] = "PrimaryPart",
						["ObjectValue"] = "Value"
						} do
						for _, Tag in InstanceTo:GetTags() do
							if InstanceTo.ClassName == ClassName and string.find(Tag, "CompilePrimaryObject") then
								local PrimaryNumber = string.split(Tag, " ")[2]

								for _, PrimaryInstance in NewInstance:GetDescendants() do
									if PrimaryInstance:HasTag("CompilePrimaryValue "..PrimaryNumber) then
										InstanceTo[Property] = PrimaryInstance
									end
								end
							end
						end
					end
				end
				
				ObjectPropertySet(NewInstance)

				for _, ObjectProperty in NewInstance:GetDescendants() do
					ObjectPropertySet(ObjectProperty)
				end
			end

			NewInstance.Parent = InstanceParent
		end
	end
	
	for AssetName, Asset in Assets do
		LoadInstance({Asset}, game.ReplicatedStorage, true)
	end
end

task.wait(5)

print("Decompile Start")

DecompileAssets()

print("Decompile Finish")
