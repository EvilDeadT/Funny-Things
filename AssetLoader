					end
				elseif Property == "ColorMapContent" or Property == "Texture" or Property == "SoundId" then
					if Property == "ColorMapContent" or Property == "Texture" then
						NewInstance.Texture = "rbxassetid://"..Value
					else
						NewInstance[Property] = "rbxassetid://"..Value
					end
				elseif Property == "MeshId" then
					NewInstance:ApplyMesh(game.InsertService:CreateMeshPartAsync(Value,
						Properties.CollisionFidelity or Enum.CollisionFidelity.Box,
						Properties.RenderFidelity or Enum.RenderFidelity.Automatic)
					)
				elseif Property == "Scale" then
					NewInstance:ScaleTo(Value)
				elseif Property == "CFrame" then
					if NewInstance.ClassName == "Model" then
						NewInstance:PivotTo(Value)
					end
				else
					if Property ~= "ClassName" and Property ~= "RenderFidelity" and Property ~= "CollisionFidelity" then
						NewInstance[Property] = Value
					end
				end
			end
			
			if StarterDecompile then
				local function ObjectPropertySet(ObjectProperty)					
					if ObjectProperty.ClassName == "Model" and ObjectProperty:GetAttribute("CompilePrimary1") then
						for _, PrimaryObject in NewInstance:GetDescendants() do
							if ObjectProperty:GetAttribute("CompilePrimary1") == PrimaryObject:GetAttribute("CompilePrimary2") then
								ObjectProperty.PrimaryPart = PrimaryObject
							end
						end
					elseif ObjectProperty.ClassName == "ObjectValue" and ObjectProperty:GetAttribute("CompileValue1") then
						for _, PrimaryObject in NewInstance:GetDescendants() do
							if ObjectProperty:GetAttribute("CompileValue1") == PrimaryObject:GetAttribute("CompileValue2") then
								ObjectProperty.Value = PrimaryObject
							end
						end
					elseif ObjectProperty.ClassName == "Weld" or ObjectProperty.ClassName == "WeldConstraint" or ObjectProperty.ClassName == "ManualWeld"
						or ObjectProperty.ClassName == "Motor6D" or ObjectProperty.ClassName == "Beam" then
						for _, Tag in ObjectProperty:GetTags() do
							if string.find(Tag, "CompileWeld") then
								local WeldNumber = string.split(Tag, " ")[2]
								
								for _, PrimaryObject1 in NewInstance:GetDescendants() do
									if PrimaryObject1:HasTag("CompileObject1 "..WeldNumber) or PrimaryObject1:HasTag("CompileObject2 "..WeldNumber) then
										for _, PrimaryObject2 in NewInstance:GetDescendants() do
											if PrimaryObject2:HasTag("CompileObject1 "..WeldNumber) or PrimaryObject2:HasTag("CompileObject2 "..WeldNumber) then
												local Part0 = nil
												local Part1 = nil
												
												if PrimaryObject1:HasTag("CompileObject1 "..WeldNumber) and PrimaryObject2:HasTag("CompileObject2 "..WeldNumber) then
													Part0 = PrimaryObject1
													Part1 = PrimaryObject2
												elseif PrimaryObject1:HasTag("CompileObject2 "..WeldNumber) and PrimaryObject2:HasTag("CompileObject1 "..WeldNumber) then
													Part0 = PrimaryObject2
													Part1 = PrimaryObject1
												else
													if NewInstance:HasTag("CompileObject1 "..WeldNumber) then
														if PrimaryObject1:HasTag("CompileObject2 "..WeldNumber) then
															Part0 = NewInstance
															Part1 = PrimaryObject1
														elseif PrimaryObject2:HasTag("CompileObject2 "..WeldNumber) then
															Part0 = NewInstance
															Part1 = PrimaryObject2
														end
													elseif NewInstance:HasTag("CompileObject2 "..WeldNumber) then
														if PrimaryObject1:HasTag("CompileObject1 "..WeldNumber) then
															Part0 = PrimaryObject1
															Part1 = NewInstance
														elseif PrimaryObject2:HasTag("CompileObject1 "..WeldNumber) then
															Part0 = PrimaryObject2
															Part1 = NewInstance
														end
													end
												end
												
												if Part0 and Part1 then
													if ObjectProperty.ClassName == "Beam" then
														ObjectProperty.Attachment0 = Part0
														ObjectProperty.Attachment1 = Part1
													else
														ObjectProperty.Part0 = Part0
														ObjectProperty.Part1 = Part1
													end
												end
											end
										end
									end
								end
							end
						end
					end
				end
				
				ObjectPropertySet(NewInstance)

				for _, ObjectProperty in NewInstance:GetDescendants() do
					ObjectPropertySet(ObjectProperty)
				end
			end

			NewInstance.Parent = InstanceParent
		end
	end
	
	for AssetName, Asset in Assets do
		LoadInstance({Asset}, game.ReplicatedStorage, true)
	end
end

task.wait(5)

print("Decompile Start")

DecompileAssets()

print("Decompile Finish")
