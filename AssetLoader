for _, RoomAssetPart in game.ReplicatedStorage.CustomAssets:GetDescendants() do
	if RoomAssetPart:IsA("BasePart") and RoomAssetPart:GetAttribute("CompileAssetCategory") and RoomAssetPart:GetAttribute("CompileAssetType") then
		if game.ReplicatedStorage.CustomAssets.RoomAssets:FindFirstChild(RoomAssetPart:GetAttribute("CompileAssetCategory")) then
			if game.ReplicatedStorage.CustomAssets.RoomAssets[RoomAssetPart:GetAttribute("CompileAssetCategory")]:FindFirstChild(RoomAssetPart:GetAttribute("CompileAssetType")) then
				if game.ReplicatedStorage.CustomAssets.RoomAssets[RoomAssetPart:GetAttribute("CompileAssetCategory")][RoomAssetPart:GetAttribute("CompileAssetType")]:FindFirstChild(RoomAssetPart.Name) then
					if LoadRoomAssets then
						local AssetModel = game.ReplicatedStorage.CustomAssets.RoomAssets[RoomAssetPart:GetAttribute("CompileAssetCategory")][RoomAssetPart:GetAttribute("CompileAssetType")][RoomAssetPart.Name]:Clone()
				
						if AssetModel then
							AssetModel:PivotTo(CFrame.new(RoomAssetPart.Position) * CFrame.fromOrientation(math.rad(RoomAssetPart.Orientation.X), math.rad(RoomAssetPart.Orientation.Y), math.rad(RoomAssetPart.Orientation.Z)))
						end
					
						if RoomAssetPart:GetAttribute("CompileAssetScale") then
							AssetModel:ScaleTo(RoomAssetPart:GetAttribute("CompileAssetScale"))
						end
						
						if RoomAssetPart:GetAttribute("CompileAssetColor") then
							if AssetModel.Name == "NormalDoor" then
								AssetModel.Frame.Frame.Color = RoomAssetPart:GetAttribute("CompileAssetColor")
								AssetModel.Door.Gear1.Color = RoomAssetPart:GetAttribute("CompileAssetColor")
								AssetModel.Door.Gear2.Color = RoomAssetPart:GetAttribute("CompileAssetColor")
							elseif AssetModel.Name == "BigDoor" then
								AssetModel.Door.BigRoomDoor.Frame.Frane.Color = RoomAssetPart:GetAttribute("CompileAssetColor")
							end
						end
				
						AssetModel.Parent = RoomAssetPart.Parent
						RoomAssetPart:Destroy()
						
						game.Players.LocalPlayer.PlayerGui.FunnyMenu.Events.RoomAssetInteraction:Fire(AssetModel)
					else
						RoomAssetPart.CanCollide = false
						
						for _, Direction in {"Front", "Left", "Back", "Right", "Top", "Bottom"} do
							local BaldiDecal = Instance.new("Decal")
							BaldiDecal.Name = "BaldiMoment"
							BaldiDecal.Texture = "rbxassetid://16576306848"
							BaldiDecal.Face = Enum.NormalId[Direction]
							BaldiDecal.Parent = RoomAssetPart
						end
					end
				end
			end
		end
	end
end

if not LeaveTechnicalAttributesAndTags then
	for _, ObjectProperty in game.ReplicatedStorage.CustomAssets:GetDescendants() do
		for _, Tag in ObjectProperty:GetTags() do
			for _, TagName in {"CompileWeld", "CompileInstance1", "CompileInstance2", "CompilePrimaryObject", "CompilePrimaryValue"} do
					if string.find(Tag, TagName) then
					ObjectProperty:RemoveTag(Tag)
				end
			end
		end
	end
