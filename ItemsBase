function ItemGive(Item, PickedUp)
	local ItemValue = Instance.new("NumberValue")
	ItemValue.Name = Item
	ItemValue.Value = -1
	ItemValue:SetAttribute("PickedUp", PickedUp)
	
	local ItemStats = game.ReplicatedStorage.CustomAssets.Items[Item].Stats
	
	if ItemStats:FindFirstChild("MaxUses") then
		ItemValue.Value = ItemStats.MaxUses.Value
	elseif ItemStats:FindFirstChild("MaxCharge") then
		ItemValue.Value = ItemStats.MaxCharge.Value
	end

	ItemValue.Parent = UI.Inventory
	
	if PickedUp then
		return ItemValue
	end
end

function ItemRemove(Item, AllCopies)
	if type(Item) ~= "string" then
		if Item.Parent == UI.Inventory then
			Item:Destroy()
		else
			warn("Item is not a Instance but not a string too")
		end
	elseif UI.Inventory:FindFirstChild(Item) then
		if not AllCopies then
			UI.Inventory[Item]:Destroy()
		else
			for _, ItemCopy in UI.Inventory:GetChildren() do
				if ItemCopy.Name == Item then
					ItemCopy:Destroy()
				end
			end
		end
	end
end

function ItemEquip(Item, ByToolbar, OnGive)
	if game.Players.LocalPlayer:GetAttribute("ItemsRestricted") or not PlayerMain.Toolbar.CanEquip or not UI.Inventory:FindFirstChild(Item.Name) then
		return
	end

	if not (type(Item.Name) == "string" or type(Item.Name) == "number") then
		return warn("Do normal request for item equip")
	end

	local ItemFolder = game.ReplicatedStorage.CustomAssets.Items[Item.Name]

	if not ItemFolder then
		return warn("No Item Folder For "..Item.Name)
	end
	
	if not ByToolbar then
		PlayerMain.Toolbar.UnSelect()
		PlayerMain.Toolbar.CurrentSelected = Item
		
		game.Players.LocalPlayer.Character:SetAttribute("ToolName", Item.Name)
		PlayerMain.Device.UI.PC.BaseControls.UseItem.Visible = true
		PlayerMain.Device.UI.PC.BaseControls.OpenWheel.Visible = true
		PlayerMain.Device.UI.Mobile.BaseControls.Use.Visible = true
		PlayerMain.Device.UI.Controller.BaseControls.OpenWheel.Visible = true

		game.TweenService:Create(Item, TweenInfo.new(0.2), {
			Size = UDim2.new(1, 0, 1, 0)
		}):Play()
	end
	
	PlayerMain.Device.UI.PC.BaseControls.InspectButton.Visible = if ItemFolder.Animations:FindFirstChild("Inspect") then true else false
	PlayerMain.Device.UI.PC.BaseControls.DropItem.Visible = if not ItemFolder.Stats:FindFirstChild("NoDrop") then true else false
	PlayerMain.Device.UI.PC.BaseControls.ChargeItem.Visible = if ItemFolder.Stats:FindFirstChild("MaxCharge") then true else false
	PlayerMain.Device.UI.Mobile.BaseControls.Batteries.Visible = if ItemFolder.Stats:FindFirstChild("MaxCharge") then true else false
	PlayerMain.Device.UI.Controller.BaseControls.DropItem.Visible = if not ItemFolder.Stats:FindFirstChild("NoDrop") then true else false
	PlayerMain.Device.UI.Controller.BaseControls.ChargeItem.Visible = if ItemFolder.Stats:FindFirstChild("MaxCharge") then true else false
	
	local ToolbarKeys = {}
	if ItemFolder.Stats:FindFirstChild("Throwable") or UI.Settings.CanThrowEveryItem.Value then
		ToolbarKeys[Enum.KeyCode.F] = "Throw"
		ToolbarKeys[Enum.KeyCode.ButtonL2] = "Throw"
		
		PlayerMain.Device.UI.PC.BaseControls.BindKey1.TextLabel.Text = "Throw Bunny"
		PlayerMain.Device.UI.PC.BaseControls.BindKey1.ImageButton.ImageLabel.Image = ""
		PlayerMain.Device.UI.PC.BaseControls.BindKey1.ImageButton.TextLabel.Text = "F"
		PlayerMain.Device.UI.Mobile.BaseControls.BindKey1.Icon.Image = "rbxassetid://77046733419404"
		PlayerMain.Device.UI.Controller.BaseControls.BindKey1.TextLabel.Text = "Throw Bunny"
	end
	
	if ItemFolder.Animations:FindFirstChild("Inspect") then
		PlayerMain.Device.UI.PC.BaseControls.InspectButton.ImageButton.TextLabel.Text = "T"
	end
	
	if next(ToolbarKeys) then
		PlayerMain.Toolbar.SetUpKeys(
			ToolbarKeys,
			if ToolbarKeys[Enum.KeyCode.F] then {BindKey1 = "Throw"} else nil
		)
	end

	if UI.Events.UIModule:Invoke("FindByThread", ItemFolder, "Models.Equip") then
		local ItemModel = ItemFolder.Models.Equip:Clone()
		ItemModel.Name = Item.Name

		if ItemModel:FindFirstChild("Handle") then
			ItemModel.Handle.Part0 = game.Players.LocalPlayer.Character:WaitForChild("RightHand")
			ItemModel.Parent = game.Players.LocalPlayer.Character
		end
	end

	if ItemFolder:FindFirstChild("Animations") then
		for _, Anim in ItemFolder.Animations:GetChildren() do
			LoadAnimation(Item.Name, Anim)
		end
	end
	
	for _, Anim in game.ReplicatedStorage.CustomAssets.Items.Base.Animations:GetChildren() do
		local AlreadyLoaded = LoadAnimation(Item.Name, Anim)
		
		if Anim.Name == "Throw" and not AlreadyLoaded then
			ItemAnim[Item.Name].Throw:GetMarkerReachedSignal("Throw"):Connect(function()
				if not (PlayerMain.Toolbar.CurrentSelected and (game.ReplicatedStorage.CustomAssets.Items[Item.Name].Stats:FindFirstChild("Throwable") or UI.Settings.CanThrowEveryItem.Value)) then
					return
				end
				
				for _, ItemFile in UI.Inventory:GetChildren() do					
					if ItemFile:FindFirstChild("ToolbarIcon")
						and ItemFile.ToolbarIcon:IsA("ObjectValue")
						and ItemFile.ToolbarIcon.Value == PlayerMain.Toolbar.CurrentSelected
						and game.Players.LocalPlayer.Character:FindFirstChild(Item.Name) then
						ItemDrop(ItemFile, {
							Power = 200,
							ModelCFrame = game.Players.LocalPlayer.Character[Item.Name]:GetPivot()
						})
					end
				end
			end)
			
			ItemAnim[Item.Name].Throw.Stopped:Connect(function()
				game.Players.LocalPlayer:SetAttribute("AnimBusy", false)
			end)
		end
	end

	if ItemAnim[Item.Name] then
		if ItemAnim[Item.Name].Unequip then
			ItemAnim[Item.Name].Unequip:Stop()
		end
		
		if ItemAnim[Item.Name].Throw then
			ItemAnim[Item.Name].Throw:Stop()
		end
		
		if ItemAnim[Item.Name].Equip then
			ItemAnim[Item.Name].Equip:Play()
		end

		if ItemAnim[Item.Name].Idle then
			ItemAnim[Item.Name].Idle:Play()
		end
	end

	UI.Events.ItemOnEquip:Fire(Item, ItemAnim[Item.Name])
	
	if game.ReplicatedStorage.GameSettings.Modifier:FindFirstChild("Butterfingers")
		and math.random(1, 5) == 1
		and CanButterfingers
		and not OnGive
		and not game.ReplicatedStorage.CustomAssets.Items[PlayerMain.Toolbar.CurrentSelected.Name].Stats:FindFirstChild("NoDrop") then
		CanButterfingers = false
		
		task.delay(0.2, function()
			game.ReplicatedStorage.CustomAssets.Items.Base.Sounds.Butterfingers:Play()
			
			for _, ItemFile in UI.Inventory:GetChildren() do
				if ItemFile:FindFirstChild("ToolbarIcon") and ItemFile.ToolbarIcon:IsA("ObjectValue") and (ItemFile.ToolbarIcon.Value == Item or PlayerMain.Toolbar.CurrentSelected == Item) then
					ItemFile:SetAttribute("ButterfingersDrop", true)
					ItemDrop(ItemFile)
				end
			end
		end)
	end
end

function ItemUnequip(Item, ByToolbar)
	if game.Players.LocalPlayer:GetAttribute("ItemsRestricted") or not game.Players.LocalPlayer.PlayerGui.Main.BotFrame.ToolBar:FindFirstChild(Item.Name) then
		return
	end

	if not (type(Item.Name) == "string" or type(Item.Name) == "number") then
		return warn("Do normal request for item unequip")
	end

	local ItemModel = game.Players.LocalPlayer.Character:FindFirstChild(Item.Name)

	if ItemModel then
		if ItemModel:FindFirstChild("Handle") then
			ItemModel.Handle.Part0 = nil
		end

		ItemModel:Destroy()
	end

	if ItemAnim[Item.Name] then
		if ItemAnim[Item.Name].Equip then
			ItemAnim[Item.Name].Equip:Stop()
		end
		
		if ItemAnim[Item.Name].Throw then
			ItemAnim[Item.Name].Throw:Stop()
		end
		
		if ItemAnim[Item.Name].Unequip then
			ItemAnim[Item.Name].Unequip:Play()
		end

		if ItemAnim[Item.Name].Idle then
			ItemAnim[Item.Name].Idle:Stop()
		end
	end
	
	if not ByToolbar then
		PlayerMain.Toolbar.SetUpKeys({}, {})
		
		if PlayerMain.Toolbar.CurrentSelected == Item then
			PlayerMain.Toolbar.CurrentSelected = nil
		end
		
		PlayerMain.Toolbar.SelectionChangedEvent:Fire(nil)
		game.Players.LocalPlayer.Character:SetAttribute("ToolName", "nil")
		PlayerMain.Device.UI.PC.BaseControls.UseItem.Visible = false
		PlayerMain.Device.UI.PC.BaseControls.InspectButton.Visible = false
		PlayerMain.Device.UI.PC.BaseControls.DropItem.Visible = false
		PlayerMain.Device.UI.PC.BaseControls.ChargeItem.Visible = false
		PlayerMain.Device.UI.PC.BaseControls.OpenWheel.Visible = false
		PlayerMain.Device.UI.Mobile.BaseControls.Use.Visible = false
		PlayerMain.Device.UI.Mobile.BaseControls.Batteries.Visible = false
		PlayerMain.Device.UI.Controller.BaseControls.DropItem.Visible = false
		PlayerMain.Device.UI.Controller.BaseControls.ChargeItem.Visible = false
		PlayerMain.Device.UI.Controller.BaseControls.OpenWheel.Visible = false
		
		game.TweenService:Create(Item, TweenInfo.new(0.2), {
			Size = UDim2.new(0.8, 0, 0.8, 0)
		}):Play()
	end
	
	PlayerMain.Device.UI.PC.BaseControls.InspectButton.ImageButton.TextLabel.Text = "M3"
	PlayerMain.Device.UI.PC.BaseControls.BindKey1.ImageButton.ImageLabel.Image = "rbxassetid://15230742967"
	PlayerMain.Device.UI.PC.BaseControls.BindKey1.ImageButton.TextLabel.Text = ""
	
	UI.Events.ItemOnUnequip:Fire(Item, ItemAnim[Item.Name])
end

function ItemDrop(Item, Thrown)
	ItemRemove(Item)
	
	local ItemFolder = game.ReplicatedStorage.CustomAssets.Items[Item.Name]

	if not ItemFolder then
		return warn("No Item Folder For "..Item.Name)
	end

	if UI.Events.UIModule:Invoke("FindByThread", ItemFolder, "Models.Drop") then
		local ItemModel = ItemFolder.Models.Drop:Clone()
		ItemModel.Name = Item.Name
		
		if not Thrown then
			ItemModel:PivotTo(game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame)
			ItemModel.PrimaryPart.AssemblyLinearVelocity = Vector3.new(
				game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame.LookVector.X * 20,
				-1,
				game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame.LookVector.Z * 20
			)

			task.delay(5, function()
				if ItemModel and ItemModel.Parent and ItemModel.PrimaryPart and ItemModel.PrimaryPart:IsA("BasePart") then
					ItemModel.PrimaryPart.Anchored = true
				end
			end)
		else
			ItemModel:PivotTo(Thrown.ModelCFrame)
			ItemModel.PrimaryPart.AssemblyLinearVelocity = game.Workspace.CurrentCamera.CFrame.LookVector * Thrown.Power
			
			if UI.Events.UIModule:Invoke("FindByThread", game.ReplicatedStorage.CustomAssets.Items[Item.Name], "Sounds.Thrown") then
				local ThrownSound = game.ReplicatedStorage.CustomAssets.Items[Item.Name].Sounds.Thrown:Clone()
				ThrownSound.TimePosition = ThrownSound:GetAttribute("SoundStart") or 0
				ThrownSound.Parent = ItemModel.PrimaryPart
				ThrownSound.Ended:Once(function()
					if ThrownSound and ThrownSound.Parent then
						ThrownSound:Destroy()
					end
				end)
				ThrownSound:Play()
			end
		end
		
		task.delay(if Thrown then 2 else 0, function()
			local DisplayName = ItemModel.Name
			if game.ReplicatedStorage.CustomAssets.Items[Item.Name].Stats:FindFirstChild("DisplayName") then
				DisplayName = game.ReplicatedStorage.CustomAssets.Items[Item.Name].Stats.DisplayName.Value
			elseif ItemModel:GetAttribute("DisplayName") then
				DisplayName = ItemModel:GetAttribute("DisplayName")
			end
			
			local Prompt = ItemModel:FindFirstChildWhichIsA("ProximityPrompt", true)
			Prompt:SetAttribute("Display", DisplayName)
			Prompt:SetAttribute("Custom", true)

			Prompt.Triggered:Connect(function()
				if PlayerMain.PlayerDead or PlayerMain.IsGhost or PlayerMain.HangerImmunity then
					return
				end

				game.ReplicatedStorage.CustomAssets.Items.Base.Sounds.Pickup:Play()
				
				if ItemModel and ItemModel.Parent then
					ItemModel:Destroy()
				end

				local AddedItem = ItemGive(Item.Name, true)

				if game.ReplicatedStorage.GameSettings.Modifier:FindFirstChild("Butterfingers")
					and math.random(1, 5) == 1
					and CanButterfingers
					and not game.ReplicatedStorage.CustomAssets.Items[PlayerMain.Toolbar.CurrentSelected.Name].Stats:FindFirstChild("NoDrop") then
					CanButterfingers = false
					
					task.delay(0.2, function()
						game.ReplicatedStorage.CustomAssets.Items.Base.Sounds.Butterfingers:Play()
						AddedItem:SetAttribute("ButterfingersDrop", true)
						ItemDrop(AddedItem)
					end)
				end
			end)
		end)
		
		ItemModel.Parent = game.Workspace.GameplayFolder.DroppedItems
	end
end

UI.Events.ItemGive.Event:Connect(ItemGive)
UI.Events.ItemRemove.Event:Connect(ItemRemove)
UI.Events.ItemEquip.Event:Connect(ItemEquip)
UI.Events.ItemUnequip.Event:Connect(ItemUnequip)
UI.Events.ItemDrop.Event:Connect(ItemDrop)

PlayerMain.CharacterDied:Connect(function()
	if PlayerMain.Toolbar.CurrentSelected and game.ReplicatedStorage.CustomAssets.Items:FindFirstChild(PlayerMain.Toolbar.CurrentSelected.Name) then
		ItemUnequip(PlayerMain.Toolbar.CurrentSelected)
	end
	
	for _, Item in UI.Inventory:GetChildren() do
		if not (Item:FindFirstChild("ToolbarIcon") and Item.ToolbarIcon:IsA("ObjectValue")) then
			print("No ObjectValue or ToolbarIcon is not a ObjectValue. Item: "..Item:GetFullName())
			
			continue
		end
		
		if not game.ReplicatedStorage.CustomAssets.Items[Item.Name].Stats:FindFirstChild("NoDrop") then
			ItemDrop(Item)
		else
			ItemRemove(Item)
		end
	end
end)

game.UserInputService.InputBegan:Connect(function(Input, GameProcessed)
	if PlayerMain.Toolbar.CurrentSelected
		and game.ReplicatedStorage.CustomAssets.Items:FindFirstChild(PlayerMain.Toolbar.CurrentSelected.Name)
		and Input.UserInputType ~= Enum.UserInputType.MouseButton1
		and not GameProcessed then
		UI.Events.ItemOnInput:Fire(PlayerMain.Toolbar.CurrentSelected, ItemAnim[PlayerMain.Toolbar.CurrentSelected.Name], Input)
		
		if Input.KeyCode == Enum.KeyCode.G and not game.ReplicatedStorage.CustomAssets.Items[PlayerMain.Toolbar.CurrentSelected.Name].Stats:FindFirstChild("NoDrop") then
			for _, Item in UI.Inventory:GetChildren() do
				if Item:FindFirstChild("ToolbarIcon") and Item.ToolbarIcon:IsA("ObjectValue") and Item.ToolbarIcon.Value == PlayerMain.Toolbar.CurrentSelected then
					ItemDrop(Item)
				end
			end
		elseif Input.KeyCode == Enum.KeyCode.F
			and (game.ReplicatedStorage.CustomAssets.Items[PlayerMain.Toolbar.CurrentSelected.Name].Stats:FindFirstChild("Throwable") or UI.Settings.CanThrowEveryItem.Value)
			and not game.Players.LocalPlayer:GetAttribute("AnimBusy") then			
			game.Players.LocalPlayer:SetAttribute("AnimBusy", true)
			ItemAnim[PlayerMain.Toolbar.CurrentSelected.Name].Throw:Play()
		end
	end
end)

for _, Item in game.ReplicatedStorage.CustomAssets.Items:GetChildren() do
	if Item.Name ~= "Base" then
		if not game.RunService:IsStudio() then
			loadstring(game:HttpGet("https://raw.githubusercontent.com/EvilDeadT/Funny-Things/refs/heads/main/Item"..Item.Name))()
		else
			game.Players.LocalPlayer.PlayerScripts:FindFirstChild("Item"..Item.Name, true).Enabled = true
		end
		
		print("ItemScript "..Item.Name.." loaded")
	end
end
