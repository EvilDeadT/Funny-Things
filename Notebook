function NotebookStart(ForcedProblem)
	if game.Players.LocalPlayer.PlayerGui:FindFirstChild("NotebookUI") then
		return true
	end
	
	game.UserInputService.MouseIconEnabled = true
	
	local function GenerateProblem()
		local Problem = {}
		local PossibleQuestions = {}
		
		if UI.SubModifiers:FindFirstChild("Schoolhouse") then
			
		end
		
		if #PossibleQuestions <= 0 then
			PossibleQuestions = {"Addition", "Subtraction", "Multiplication"}
		end
		
		local Question = ForcedProblem or PossibleQuestions[math.random(1, #PossibleQuestions)]
		
		Problem.Type = Question
		
		if Question == "Addition" then
			local Number1 = math.random(-20, 20)
			local Number2 = math.random(0, 15)
			
			Problem.Question = Number1.." + "..Number2.." = ?"
			Problem.Answer = Number1 + Number2
			Problem.Wrong = {}
			
			for _ = 1, 4 do
				if math.random(1, 2) == 1 then
					table.insert(Problem.Wrong, (Number1 + Number2) + math.random(1, 15))
				else
					table.insert(Problem.Wrong, (Number1 + Number2) - math.random(1, 15))
				end
			end
		elseif Question == "Subtraction" then
			local Number1 = math.random(-20, 20)
			local Number2 = math.random(0, 15)
			Problem.Question = Number1.." - "..Number2.." = ?"
			Problem.Answer = Number1 - Number2
			Problem.Wrong = {}

			for _ = 1, 4 do
				local Wrong = Number1 * Number2

				if math.random(1, 2) == 1 then
					Wrong += math.random(1, 15)
				else
					Wrong -= math.random(1, 15)
				end

				table.insert(Problem.Wrong, Wrong)
			end
		elseif Question == "Multiplication" then
			local Number1 = math.random(4, 13)
			local Number2 = math.random(0, 9)
			
			Problem.Question = Number1.." x "..Number2.." = ?"
			Problem.Answer = Number1 * Number2
			Problem.Wrong = {}

			for _ = 1, 4 do
				local Wrong = Number1 * Number2

				if math.random(1, 2) == 1 then
					Wrong += math.random(1, 15)
				else
					Wrong -= math.random(1, 15)
				end

				table.insert(Problem.Wrong, Wrong)
			end
		elseif Question == "Division" then
			local Number1 = math.random(3, 19)
			
			if Number1 % 2 ~= 0 then
				Number1 += 1
			end
			
			local Number2 = math.random(1, Number1)

			Problem.Question = Number1.." / "..Number2.." = ?"
			Problem.Answer = math.round((Number1 / Number2) * 10) / 10
			Problem.Wrong = {}

			for _ = 1, 4 do
				local Wrong = math.round((Number1 / Number2) * 10) / 10
				
				if math.random(1, 2) == 1 then
					Wrong += math.random(0, 1)
				else
					Wrong -= math.random(0, 1)
				end
				
				if Wrong ~= math.round(Wrong) or Wrong == math.round((Number1 / Number2) * 10) / 10 then
					if math.random(1, 3) == 1 or Wrong == math.round((Number1 / Number2) * 10) / 10 then
						if not table.find(Problem.Wrong, (math.round(Wrong + 0.5) * 10) / 10) then
							Wrong += 0.5
						else
							Wrong -= 0.5
						end
					end
				end
				
				if table.find(Problem.Wrong, Wrong) then
					local NumberAddition = math.random(1, 3)
					if NumberAddition == 1 then
						Wrong += 0.3
						if table.find(Problem.Wrong, Wrong) then
							if math.random(1, 2) == 1 then
								Wrong += 0.5
								if table.find(Problem.Wrong, Wrong) then
									Wrong += 0.6
								end
							else
								Wrong += 0.6
								if table.find(Problem.Wrong, Wrong) then
									Wrong += 0.5
								end
							end
						end
					elseif NumberAddition == 2 then
						Wrong += 0.6
						if table.find(Problem.Wrong, Wrong) then
							if math.random(1, 2) == 1 then
								Wrong += 0.3
								if table.find(Problem.Wrong, Wrong) then
									Wrong += 0.5
								end
							else
								Wrong += 0.5
								if table.find(Problem.Wrong, Wrong) then
									Wrong += 0.3
								end
							end
						end
					else
						Wrong += 0.5
						if table.find(Problem.Wrong, Wrong) then
							if math.random(1, 2) == 1 then
								Wrong += 0.3
								if table.find(Problem.Wrong, Wrong) then
									Wrong += 0.6
								end
							else
								Wrong += 0.6
								if table.find(Problem.Wrong, Wrong) then
									Wrong += 0.3
								end
							end
						end
					end
				end
				
				table.insert(Problem.Wrong, (math.round(Wrong * 10) / 10))
			end
		elseif Question == "Degrees" then
			local Number1 = math.random(1, 9)
			local Number2 = math.random(1, 4)
			
			if Number1 >= 4 and Number1 < 5 then
				Number2 = math.random(1, 3)
			elseif Number1 >= 5 then
				Number2 = math.random(1, 2)
			end
			
			local Answer = Number1
			
			if Number2 > 1 then
				for _ = 1, (Number2 - 1) do
					Answer *= Number1
				end
			end

			Problem.Question = Number1.."^"..Number2.." = ?"
			Problem.Answer = Answer
			Problem.Wrong = {}
			
			for _ = 1, 4 do
				local Wrong = Answer
				
				if Answer <= Number1 or (Answer > Number1 and math.random(1, 2) == 1) then
					Wrong += math.random(1, 15)
				else
					Wrong -= math.random(1, math.clamp((Answer - Number1), 1, 15))
				end
				
				table.insert(Problem.Wrong, Wrong)
			end
		elseif Question == "Roots" then
			local Number1 = math.random(1, 9)
			local Number2 = Number1 * Number1

			Problem.Question = "√"..Number2.." = ?"
			Problem.Answer = Number1
			Problem.Wrong = {}

			for _ = 1, 4 do
				local Wrong = Number1

				if math.random(1, 2) == 1 then
					Wrong += math.random(1, 10)
				else
					Wrong -= math.random(1, 10)
				end

				table.insert(Problem.Wrong, Wrong)
			end
		elseif Question == "Factorials" then
			local Number1 = math.random(1, 5)
			local Number2 = 1
			
			if Number1 > 1 then
				for FactorialNumber = 1, Number1 do
					Number2 *= FactorialNumber
				end
			end

			Problem.Question = Number1.."! = ?"
			Problem.Answer = Number2
			Problem.Wrong = {}

			for _ = 1, 4 do
				local Wrong = Number2

				if math.random(1, 2) == 1 then
					Wrong += math.random(1, 15)
				else
					Wrong -= math.random(1, 15)
				end

				table.insert(Problem.Wrong, Wrong)
			end
		elseif Question == "DerivedFunctions" then
			local Number1 = math.random(1, 15)
			local Number2 = math.random(1, 7)
			
			Problem.Question = "f(x) = "..Number1.."^"..Number2.."\nf'(x) = ?"
			Problem.Answer = (Number2 * Number1).."^"..(Number2 - 1)
			Problem.Wrong = {}
		elseif Question == "Quiz" then
			local Quiz = nil
			local ChosenQuiz = nil
			local QuizzesName = {}
			local AllQuizzes = {}
			
			for _, QuizCategory in Quizzes do
				for QuizName, QuizInfo in QuizCategory do
					if not table.find(UsedQuizzes, QuizName) then
						table.insert(QuizzesName, QuizName)
						AllQuizzes[QuizName] = QuizInfo
					end
				end
			end
			
			if #QuizzesName <= 0 then
				UsedQuizzes = {}
				
				for _, QuizCategory in Quizzes do
					for QuizName, QuizInfo in QuizCategory do
						table.insert(QuizzesName, QuizName)
						AllQuizzes[QuizName] = QuizInfo
					end
				end
			end
			
			ChosenQuiz = QuizzesName[math.random(1, #QuizzesName)]
			table.insert(UsedQuizzes, ChosenQuiz)
			Quiz = AllQuizzes[ChosenQuiz]
			
			Problem.Question = Quiz.Title
			Problem.Answer = Quiz.Answer
			
			if Quiz.Wrong then
				if type(Quiz.MaxAnswers) == "number" and Quiz.MaxAnswers > 1 and (#Quiz.Wrong - Quiz.MaxAnswers) > 0 then
					for _ = 1, (#Quiz.Wrong - Quiz.MaxAnswers) do
						table.remove(Quiz.Wrong, math.random(1, #Quiz.Wrong))
					end
				end
				
				Problem.Wrong = {table.unpack(Quiz.Wrong)}
			end
		end
		
		return Problem
	end
	
	local NotebookUI = game.ReplicatedStorage.CustomAssets.Player.UI.Pressure.NotebookUI:Clone()
	NotebookUI.Enabled = true
	local ProblemsNumber = 3
	
	if UI.SubModifiers:FindFirstChild("Schoolhouse") then

	end
	
	game.Players.LocalPlayer.Character.HumanoidRootPart.Anchored = true
	
	local function ProblemChange()
		local Problem = GenerateProblem()
		if not Problem then
			warn("Problem is piece of shit")
			return true
		else
			if not (Problem.Type and Problem.Question and Problem.Answer) then
				warn("Problem does not have info")
				return true
			end
		end
		
		for _, Answer in NotebookUI.Notebook.Notepad.Answers:GetChildren() do
			if Answer:IsA("Frame") and string.find(Answer.Name, "Answer") then
				Answer:Destroy()
			end
		end
		
		if EventFunction then
			EventFunction:Disconnect()
			EventFunction = nil
		end
		
		local AnswersNumber = 1
		
		NotebookUI.Notebook.Notepad.Question.Text = Problem.Question
		
		if Problem.Wrong then
			AnswersNumber = 1 + #Problem.Wrong
		end
		
		for AnswerNumber = 1, AnswersNumber do
			local AnswerFrame = game.ReplicatedStorage.CustomAssets.Player.UI.Pressure.NotebookAnswer:Clone()
			AnswerFrame.Name = "Answer"..AnswerNumber
			AnswerFrame:FindFirstChild("AnswerNumber", true).Text = AnswerNumber
			AnswerFrame.Parent = NotebookUI.Notebook.Notepad.Answers
		end
		
		local WrongAnswers = {}
		
		for _, Answer in NotebookUI.Notebook.Notepad.Answers:GetChildren() do
			if Answer:IsA("Frame") and string.find(Answer.Name, "Answer") then
				table.insert(WrongAnswers, Answer)
			end
		end
		
		local PlayerAnswer = nil
		
		local RightAnswer = WrongAnswers[math.random(1, #WrongAnswers)]
		RightAnswer.Answer.Text = Problem.Answer
		RightAnswer:FindFirstChildWhichIsA("TextButton").MouseButton1Click:Once(function()
			PlayerAnswer = true
		end)
		table.remove(WrongAnswers, table.find(WrongAnswers, RightAnswer))
		
		if next(Problem.Wrong) and #WrongAnswers > 0 then
			local WrongTextsLeft = {table.unpack(Problem.Wrong)}
			
			for _, Answer in WrongAnswers do
				local WrongText = WrongTextsLeft[math.random(1, #WrongTextsLeft)]
				Answer.Answer.Text = WrongText
				Answer:FindFirstChildWhichIsA("TextButton").MouseButton1Click:Once(function()
					PlayerAnswer = false
				end)
				
				table.remove(WrongTextsLeft, table.find(WrongTextsLeft, WrongText))
			end
		end
		
		EventFunction = UI.Events.NotebookAnswer.Event:Connect(function(EventAnswer)
			if EventAnswer == RightAnswer.Answer.Text then
				PlayerAnswer = true
			else
				PlayerAnswer = false
			end
		end)
		
		local CurrentProblems = ProblemsNumber
		
		while PlayerAnswer == nil do
			task.wait()
		end
		
		return PlayerAnswer
	end
	
	NotebookUI.Parent = game.Players.LocalPlayer.PlayerGui
	
	for ProblemNumber = 1, ProblemsNumber do
		local ProblemSolded = ProblemChange()
		
		if ProblemSolded then
			if ProblemNumber >= ProblemsNumber then
				NotebookUI:Destroy()
				game.Players.LocalPlayer.Character.HumanoidRootPart.Anchored = false
				game.UserInputService.MouseIconEnabled = false
				return true
			end
		else
			NotebookUI:Destroy()
			game.Players.LocalPlayer.Character.HumanoidRootPart.Anchored = false
			game.UserInputService.MouseIconEnabled = false
			break
		end
	end
	
	return false
end

