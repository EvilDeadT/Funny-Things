local RestrictedProperties = {
	"SurfaceAppearance",
	"LocalScript",
	"ModuleScript",
	"Seat",
	"Script",
}

function Compile(Object, StarterCompile, FileNumber)
	if table.find(RestrictedProperties, Object.ClassName) then
		return
	end

	if not AllProperties[Object.ClassName] then
		return print("Unknown ClassName: "..Object.ClassName)
	end

	local Text = "{"

	if type(FileNumber) == "number" then
		Text = "["..FileNumber.."]={"
	end

	if StarterCompile then
		local ObjectPropertyNum = 0

		local function InstanceSet(InstanceTo)
			if not AllProperties[InstanceTo.ClassName] then
				return
			end

			for _, PropertyInitial in {"Part", "Attachment"} do
				local Property1 = PropertyInitial.."0"
				local Property2 = PropertyInitial.."1"

				if AllProperties[InstanceTo.ClassName][Property1] and AllProperties[InstanceTo.ClassName][Property2] then
					if InstanceTo[Property1] or InstanceTo[Property2] then
						ObjectPropertyNum += 1
						InstanceTo:AddTag("CompileWeld "..ObjectPropertyNum)

						if InstanceTo[Property1] then
							if InstanceTo[Property1]:IsDescendantOf(Object) or InstanceTo[Property1] == Object then
								InstanceTo[Property1]:AddTag("CompileInstance1 "..ObjectPropertyNum)
							end
						end

						if InstanceTo[Property2] then
							if InstanceTo[Property2]:IsDescendantOf(Object) or InstanceTo[Property2] == Object then
								InstanceTo[Property2]:AddTag("CompileInstance2 "..ObjectPropertyNum)
							end
						end
					end
				end
			end

			for ClassName, Property in {
				["Model"] = "PrimaryPart",
				["ObjectValue"] = "Value",
				["SurfaceGui"] = "Adornee"
				} do
				if InstanceTo.ClassName == ClassName then
					if InstanceTo[Property] then
						if InstanceTo[Property]:IsDescendantOf(Object) then
							ObjectPropertyNum += 1

							InstanceTo:AddTag("CompilePrimaryObject "..ObjectPropertyNum)
							InstanceTo[Property]:AddTag("CompilePrimaryValue "..ObjectPropertyNum)
						end
					end
				end
			end
		end

		InstanceSet(Object)

		for _, Child in Object:GetDescendants() do
			InstanceSet(Child)
		end
	end

	local function RoundNumber(Number)
		if Number == -0 then
			return 0
		end

		return math.round(Number * 10000) / 10000
	end

	local function TextAdd(TextValue)
		Text = Text..TextValue
	end

	local function TextBoxNew()
		local TextBox = TextBoxFrame:Clone()

		TextBox.Parent = ResultFrame
		TextBox.TextLabel.Text = #ResultFrame:GetChildren() - 1

		if string.len(Text) >= TextLimit then
			TextBox.TextBox.Text = string.sub(Text, 1, TextLimit - 1)

			Text = string.sub(Text, TextLimit, string.len(Text))

			TextBoxNew()
		else
			TextBox.TextBox.Text = Text
		end
	end

	local function CheckComma()
		if string.sub(Text, -1, -1) ~= "," then
			TextAdd(",")
		end
	end

	local function InstanceTableEnd(TextTo)
		if not TextTo then
			if string.sub(Text, -1, -1) == "," then
				Text = string.sub(Text, 1, -2)
			end

			TextAdd("}")
		else
			if string.sub(TextTo, -1, -1) == "," then
				TextTo = string.sub(TextTo, 1, -2)
			end

			return TextTo.."}"
		end
	end

	local function PropertyCompile(Property, PropertyType)
		local TextValue = tostring(Property)

		if PropertyType == "CFrame" then
			if Object.ClassName == "Model" then
				TextValue = "CFrame.new("..tostring(Object:GetPivot())..")"
			else
				TextValue = "CFrame.new("..tostring(Property)..")"
			end
		elseif PropertyType == "Color3" then
			TextValue = "Color3.new("..RoundNumber(Property.R)..","..RoundNumber(Property.G)..","..RoundNumber(Property.B)..")"
		elseif PropertyType == "ColorSequence" then
			TextValue = "{"

			for _, Keypoint in Property.Keypoints do
				TextValue = TextValue.."ColorSequenceKeypoint.new("..Keypoint.Time..",Color3.new("..RoundNumber(Keypoint.Value.R)..","..RoundNumber(Keypoint.Value.G)..","..RoundNumber(Keypoint.Value.B)..")),"
			end

			TextValue = InstanceTableEnd(TextValue)
		elseif PropertyType == "NumberSequence" then
			TextValue = "{"

			for _, Keypoint in Property.Keypoints do
				TextValue = TextValue.."NumberSequenceKeypoint.new("..Keypoint.Time..","..Keypoint.Value.."),"
			end

			TextValue = InstanceTableEnd(TextValue)
		elseif PropertyType == "NumberRange" then
			TextValue = "NumberRange.new("..Property.Min..","..Property.Max..")"
		elseif PropertyType == "Vector3" then
			TextValue = "Vector3.new("..RoundNumber(Property.X)..","..RoundNumber(Property.Y)..","..RoundNumber(Property.Z)..")"
		elseif PropertyType == "Vector2" then
			TextValue = "Vector2.new("..RoundNumber(Property.X)..","..RoundNumber(Property.Y)..")"
		elseif PropertyType == "UDim2" then
			TextValue = "UDim2.new("..RoundNumber(Property.X.Scale)..","..RoundNumber(Property.X.Offset)..","..RoundNumber(Property.Y.Scale)..","..RoundNumber(Property.Y.Offset)..")"
		elseif PropertyType == "UDim" then
			TextValue = "UDim.new("..RoundNumber(Property.Scale)..","..RoundNumber(Property.Offset)..")"
		elseif PropertyType == "Rect" then
			TextValue = "Rect.new("..RoundNumber(Property.Min.X)..","..RoundNumber(Property.Min.Y)..","..RoundNumber(Property.Max.X)..","..RoundNumber(Property.Max.Y)..")"
		elseif PropertyType == "FontFace" then
			TextValue = "Font.fromName('"..string.match(Property.Family, "([^/]+)%.json$").."',"..tostring(Property.Weight)..","..tostring(Property.Style)..")"
		elseif PropertyType == "ColorMapContent" then
			if Property.Uri then
				TextValue = "'"..string.split(Property.Uri, "rbxassetid://")[2].."'"
			else
				return "''"
			end
		else
			if type(Property) == "string" then
				if string.find(tostring(Property), "rbxassetid://") then
					TextValue = string.split(tostring(Property), "rbxassetid://")[2]
				elseif string.find(tostring(Property), "id=") then
					TextValue = string.split(tostring(Property), "id=")[2]
				else
					TextValue = "'"..Property.."'"
				end
			elseif type(Property) == "number" then
				TextValue = RoundNumber(Property)
			else
				local IsBrickColor, BrickColorName = pcall(function()
					return BrickColor.new(tostring(Property))
				end)

				if IsBrickColor and BrickColorName.Name == tostring(Property) then
					TextValue = "BrickColor.new('"..tostring(Property).."')"
				end
			end
		end

		return TextValue
	end

	local IsRoomAsset = false

	if not StarterCompile then
		if game.ReplicatedStorage:FindFirstChild("ScriptAssets") then
			if game.ReplicatedStorage.ScriptAssets:FindFirstChild("RoomAssets") then
				for _, RoomAsset in game.ReplicatedStorage.ScriptAssets.RoomAssets:GetDescendants() do
					if Object:IsA("Model") and Object.Name == RoomAsset.Name and RoomAsset.Parent.Parent.Parent == game.ReplicatedStorage.ScriptAssets.RoomAssets then
						if RoomAsset.Parent.Parent.Name == "Interactables" or RoomAsset.Parent.Parent.Name == "Decor" then
							IsRoomAsset = true

							TextAdd("Name='"..Object.Name.."',")
							TextAdd("ClassName='Part',")
							TextAdd("Anchored=true,")

							local AssetPosition = Vector3.zero
							local AssetOrientation = Vector3.zero

							if Object:IsA("BasePart") then
								AssetPosition = Object.Position
								AssetOrientation = Object.Orientation
							elseif Object:IsA("Model") then
								if Object.PrimaryPart then
									if Object.PrimaryPart:IsA("BasePart") then
										AssetPosition = Object.PrimaryPart.Position
										AssetOrientation = Object.PrimaryPart.Orientation
									end
								else
									AssetPosition = Object.WorldPivot.Position

									local X, Y, Z = Object.WorldPivot:ToOrientation()
									AssetOrientation = Vector3.new(math.deg(X), math.deg(Y), math.deg(Z))
								end
							end

							TextAdd("Position="..PropertyCompile(AssetPosition, "Vector3")..",")
							TextAdd("Orientation="..PropertyCompile(AssetOrientation, "Vector3")..",")

							TextAdd("Attributes={")
							TextAdd("CompileAssetCategory='"..RoomAsset.Parent.Parent.Name.."',")
							TextAdd("CompileAssetType='"..RoomAsset.Parent.Name.."'")

							if Object:IsA("Model") then
								TextAdd(",CompileAssetScale="..RoundNumber(Object:GetScale()))
							end

							if Object.Name == "NormalDoor" then
								if Object:FindFirstChild("Frame") then
									if Object.Frame:FindFirstChild("Frame") then
										if Object.Frame.Frame:IsA("BasePart") then
											TextAdd(",CompileAssetColor="..PropertyCompile(Object.Frame.Frame.Color, "Color3"))
										end
									end
								end
							elseif Object.Name == "BigDoor" then
								if Object:FindFirstChild("Door") then
									if Object.Door:FindFirstChild("BigRoomDoor") then
										if Object.Door.BigRoomDoor:FindFirstChild("Frame") then
											if Object.Door.BigRoomDoor.Frame:FindFirstChild("Frane") then
												if Object.Door.BigRoomDoor.Frame.Frane:IsA("BasePart") then
													TextAdd(",CompileAssetColor="..PropertyCompile(Object.Door.BigRoomDoor.Frame.Frane.Color, "Color3"))
												end
											end
										end
									end
								end
							end

							TextAdd("}")
						end
					end
				end
			end
		end
	end

	if not IsRoomAsset then
		TextAdd("Name='"..Object.Name.."',")
		TextAdd("ClassName='"..Object.ClassName.."',")

		for Name, Property in AllProperties[Object.ClassName] do
			if type(Property) == "table" then
				if Name == "Scale" then
					if Object:GetScale() ~= Property.Default then
						TextAdd(Name.."="..Object:GetScale()..",")
					end
				elseif Property.Type == "ColorSequence" then
					local HasDefault = true

					for _, Keypoint in Object[Name].Keypoints do
						if Property.Default[Keypoint.Time] ~= Keypoint.Value then
							HasDefault = false
						end
					end

					if not HasDefault then
						TextAdd(Name.."="..PropertyCompile(Object[Name], Property.Type)..",")
					end
				elseif Property.Type == "NumberSequence" then
					local HasDefault = true

					for _, Keypoint in Object[Name].Keypoints do
						if Property.Default[Keypoint.Time] ~= Keypoint.Value then
							HasDefault = false
						end
					end

					if not HasDefault then
						TextAdd(Name.."="..PropertyCompile(Object[Name], Property.Type)..",")
					end
				elseif Property.Type == "NumberRange" then
					if Property.Default[0] ~= Object[Name].Min and Property.Default[1] ~= Object[Name].Max then
						TextAdd(Name.."="..PropertyCompile(Object[Name], Property.Type)..",")
					end
				else
					if Object[Name] ~= Property.Default and Property.Type ~= "Instance" then
						TextAdd(Name.."="..PropertyCompile(Object[Name], Property.Type)..",")
					end
				end
			else
				if Object[Name] ~= Property then
					TextAdd(Name.."="..PropertyCompile(Object[Name])..",")
				end
			end
		end



		local HasAttributes = false
		local HasTags = false

		for AttributeName, AttributeValue in Object:GetAttributes() do
			if not HasAttributes then
				HasAttributes = true

				CheckComma()
				TextAdd("Attributes={")
			end

			local IsColor3 = pcall(function()
				return AttributeValue.R
			end)

			if IsColor3 and type(AttributeValue) == "userdata" then
				TextAdd(AttributeName.."="..PropertyCompile(AttributeValue, "Color3")..",")
			elseif type(AttributeValue) == "vector" then
				TextAdd(AttributeName.."="..PropertyCompile(AttributeValue, "Vector3")..",")
			else
				local IsVector2, Vector2Result = pcall(function()
					return Vector2.new(AttributeValue.X, AttributeValue.Y)
				end)

				if IsVector2 and AttributeValue == Vector2Result then
					TextAdd(AttributeName.."="..PropertyCompile(AttributeValue, "Vector2")..",")
				else
					local IsUDim, UDimResult = pcall(function()
						return UDim.new(AttributeValue.Scale, AttributeValue.Offset)
					end)

					if IsUDim and AttributeValue == UDimResult then
						TextAdd(AttributeName.."="..PropertyCompile(AttributeValue, "UDim")..",")
					else
						local IsUDim2, UDim2Result = pcall(function()
							return UDim2.new(AttributeValue.X.Scale, AttributeValue.X.Offset, AttributeValue.Y.Scale, AttributeValue.Y.Offset)
						end)

						if IsUDim2 and AttributeValue == UDim2Result then
							TextAdd(AttributeName.."="..PropertyCompile(AttributeValue, "UDim2")..",")
						else
							local IsCFrame, _ = pcall(function()
								return AttributeValue.Position.Unit
							end)

							if IsCFrame then
								TextAdd(AttributeName.."="..PropertyCompile(AttributeValue, "CFrame")..",")
							else
								TextAdd(AttributeName.."="..PropertyCompile(AttributeValue)..",")
							end
						end
					end
				end
			end
		end

		if HasAttributes then
			InstanceTableEnd()
		end

		for TagNumber, TagName in Object:GetTags() do
			if not HasTags then
				HasTags = true

				CheckComma()
				TextAdd("Tags={")
			end

			TextAdd("'"..TagName.."',")
		end

		if HasTags then
			InstanceTableEnd()
		end

		if #Object:GetChildren() >= 1 then
			if string.sub(Text, -1, -1) ~= "," then
				TextAdd(",")
			end

			TextAdd("Files={")

			local CompilitedFile = false

			for ObjectNumber, ObjectChild in Object:GetChildren() do
				local CompiledChild = Compile(ObjectChild, false, ObjectNumber)

				if CompiledChild then
					CompilitedFile = true

					TextAdd(CompiledChild..",")
				end
			end

			if CompilitedFile then
				InstanceTableEnd()
			else
				Text = string.sub(Text, 1, string.len(Text) - 8)
			end
		end
	end

	InstanceTableEnd()

	if StarterCompile then
		print("COMPILE FINISHED | Text Length: "..string.len(Text))
		
		TextBoxNew()
		
		if not game.RunService:IsStudio() and game.Players.LocalPlayer.PlayerGui:FindFirstChild("InstanceSaveGui") then
			game.Players.LocalPlayer.PlayerGui.InstanceSaveGui:Destroy()
		end
	else
		return Text
	end
end

if game.RunService:IsStudio() then
	StartButton.MouseButton1Click:Connect(function()
		Compile(InstanceToCompile, true)
	end)
else
	local CurrentTable = nil
	
	TextBoxForInstance.FocusLost:Connect(function(Enter)
		if not Enter then
			return
		end

		local function TextBoxError(Message)
			local UniqueTable = {}
			CurrentTable = UniqueTable

			TextError.Text = Message

			task.delay(5, function()
				if CurrentTable == UniqueTable then
					TextError.Text = ""
				end
			end)
		end

		if TextBoxForInstance.Text == nil or TextBoxForInstance.Text == "" then
			TextBoxError("Empty Field!")
			return
		end

		local InstancePath = nil

		for _, TextSplit in string.split(TextBoxForInstance.Text, ".") do
			if TextSplit == "Workspace" then
				if not InstancePath then
					InstancePath = game.Workspace
				else
					TextBoxError(TextSplit .. " Must Be First!")
					return
				end
			elseif TextSplit == "Players" then
				if not InstancePath then
					InstancePath = game.Players
				else
					TextBoxError(TextSplit .. " Must Be First!")
					return
				end
			elseif TextSplit == "ReplicatedStorage" then
				if not InstancePath then
					InstancePath = game.ReplicatedStorage
				else
					TextBoxError(TextSplit .. " Must Be First!")
					return
				end
			elseif TextSplit == "StarterGui" then
				if not InstancePath then
					InstancePath = game.StarterGui
				else
					TextBoxError(TextSplit .. " Must Be First!")
					return
				end
			elseif TextSplit == "LocalPlayer" then
				if InstancePath == game.Players or not InstancePath then
					InstancePath = game.Players.LocalPlayer
				else
					TextBoxError(TextSplit .. " Must Be First Or After Players!")
					return
				end
			else
				if InstancePath then
					if InstancePath:FindFirstChild(TextSplit) then
						InstancePath = InstancePath[TextSplit]
					else
						TextBoxError(TextSplit .. " Does Not Exist!")
						return
					end
				else
					TextBoxError("Make Start Instance!")
					return
				end
			end
		end

		if InstancePath then
			Compile(InstancePath, true)
		else
			TextBoxError("No Instance To Save!")
		end
	end)

	TextBoxForInstance.Parent = ScreenGui
end
