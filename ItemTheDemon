local UI = game.Players.LocalPlayer.PlayerGui.FunnyMenu
local PlayerMain = require(game.Players.LocalPlayer.PlayerGui:WaitForChild("Main"):WaitForChild("Client"):WaitForChild("MainClient"))

local ActivateCooldown = 10
local CanActivate = true
local ActivateTimer = nil
local AnimBusy = false

local PlushContented = false
local PlushContentTime = 6
local PlushTimer = nil
local PlushTimerStatus = "NoActive"
local PlushTimerDelay = nil

game.Players.LocalPlayer.CharacterAdded:Connect(function(Character)
	if UI.Modifiers.TheDemon.Value then
		PlushTimer = 10
		PlushTimerStart()
	end
end)

UI.Events.ItemOnEquip.Event:Connect(function(Item, Anim)
	if Item ~= "TheDemon" then
		return
	end

	if PlushTimer == nil then
		PlushTimer = 10

		PlayerMain.SubTitles.new(
			"<font family='rbxasset://fonts/families/Zekton.json'><font color='rgb(255, 107, 164)'><b>"..game.Players.LocalPlayer.Name.." grabbed the plush...</b></font></font>",
			6
		):Show()
	end

	if Anim then
		if Anim.Pet then
			Anim.Pet:Stop()
			AnimBusy = false
		end
	end
end)

UI.Events.ItemOnUnequip.Event:Connect(function(Item, Anim)
	if Item ~= "TheDemon" then
		return
	end
	
	PlushTimerStatus = "Unequiped"

	if ActivateTimer then
		task.cancel(ActivateTimer)
		ActivateTimer = nil

		CanActivate = true
	end

	if Anim then
		if Anim.Pet then
			Anim.Pet:Stop()
			AnimBusy = false
		end
		if Anim.Inspect then
			Anim.Inspect:Stop()
			AnimBusy = false
		end
	end
end)

UI.Events.ItemOnInput.Event:Connect(function(Item, Anim, Input)
	if Input.UserInputType == Enum.UserInputType.MouseButton1 then
		if not CanActivate or AnimBusy then
			return
		end

		CanActivate = false

		if Anim then
			if Anim.Pet then
				AnimBusy = true

				local ItemModel = game.Players.LocalPlayer.Character:FindFirstChild(Item)

				if ItemModel then
					if ItemModel:FindFirstChild("Handle") then
						game.TweenService:Create(ItemModel.Handle, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
							C1 = CFrame.new(Vector3.new(0.7, 0, 0)) * ItemModel.Handle.C1.Rotation
						}):Play()
					end
				end

				Anim.Pet.Stopped:Once(function()
					if ItemModel then
						if ItemModel:FindFirstChild("Handle") then
							game.TweenService:Create(ItemModel.Handle, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
								C1 = CFrame.new(Vector3.new(0, 0, 0)) * ItemModel.Handle.C1.Rotation
							}):Play()
						end
					end

					AnimBusy = false
				end)
				
				if Anim.Equip then
					Anim.Equip:Stop()
				end
				Anim.Pet:Play()
			end
		end

		ActivateTimer = task.delay(1, function()
			ActivateTimer = nil
			PlushContented = true
			
			if UI.Modifiers.TheDemon.Value then
				PlayerMain.SubTitles.new(
					"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie is content for now...</font></font>",
					6,
					9999,
					true
				):Show()
			end

			task.delay(PlushContentTime, function()
				PlushContented = false
				
				if UI.Modifiers.TheDemon.Value then
					PlayerMain.SubTitles.new(
						"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie is no longer content...</font></font>",
						6,
						9999,
						true
					):Show()
				end
			end)

			task.delay(ActivateCooldown - 1, function()
				CanActivate = true
			end)
		end)
	elseif Input.UserInputType == Enum.UserInputType.MouseButton3 or Input.KeyCode == Enum.KeyCode.T then
		if AnimBusy then
			return
		end

		if Anim then
			if Anim.Inspect then
				AnimBusy = true

				local ItemModel = game.Players.LocalPlayer.Character:FindFirstChild(Item)

				Anim.Inspect.Stopped:Once(function()
					if ItemModel then
						if ItemModel:FindFirstChild("Handle") then

						end
					end

					AnimBusy = false
				end)
				
				if Anim.Equip then
					Anim.Equip:Stop()
				end
				Anim.Inspect:Play()
			end
		end
	end
end)

function PlushTimerStart()
	if PlushTimerStatus == "NoActive" then
		task.spawn(function()
			while UI.Modifiers.TheDemon.Value do
				if type(PlushTimer) ~= "number" then
					if PlayerMain.Toolbar.CurrentSelected and PlayerMain.Toolbar.CurrentSelected.Name == "TheDemon" then
						if PlushTimerStatus ~= "Increase" then print("Early Equip")
							if type(PlushTimerStatus) ~= "number" then
								PlushTimerStatus = 1
							end

							PlushTimerStatus = ((PlushTimerStatus * 10) - 1) / 10

							print("PlushTimerStatus:", PlushTimerStatus)

							PlushTimerDecrease()

							if type(PlushTimerStatus) == "number" then
								if PlushTimerStatus > 0 then
									task.wait(0.1)
								else print("Can Add")
									PlushTimerStatus = "Increase"
								end
							end
						end

						if PlushTimerStatus == "Increase" then
							if PlushTimer < 10 then print("Add")
								PlushTimer = (math.round(PlushTimer * 10) + 1) / 10
								task.wait(0.1)
							else
								PlushTimer = 10
							end
						end
					else
						if not PlushContented then print("Take")
							PlushTimerDecrease()
						end
					end

					task.wait()
				end
			end

			PlushTimerStatus = "NoActive"
		end)
	end
end

function PlushTimerDecrease()
	if PlushTimer > 0 then
		PlushTimerStatus = "Decrease"
		PlushTimer = (math.round(PlushTimer * 10) - 1) / 10

		if PlushTimer == 7.5 then
			PlayerMain.SubTitles.new(
				"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie needs attention...</font></font>",
				6,
				9999,
				true
			):Show()
		elseif PlushTimer == 5 then
			PlayerMain.SubTitles.new(
				"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie wants attention...</font></font>",
				6,
				9999,
				true
			):Show()
		elseif PlushTimer == 2.5 then
			PlayerMain.SubTitles.new(
				"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie demands attention...</font></font>",
				6,
				9999,
				true
			):Show()
		elseif PlushTimer <= 0 then
			UI.Events.Atomize:Fire(game.Players.LocalPlayer.Character)
		end

		task.wait(0.1)
	end
end

UI.Modifiers.TheDemon:GetPropertyChangedSignal("Value"):Connect(function()
	if UI.Modifiers.TheDemon.Value then
		PlushTimerStart()
	else
		PlushTimer = nil
		PlayerMain.SubTitles.new(
			"<font family='rbxasset://fonts/families/Zekton.json'><font color='rgb(255, 107, 164)'><b>"..game.Players.LocalPlayer.Name.." refused the plush...</b></font></font>",
			6
		):Show()
	end
end)
