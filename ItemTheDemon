local UI = game.Players.LocalPlayer.PlayerGui.FunnyMenu
local PlayerMain = require(game.Players.LocalPlayer.PlayerGui:WaitForChild("Main"):WaitForChild("Client"):WaitForChild("MainClient"))

local Equipped = false
local ActivateCooldown = 10
local CanActivate = true
local ActivateTimer = nil
local AnimBusy = false

local PlushContented = false
local PlushContentTime = 6
local PlushTimer = nil
local PlushTimerDelay = nil

game.Players.LocalPlayer.CharacterAdded:Connect(function(Character)
	PlushTimer = 10
end)

function UI.Events.ItemOnEquip.OnInvoke(Item, Anim)
	if Item ~= "TheDemon" then
		return
	end
	
	if PlushTimer == nil then
		PlushTimer = 10

		PlayerMain.SubTitles.new(
			"<font family='rbxasset://fonts/families/Zekton.json'><font color='rgb(255, 107, 164)'><b>"..game.Players.LocalPlayer.Name.." grabbed the plush...</b></font></font>",
			6
		):Show()
	end
	
	if Anim then
		if Anim.Pet then
			Anim.Pet:Stop()
			AnimBusy = false
		end
	end

	Equipped = true

	task.spawn(function()
		while Equipped and PlushTimer < 10 do
			if PlushTimer < 10 then
				PlushTimer = (math.round(PlushTimer * 10) + 1) / 10
				task.wait(0.1)
			else
				PlushTimer = 10
			end

			task.wait()
		end
	end)
end

function UI.Events.ItemOnUnequip.OnInvoke(Item, Anim)
	if Item ~= "TheDemon" then
		return
	end
	
	Equipped = false
	
	if ActivateTimer then
		task.cancel(ActivateTimer)
		ActivateTimer = nil
		
		CanActivate = true
	end
	
	if Anim then
		if Anim.Pet then
			Anim.Pet:Stop()
			AnimBusy = false
		end
	end

	task.spawn(function()
		while not Equipped and PlushTimer > 0 do
			if not PlushContented then
				if PlushTimer > 0 then
					PlushTimer = (math.round(PlushTimer * 10) - 1) / 10
					
					if PlushTimer == 7.5 then
						PlayerMain.SubTitles.new(
							"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie needs attention...</font></font>",
							6,
							9999,
							true
						):Show()
					elseif PlushTimer == 5 then
						PlayerMain.SubTitles.new(
							"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie wants attention...</font></font>",
							6,
							9999,
							true
						):Show()
					elseif PlushTimer == 2.5 then
						PlayerMain.SubTitles.new(
							"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie demands attention...</font></font>",
							6,
							9999,
							true
						):Show()
					end
					
					task.wait(0.1)
				end
			end
			
			if PlushTimer <= 0 then
				UI.Events.Atomize:Fire(game.Players.LocalPlayer.Character)
			end

			task.wait()
		end
	end)
end

function UI.Events.ItemActivate.OnInvoke(Item, Anim)
	if Item ~= "TheDemon" or not CanActivate or AnimBusy then
		return
	end
	
	local Pet = "rbxassetid://12895906881"

	game.ReplicatedStorage.CustomAssets.Items.TheDemon.Animations.Pet.AnimationId = Pet
	
	CanActivate = false
	
	if Anim then
		if Anim.Pet then
			AnimBusy = true
			
			local ItemModel = game.Players.LocalPlayer.Character:FindFirstChild(Item)
			
			if ItemModel then
				if ItemModel:FindFirstChild("Handle") then
					game.TweenService:Create(ItemModel.Handle, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
						C1 = CFrame.new(Vector3.new(0.7, 0, 0)) * ItemModel.Handle.C1.Rotation
					}):Play()
				end
			end
			
			Anim.Pet.Stopped:Once(function()
				if ItemModel then
					if ItemModel:FindFirstChild("Handle") then
						game.TweenService:Create(ItemModel.Handle, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
							C1 = CFrame.new(Vector3.new(0, 0, 0)) * ItemModel.Handle.C1.Rotation
						}):Play()
					end
				end

				AnimBusy = false
			end)
			
			Anim.Pet:Play()
		end
	end
	
	ActivateTimer = task.delay(1, function()
		ActivateTimer = nil
		PlushContented = true
		
		PlayerMain.SubTitles.new(
			"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie is content for now...</font></font>",
			6,
			9999,
			true
		):Show()
		
		task.delay(PlushContentTime, function()
			PlushContented = false
			
			PlayerMain.SubTitles.new(
				"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie is no longer content...</font></font>",
				6,
				9999,
				true
			):Show()
		end)
		
		task.delay(ActivateCooldown - 1, function()
			CanActivate = true
		end)
	end)
end

