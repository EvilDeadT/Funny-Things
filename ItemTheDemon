local UI = game.Players.LocalPlayer.PlayerGui.FunnyMenu
local PlayerMain = require(game.Players.LocalPlayer.PlayerGui:WaitForChild("Main"):WaitForChild("Client"):WaitForChild("MainClient"))

local ActivateCooldown = 10
local CanActivate = true
local ActivateTimer = nil

local PlushContented = false
local PlushContentTime = {
	[1] = 7,
	[2] = 7,
	[3] = 6,
	[4] = 5,
	[5] = 4,
	[6] = 3,
	[7] = 3,
	[8] = 2
}
local PlushPetted = 0
local PlushTimer = nil
local PlushTimerStatus = "NoActive"
local PlushTimerDelay = nil

game.Players.LocalPlayer.CharacterAdded:Connect(function(Character)
	if UI.Modifiers.TheDemon.Value then
		PlushTimer = 10
		PlushTimerStart()
	end
end)

UI.Events.ItemOnEquip.Event:Connect(function(Item, Anim)
	if Item.Name ~= "TheDemon" then
		return
	end
	
	PlayerMain.Device.UI.Mobile.BaseControls.Use.Icon.Image = "rbxassetid://91478997411552"

	if Anim then
		if Anim.Pet then
			Anim.Pet:Stop()
			game.Players.LocalPlayer:SetAttribute("AnimBusy", false)
		end
		if Anim.Inspect then
			Anim.Inspect:Stop()
			game.Players.LocalPlayer:SetAttribute("AnimBusy", false)
		end
	end
end)

UI.Events.ItemOnUnequip.Event:Connect(function(Item, Anim)
	if Item.Name ~= "TheDemon" then
		return
	end
	
	PlushTimerStatus = "Unequiped"

	if ActivateTimer then
		task.cancel(ActivateTimer)
		ActivateTimer = nil

		CanActivate = true
	end

	if Anim then
		if Anim.Pet then
			Anim.Pet:Stop()
			game.Players.LocalPlayer:SetAttribute("AnimBusy", false)
		end
		if Anim.Inspect then
			Anim.Inspect:Stop()
			game.Players.LocalPlayer:SetAttribute("AnimBusy", false)
		end
	end
end)

UI.Events.ItemOnInput.Event:Connect(function(Item, Anim, Input)
	if Input.UserInputType == Enum.UserInputType.MouseButton1 then
		if not CanActivate or game.Players.LocalPlayer:GetAttribute("AnimBusy") then
			return
		end

		CanActivate = false

		if Anim then
			if Anim.Pet then
				game.Players.LocalPlayer:SetAttribute("AnimBusy", true)

				local ItemModel = game.Players.LocalPlayer.Character:FindFirstChild(Item.Name)

				if ItemModel and ItemModel:FindFirstChild("Handle") then
					game.TweenService:Create(ItemModel.Handle, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
						C1 = CFrame.new(Vector3.new(0.7, 0, 0)) * ItemModel.Handle.C1.Rotation
					}):Play()
				end

				Anim.Pet.Stopped:Once(function()
					if ItemModel and ItemModel:FindFirstChild("Handle") then
						game.TweenService:Create(ItemModel.Handle, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
							C1 = CFrame.new(Vector3.new(0, 0, 0)) * ItemModel.Handle.C1.Rotation
						}):Play()
					end

					game.Players.LocalPlayer:SetAttribute("AnimBusy", false)
				end)
				
				if Anim.Equip then
					Anim.Equip:Stop()
				end
				Anim.Pet:Play()
			end
		end

		ActivateTimer = task.delay(1, function()
			ActivateTimer = nil
			PlushContented = true
			PlushPetted += 1
			
			if UI.Modifiers.TheDemon.Value then
				PlayerMain.SubTitles.new(
					"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie is content for now...</font></font>",
					6,
					9999,
					true
				):Show()
			end
			
			task.delay(PlushContentTime[PlushPetted] or 1, function()
				PlushContented = false
				
				if UI.Modifiers.TheDemon.Value then
					PlayerMain.SubTitles.new(
						"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie is no longer content...</font></font>",
						6,
						9999,
						true
					):Show()
				end
			end)
			
			task.delay(ActivateCooldown - 1, function()
				CanActivate = true
			end)
		end)
	elseif Input.UserInputType == Enum.UserInputType.MouseButton3 or Input.KeyCode == Enum.KeyCode.T then
		if game.Players.LocalPlayer:GetAttribute("AnimBusy") then
			return
		end

		if Anim then
			if Anim.Inspect then
				game.Players.LocalPlayer:SetAttribute("AnimBusy", true)

				local ItemModel = game.Players.LocalPlayer.Character:FindFirstChild(Item.Name)
				
				if ItemModel and ItemModel:FindFirstChild("Handle") then
					game.TweenService:Create(ItemModel.Handle, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
						C1 = CFrame.new(Vector3.new(0, 0.55, 0)) * ItemModel.Handle.C1.Rotation
					}):Play()
				end

				Anim.Inspect.Stopped:Once(function()
					if ItemModel and ItemModel:FindFirstChild("Handle") then
						game.TweenService:Create(ItemModel.Handle, TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
							C1 = CFrame.new(Vector3.new(0, 0, 0)) * ItemModel.Handle.C1.Rotation
						}):Play()
					end

					game.Players.LocalPlayer:SetAttribute("AnimBusy", false)
				end)
				
				if Anim.Equip then
					Anim.Equip:Stop()
				end
				Anim.Inspect:Play()
			end
		end
	end
end)

function PlushTimerStart()
	if PlushTimerStatus == "NoActive" then
		task.spawn(function()
			while UI.Modifiers.TheDemon.Value do
				if PlayerMain.PlayerDead then
					break
				end
				
				if type(PlushTimer) == "number" then
					if PlayerMain.Toolbar.CurrentSelected and PlayerMain.Toolbar.CurrentSelected.Name == "TheDemon" then
						if PlushTimerStatus ~= "Increase" then
							if type(PlushTimerStatus) ~= "number" then
								PlushTimerStatus = 0.1
							end

							PlushTimerStatus = ((PlushTimerStatus * 10) - 1) / 10

							PlushTimerDecrease()

							if type(PlushTimerStatus) == "number" then
								if PlushTimerStatus <= 0 then
									PlushTimerStatus = "Increase"
								end
							end
						end

						if PlushTimerStatus == "Increase" then
							if PlushTimer < 10 then
								PlushTimer = (math.round(PlushTimer * 10) + 1) / 10
								task.wait(0.1)
							else
								PlushTimer = 10
								task.wait()
							end
						end
					else
						if not (PlushContented
							or PlayerMain.InCutscene
							or game.Players.LocalPlayer:GetAttribute("PandeMinigame")
							or game.Players.LocalPlayer:GetAttribute("ItemsRestricted")
							or game.Players.LocalPlayer:GetAttribute("Parkour")
							or game.Players.LocalPlayer:GetAttribute("AdDisplaying")
							) then
							PlushTimerStatus = "Decrease"
							PlushTimerDecrease()
						else
							PlushTimerStatus = "NoDecrease"
							task.wait()
						end
					end
				else
					task.wait()
				end
			end

			PlushTimerStatus = "NoActive"
		end)
	end
end

function PlushTimerDecrease()
	if type(PlushTimer) == "number" and PlushTimer > 0 and not (PlushContented
		or PlayerMain.InCutscene
		or game.Players.LocalPlayer:GetAttribute("PandeMinigame")
		or game.Players.LocalPlayer:GetAttribute("ItemsRestricted")
		or game.Players.LocalPlayer:GetAttribute("Parkour")
		or game.Players.LocalPlayer:GetAttribute("AdDisplaying")
		) then
		PlushTimer = (math.round(PlushTimer * 10) - 1) / 10

		if PlushTimer == 7.5 then
			PlayerMain.SubTitles.new(
				"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie needs attention...</font></font>",
				6,
				9999,
				true
			):Show()
		elseif PlushTimer == 5 then
			PlayerMain.SubTitles.new(
				"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie wants attention...</font></font>",
				6,
				9999,
				true
			):Show()
		elseif PlushTimer == 2.5 then
			PlayerMain.SubTitles.new(
				"<font family='rbxasset://fonts/families/ComicNeueAngular.json'><font color='rgb(255, 107, 164)'>The plushie demands attention...</font></font>",
				6,
				9999,
				true
			):Show()
		elseif PlushTimer <= 0 then
			UI.Events.Atomize:Fire(game.Players.LocalPlayer.Character)
		end

		task.wait(0.1)
	else
		task.wait()
	end
end

UI.Modifiers.TheDemon:GetPropertyChangedSignal("Value"):Connect(function()
	if UI.Modifiers.TheDemon.Value then
		if not (game.Players.LocalPlayer.PlayerGui.Main.BotFrame.ToolBar:FindFirstChild("TheDemon") and game.Workspace.GameplayFolder.DroppedItems:FindFirstChild("TheDemon")) then
			UI.Events.ItemGive:Fire("TheDemon")
		end
		
		PlushTimer = 10
		PlushTimerStart()
		PlayerMain.SubTitles.new(
			"<font family='rbxasset://fonts/families/Zekton.json'><font color='rgb(255, 107, 164)'><b>"..game.Players.LocalPlayer.Name.." grabbed the plush...</b></font></font>",
			6
		):Show()
		
		for _, Room in game.Workspace.GameplayFolder.Rooms:GetChildren() do
			if Room:GetAttribute("Room") and Room:GetAttribute("SpecialTag") == "Shop" then
				if Room:FindFirstChild("Shop") then
					SetShopExecution(Room.Shop)
				else
					Room.ChildAdded:Connect(SetShopExecution)
				end
			end
		end
	else
		for _, DroppedItem in game.Workspace.GameplayFolder.DroppedItems:GetChildren() do
			if DroppedItem.Name == "TheDemon" then
				DroppedItem:Destroy()
			end
		end
		
		UI.Events.ItemRemove:Fire("TheDemon", true)
		
		PlushTimer = nil
		PlayerMain.SubTitles.new(
			"<font family='rbxasset://fonts/families/Zekton.json'><font color='rgb(255, 107, 164)'><b>"..game.Players.LocalPlayer.Name.." refused the plush...</b></font></font>",
			6
		):Show()
	end
end)

function SetShopExecution(Shop)
	if Shop.Name == "Shop" and not Shop:GetAttribute("TheDemonExecution") then
		local Entrance = Shop:WaitForChild("Entrance", 10)
		local Exit = Shop:WaitForChild("Exit", 10)

		if not Entrance or Exit then
			return
		end
		
		Shop:SetAttribute("TheDemonExecution", true)
		local InShop = false

		Entrance.Touched:Connect(function(Hit)
			print("Entered in shop")
			if not InShop and PlayerMain.Toolbar.CurrentSelected and PlayerMain.Toolbar.CurrentSelected.Name == "TheDemon" then
				print("Entered Shop with TheDemon")
			end

			InShop = true
		end)

		Exit.Touched:Connect(function(Hit)
			InShop = false
		end)
	end
end

game.Workspace.GameplayFolder.Rooms.ChildAdded:Connect(function(Room)
	if Room:GetAttribute("Room") and Room:GetAttribute("SpecialTag") == "Shop" then
		Room.ChildAdded:Connect(SetShopExecution)
	end
end)
