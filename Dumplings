AllFunctions.AutoCook.Actions = function(FuncInstance)
	if FuncInstance.Value then
		AllFunctions.AutoCook.Info.While = task.spawn(function()
			while FuncInstance.Value do
				if AllFunctions.AutoCook.Info.LastPivot and FuncInstance:GetAttribute("TeleportBack") then
					game.Players.LocalPlayer.Character:PivotTo(AllFunctions.AutoCook.Info.LastPivot)
					AllFunctions.AutoCook.Info.LastPivot = nil
				end

				if AllFunctions.AutoCook.Info.Oven then					
					if type(FuncInstance:GetAttribute("DumplingName")) == "string"
						and AllFunctions.AutoCook.Info.Dumplings[string.lower(FuncInstance:GetAttribute("DumplingName"))] then
						
						local HaveResourses, MissingItems = CheckResoursesAvailability(AllFunctions.AutoCook.Info.Dumplings[string.lower(FuncInstance:GetAttribute("DumplingName"))] .. "_dumpling", "Cook")
						if not HaveResourses then
							if MissingItems then
								GetResourses(MissingItems)
							else
								FuncInstance.Value = false

								return
							end
						end
						
						if not CheckResoursesAvailability(AllFunctions.AutoCook.Info.Dumplings[string.lower(FuncInstance:GetAttribute("DumplingName"))] .. "_dumpling", "Cook") then
							FuncInstance.Value = false
							
							return
						end

						if NoTeleportPivot() and game.Players.LocalPlayer.Character then
							AllFunctions.AutoCook.Info.LastPivot = game.Players.LocalPlayer.Character:GetPivot()
							game.Players.LocalPlayer.Character:PivotTo(AllFunctions.AutoCook.Info.Oven:GetPivot())

							game.ReplicatedStorage.Remotes.StartCook:FireServer(
								AllFunctions.AutoCook.Info.Oven,
								"recipe_" .. AllFunctions.AutoCook.Info.Dumplings[string.lower(FuncInstance:GetAttribute("DumplingName"))] .. "_dumpling",
								AllFunctions.AutoCook.Info.Oven:GetAttribute("Capacity")
							)

							AllFunctions.AutoCook.Info.Oven = nil
						end
					else
						print("Write Dumpling Name")

						AllFunctions.AutoCook.Info.AllowAutoSell = true

						FuncInstance.Value = false
					end
				end

				if game.Workspace.HousesFolder:FindFirstChild(game.Players.LocalPlayer.Name .. "_House") then
					if game.Workspace.HousesFolder:FindFirstChild(game.Players.LocalPlayer.Name .. "_House"):FindFirstChild("Placed") then
						for _, Oven in game.Workspace.HousesFolder:FindFirstChild(game.Players.LocalPlayer.Name .. "_House").Placed:GetChildren() do
							if Oven:GetAttribute("BuildCategory") == "Ovens" and not Oven:GetAttribute("CookRecipe") then
								AllFunctions.AutoCook.Info.Oven = Oven
								AllFunctions.AutoCook.Info.AllowAutoSell = false
							end
						end
					end
				end

				if not AllFunctions.AutoCook.Info.Oven then
					AllFunctions.AutoCook.Info.AllowAutoSell = true
				end

				task.wait(0.1)
			end
		end)
	else
		if AllFunctions.AutoCook.Info.While then
			task.cancel(AllFunctions.AutoCook.Info.While)
			AllFunctions.AutoCook.Info.While = nil
		end
		
		if AllFunctions.AutoCook.Info.LastPivot and FuncInstance:GetAttribute("TeleportBack") then
			game.Players.LocalPlayer.Character:PivotTo(AllFunctions.AutoCook.Info.LastPivot)
			AllFunctions.AutoCook.Info.LastPivot = nil
		end
	end
end

AllFunctions.LeaveOnPlayers.Actions = function(FuncInstance)
	if FuncInstance.Value then
		AllFunctions.LeaveOnPlayers.Info.While = task.spawn(function()
			while FuncInstance.Value do
				local Exeptions = {}
				
				for _, PlayerName in FuncInstance:GetChildren() do
					table.insert(Exeptions, string.lower(PlayerName.Name))
				end
				
				for _, Player in game.Players:GetPlayers() do
					if not table.find(Exeptions, string.lower(Player.Name)) and Player ~= game.Players.LocalPlayer then
						game.Players.LocalPlayer:Kick("AutoKick Because Of: " .. Player.Name)
					end
				end
				
				task.wait(0.1)
			end
		end)
	else
		if AllFunctions.LeaveOnPlayers.Info.While then
			task.cancel(AllFunctions.LeaveOnPlayers.Info.While)
			AllFunctions.LeaveOnPlayers.Info.While = nil
		end
	end
end

if not FunctionsFolder then
	FunctionsFolder = Instance.new("Folder")
	FunctionsFolder.Name = "AllThings"
	FunctionsFolder.IconTint = Color3.fromRGB(250, 255, 255)
end

FunctionsFolder:ClearAllChildren()

for FuncName, Func in AllFunctions do
	local FuncInstance = nil

	if Func.Type == "Bool" then
		FuncInstance = Instance.new("BoolValue")
	end

	FuncInstance.Name = FuncName
	FuncInstance.Value = Func.Default

	if Func.Attributes then
		for AttributeName, AttributeValue in Func.Attributes do
			FuncInstance:SetAttribute(AttributeName, AttributeValue)
		end
	end
	
	if Func.Info.Folders then
		for _, FolderName in Func.Info.Folders do
			if not FuncInstance:FindFirstChild(FolderName) then
				Instance.new("Folder", FuncInstance).Name = FolderName
			end
		end
	end

	local FuncFunction = FuncInstance:GetPropertyChangedSignal("Value"):Connect(function()
		if Func.Actions then
			Func.Actions(FuncInstance)
		else
			print(FuncName .. " Function is Useless")
		end
	end)

	FuncInstance:GetPropertyChangedSignal("Parent"):Connect(function()
		if not FuncInstance.Parent and FuncFunction then
			FuncFunction:Disconnect()
			FuncFunction = nil
		end
		
		
		FuncInstance.Value = Func.Default
	end)

	FuncInstance.Parent = FunctionsFolder
end

if FunctionsFolder.Parent ~= game.ReplicatedFirst then
	FunctionsFolder.Parent = game.ReplicatedFirst
end

function WheatSpawned(Wheat)
	if type(Wheat:GetAttribute("SpawnTime")) ~= "number" then
		Wheat:SetAttribute("SpawnTime", 0)
	end

	if Wheat:GetAttribute("SpawnTime") < 10 then
		task.spawn(function()
			while type(Wheat:GetAttribute("SpawnTime")) == "number" and Wheat:GetAttribute("SpawnTime") < 10 do
				Wheat:SetAttribute("SpawnTime", Wheat:GetAttribute("SpawnTime") + 1)

				task.wait(1)
			end
		end)
	end
end

AllSubFunctions.WheatSpawn = game.Workspace:WaitForChild("PlantsLive").ChildAdded:Connect(WheatSpawned)

for _, Wheat in game.Workspace:WaitForChild("PlantsLive"):GetChildren() do
	WheatSpawned(Wheat)
end
