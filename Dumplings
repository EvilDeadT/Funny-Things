local AllSubFunctions = {}
local UIStyle = require(game.ReplicatedStorage.Shared.UIStyle)

local FunctionsFolder = game.ReplicatedFirst:FindFirstChild("AllThings")

function ScriptOverwrite()
	for FuncName, _ in AllSubFunctions do
		AllSubFunctions[FuncName]:Disconnect()
	end

	AllSubFunctions = {}
end

function PromptClearPrompts()
	if game.Workspace:FindFirstChild("PartInFrontOfCamera") then
		for _, UsedPrompt in game.Workspace.PartInFrontOfCamera:GetChildren() do
			UsedPrompt.KeyboardKeyCode = Enum.KeyCode.E
			for _, Info in UsedPrompt:GetChildren() do
				if string.find(Info.Name, "Prompt") then
					UsedPrompt[string.split(Info.Name, "Prompt")[2]] = Info.Value
				end

				Info:Destroy()
			end
		end
	end
end

function PromptSetInfo(Prompt)
	if Prompt then
		for _, Info in {"MaxActivationDistance", "RequiresLineOfSight", "HoldDuration", "Enabled", "Parent"} do
			local PromptInfo = nil

			if Info == "RequiresLineOfSight" or Info == "Enabled" then
				PromptInfo = Instance.new("BoolValue")
			elseif Info == "MaxActivationDistance" or Info == "HoldDuration" then
				PromptInfo = Instance.new("NumberValue")
			elseif Info == "Parent" then
				PromptInfo = Instance.new("ObjectValue")
			end

			PromptInfo.Name = "Prompt"..Info
			PromptInfo.Value = Prompt[Info]
			PromptInfo.Parent = Prompt
		end
	end
end

function PromptInFrontOfCamera(PromptPart, LookVectorOffset)
	if PromptPart == nil then
		return warn("PromptInFrontOfCamera No Prompt")
	end

	local Prompt = PromptPart:FindFirstChildWhichIsA("ProximityPrompt")
	local PartOffset = LookVectorOffset or 7

	if game.Workspace:FindFirstChild("PartInFrontOfCamera") then
		if game.Workspace.PartInFrontOfCamera:FindFirstChildWhichIsA("ProximityPrompt") then
			if game.Workspace.PartInFrontOfCamera:FindFirstChildWhichIsA("ProximityPrompt"):FindFirstChild("PromptParent") then
				if game.Workspace.PartInFrontOfCamera:FindFirstChildWhichIsA("ProximityPrompt").PromptParent.Value == PromptPart then
					Prompt = game.Workspace.PartInFrontOfCamera:FindFirstChildWhichIsA("ProximityPrompt")
				else
					PromptSetInfo(Prompt)
				end
			else
				PromptSetInfo(Prompt)
			end
		else
			PromptSetInfo(Prompt)
		end
	else
		PromptSetInfo(Prompt)
	end

	if Prompt == nil then
		return
	end

	local PartInFrontOfCamera = game.Workspace:FindFirstChild("PartInFrontOfCamera")
	if not PartInFrontOfCamera then
		PartInFrontOfCamera = Instance.new("Part", game.Workspace)
		PartInFrontOfCamera.Name = "PartInFrontOfCamera"
		PartInFrontOfCamera.Transparency = 1
		PartInFrontOfCamera.Anchored = true
		PartInFrontOfCamera.CanCollide = true
		PartInFrontOfCamera.CastShadow = false
		PartInFrontOfCamera.Size = Vector3.new(0.5, 0.5, 0.5)
	end

	PartInFrontOfCamera.Position = game.Workspace.CurrentCamera.CFrame.Position + game.Workspace.CurrentCamera.CFrame.LookVector * PartOffset

	if Prompt.Parent ~= PartInFrontOfCamera then
		PromptClearPrompts()
	end

	Prompt.MaxActivationDistance = 100
	Prompt.RequiresLineOfSight = false
	Prompt.HoldDuration = 0
	Prompt.Enabled = true
	Prompt.KeyboardKeyCode = Enum.KeyCode.KeypadZero
	Prompt.Parent = PartInFrontOfCamera
	Prompt:InputHoldBegin()
	Prompt:InputHoldEnd()
end

function NoTeleportPivot(Exception)
	for FuncName, FuncInfo in AllFunctions do
		if FuncInfo.Info and FunctionsFolder:FindFirstChild(FuncName) and FuncName ~= Exception then
			if FuncInfo.Info.LastPivot and FunctionsFolder[FuncName]:GetAttribute("TeleportBack") then
				return false
			end
		end
	end

	return true
end

function CheckResoursesAvailability(CraftName, CraftType, FuncInstance, ItemsAmount)
	local Inventory = require(game.ReplicatedStorage.Shared.InventoryState)
	local CookInfo = require(game.ReplicatedStorage.Shared.Dumplings)
	local CraftInfo = require(game.ReplicatedStorage.Shared.Crafting)

	local ItemInfo = nil

	if CraftType == "Cook" then
		ItemInfo = CookInfo
	elseif CraftType == "Craft" then
		ItemInfo = CraftInfo.List
	else
		UIStyle.Toast("Unknown CraftType", "bad")
		return
	end

	if not ItemInfo[CraftName] then
		UIStyle.Toast("Unknown " .. if CraftType == "Cook" then "Dumpling" elseif CraftType == "Craft" then "Craft" else "NIL" .. " Name!", "bad")
		return
	end

	if CraftType == "Cook" and not Inventory.Items["recipe_" .. CraftName] and (not FuncInstance or not FuncInstance:FindFirstChild("IgnoreNoRecipe")) then
		UIStyle.Toast("You Don't Have Recipe!", "bad")
		return
	end



	local MissingItems = {}
	local Multiplier = ItemsAmount or 1

	for Name, Value in ItemInfo[CraftName].ingredients do
		if not Inventory.Items[Name] then
			MissingItems[Name] = Value * Multiplier
		elseif Inventory.Items[Name] < (Value * Multiplier) then
			MissingItems[Name] = Value * Multiplier
		end
	end

	if next(MissingItems) then
		return false, MissingItems
	end

	return true
end

function GetResoursePrice(ResourseName)
	local NPCInfo = require(game.ReplicatedStorage.Shared.NPCs)

	for NPCName, Info in NPCInfo.List do
		if Info.stock then
			for _, ItemInfo in Info.stock do
				if ItemInfo.item == ResourseName then
					local Price = NPCInfo.Price(NPCName, ResourseName)
					return Price
				end
			end
		end
	end

	return
end

function BuyResourse(ResourseName, AmountNeed)
	local NPCInfo = require(game.ReplicatedStorage.Shared.NPCs)
	local Inventory = require(game.ReplicatedStorage.Shared.InventoryState)

	local ShopName = nil

	for NPCName, Info in NPCInfo.List do
		if Info.stock then
			for _, ItemInfo in Info.stock do
				if ItemInfo.item == ResourseName then
					ShopName = NPCName
				end
			end
		end
	end

	if not ShopName or not game.Workspace:FindFirstChild(NPCInfo.List[ShopName].path)
		or (Inventory.Items[ResourseName] and Inventory.Items[ResourseName] >= AmountNeed) then
		return
	end

	local Timer = os.time()

	if not AllFunctions.AutoCook.Info.LastPivot then
		AllFunctions.AutoCook.Info.LastPivot = game.Players.LocalPlayer.Character:GetPivot()
	end

	repeat		
		if game.Players.LocalPlayer.Character then
			game.Players.LocalPlayer.Character:PivotTo(game.Workspace[NPCInfo.List[ShopName].path]:GetPivot())
		end

		task.wait(0.5)

		if Inventory.Items[ResourseName] and Inventory.Items[ResourseName] >= AmountNeed then
			return
		end

		game.ReplicatedStorage.Remotes.BuyItem:FireServer(
			ShopName,
			ResourseName,
			AmountNeed - if Inventory.Items[ResourseName] then Inventory.Items[ResourseName] else 0
		)

		for _ = 1, 10 do
			task.wait(0.1)

			if Inventory.Items[ResourseName] and Inventory.Items[ResourseName] >= AmountNeed then
				return
			end
		end
	until (os.time() - Timer) > 20
end

function CraftResourse(ResourseName, AmountNeed, FuncInstance)
	local CraftInfo = require(game.ReplicatedStorage.Shared.Crafting)
	local Inventory = require(game.ReplicatedStorage.Shared.InventoryState)
	
	if not CraftInfo.List[ResourseName] then
		UIStyle.Toast("Unknown Craft. " .. ResourseName .. ": " .. AmountNeed, "bad")
		return
	elseif not CraftInfo.List[ResourseName].ingredients then
		UIStyle.Toast("Craft Does Not Have Recipe. " .. ResourseName .. ": " .. AmountNeed, "bad")
		return
	end
	
	local Success, MissingItems = CheckResoursesAvailability(ResourseName, "Craft", FuncInstance)
	
	if not Success then
		if MissingItems then
			GetResourses(MissingItems, FuncInstance)
		else
			return
		end
	end
	
	if not CheckResoursesAvailability(ResourseName, "Craft", FuncInstance) then
		return
	end
	
	local Workbench = game.Workspace.HousesFolder:FindFirstChild(game.Players.LocalPlayer.Name .. "_House").Placed:FindFirstChild("Workbench")
	
	if Workbench and Workbench:GetAttribute("BuildId") ~= "Workbench" then
		for _, WorkbenchTo in game.Workspace.HousesFolder:FindFirstChild(game.Players.LocalPlayer.Name .. "_House").Placed:GetChildren() do
			if WorkbenchTo:GetAttribute("BuildId") == "Workbench" then
				Workbench = WorkbenchTo
			end
		end
	end
	
	if not Workbench then
		UIStyle.Toast("Place Workbench First!", "bad")
		return
	end
	
	local Timer = os.time()

	if not AllFunctions.AutoCook.Info.LastPivot then
		AllFunctions.AutoCook.Info.LastPivot = game.Players.LocalPlayer.Character:GetPivot()
	end

	repeat		
		if game.Players.LocalPlayer.Character then
			game.Players.LocalPlayer.Character:PivotTo(Workbench:GetPivot())
		end

		task.wait(0.5)

		if Inventory.Items[ResourseName] and Inventory.Items[ResourseName] >= AmountNeed then
			return
		end

		game.ReplicatedStorage.Remotes.CraftItem:FireServer(
			Workbench,
			ResourseName,
			AmountNeed - if Inventory.Items[ResourseName] then Inventory.Items[ResourseName] else 0
		)

		for _ = 1, 10 do
			task.wait(0.1)

			if Inventory.Items[ResourseName] and Inventory.Items[ResourseName] >= AmountNeed then
				return
			end
		end
	until (os.time() - Timer) > 20
end

function GetResourses(Resourses, FuncInstance)
	local ItemsNeed = {}

	local function ItemsList(Items, LayerNum)
		ItemsNeed[LayerNum] = {
			Buy = {},
			Craft = {},
			Event = {}
		}

		for ItemName, ItemAmount in Items do
			if ItemName == "glow_mushroom" or ItemName == "star_shard" or ItemName == "stardust" then
				ItemsNeed[LayerNum].Event[ItemName] = ItemAmount
			else
				if require(game.ReplicatedStorage.Shared.Crafting).List[ItemName] then
					ItemsNeed[LayerNum].Craft[ItemName] = ItemAmount
				else
					if GetResoursePrice(ItemName) then
						ItemsNeed[LayerNum].Buy[ItemName] = ItemAmount
					else
						UIStyle.Toast("Unobtainable Item: " .. ItemName .. ": " .. ItemAmount, "bad")
						return
					end
				end
			end
		end

		if next(ItemsNeed[LayerNum].Craft) then
			for CraftName, CraftAmount in ItemsNeed[LayerNum].Craft do
				local HaveResourses, MissingItems = CheckResoursesAvailability(CraftName, "Craft", FuncInstance, CraftAmount)

				if not HaveResourses then
					if MissingItems then
						return ItemsList(MissingItems, LayerNum + 1)
					else
						return
					end
				end
			end
		end

		return ItemsNeed
	end

	local ItemsNeed = ItemsList(Resourses, 1)

	if not ItemsNeed then
		return
	end

	local ItemsBuy = {}
	local MaxLayer = 0

	for Layer, LayerInfo in ItemsNeed do
		MaxLayer = Layer
		
		for ItemName, ItemAmount in LayerInfo.Buy do
			ItemsBuy[ItemName] = (ItemsBuy[ItemName] or 0) + ItemAmount
		end
	end
	
	if MaxLayer == 0 then
		UIStyle.Toast("Zero Layers", "bad")
		return
	end

	if next(ItemsBuy) then
		local MoneyNeed = 0

		for ItemName, ItemAmount in ItemsBuy do
			MoneyNeed += GetResoursePrice(ItemName)
		end

		if game.Players.LocalPlayer:GetAttribute("Money") < MoneyNeed then
			UIStyle.Toast("You Are Too Poor! Money Need: " .. MoneyNeed, "bad")
			return
		end

		for ItemName, ItemAmount in ItemsBuy do
			BuyResourse(
				ItemName,
				ItemAmount * (if type(FuncInstance:GetAttribute("ItemsBuy_X")) == "number" then FuncInstance:GetAttribute("ItemsBuy_X") else 1),
				FuncInstance
			)
		end
	end
	
	for Layer = 1, MaxLayer do
		for ItemName, ItemAmount in ItemsNeed[MaxLayer - (Layer - 1)].Craft do
			CraftResourse(
				ItemName,
				ItemAmount * (if type(FuncInstance:GetAttribute("ItemsBuy_X")) == "number" then FuncInstance:GetAttribute("ItemsBuy_X") else 1),
				FuncInstance
			)
		end
	end
end

AllFunctions.PickUpEvents.Actions = function(FuncInstance)
	if FuncInstance.Value then
		AllFunctions.PickUpEvents.Info.While = task.spawn(function()
			while FuncInstance.Value do
				if AllFunctions.PickUpEvents.Info.LastPivot then
					if FuncInstance:GetAttribute("TeleportBack") then
						game.Players.LocalPlayer.Character:PivotTo(AllFunctions.PickUpEvents.Info.LastPivot)
					end
					
					AllFunctions.PickUpEvents.Info.LastPivot = nil
				end

				if not game.Workspace:FindFirstChild("EventObjects") then
					warn("EventObjects Folder Gone")
					
					FuncInstance.Value = false
					
					break
				end

				if AllFunctions.PickUpEvents.Info.CurrentEventLoot
					and AllFunctions.PickUpEvents.Info.CurrentEventLoot.Parent
					and NoTeleportPivot()
					and game.Players.LocalPlayer.Character then
					AllFunctions.PickUpEvents.Info.LastPivot = game.Players.LocalPlayer.Character:GetPivot()
					game.Players.LocalPlayer.Character:PivotTo(AllFunctions.PickUpEvents.Info.CurrentEventLoot:GetPivot())

					if AllFunctions.PickUpEvents.Info.CurrentEventLootPrompt
						and AllFunctions.PickUpEvents.Info.CurrentEventLootPrompt.Parent then
						if FuncInstance:GetAttribute("AutoCollect") then
							PromptInFrontOfCamera(AllFunctions.PickUpEvents.Info.CurrentEventLootPrompt.Parent)
						end
					else
						AllFunctions.PickUpEvents.Info.CurrentEventLoot = nil
						AllFunctions.PickUpEvents.Info.CurrentEventLootPrompt = nil
					end
				else
					if #game.Workspace.EventObjects:GetChildren() > 0 then
						for _, EventLoot in game.Workspace.EventObjects:GetChildren() do
							if EventLoot:FindFirstChildWhichIsA("ProximityPrompt", true)
								and (FuncInstance:GetAttribute(EventLoot.Name) == nil or FuncInstance:GetAttribute(EventLoot.Name)) then
								AllFunctions.PickUpEvents.Info.CurrentEventLoot = EventLoot
								AllFunctions.PickUpEvents.Info.CurrentEventLootPrompt = EventLoot:FindFirstChildWhichIsA("ProximityPrompt", true)

								break
							end
						end
					end
				end

				task.wait(0.1)
			end
		end)
	else
		if AllFunctions.PickUpEvents.Info.While then
			task.cancel(AllFunctions.PickUpEvents.Info.While)
			AllFunctions.PickUpEvents.Info.While = nil
		end

		if AllFunctions.PickUpEvents.Info.LastPivot then
			if FuncInstance:GetAttribute("TeleportBack") then
				game.Players.LocalPlayer.Character:PivotTo(AllFunctions.PickUpEvents.Info.LastPivot)
			end
			
			AllFunctions.PickUpEvents.Info.LastPivot = nil
		end
	end
end

