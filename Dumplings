function PromptClearPrompts()
	if game.Workspace:FindFirstChild("PartInFrontOfCamera") then
		for _, UsedPrompt in game.Workspace.PartInFrontOfCamera:GetChildren() do
			UsedPrompt.KeyboardKeyCode = Enum.KeyCode.E
			for _, Info in UsedPrompt:GetChildren() do
				if string.find(Info.Name, "Prompt") then
					UsedPrompt[string.split(Info.Name, "Prompt")[2]] = Info.Value
				end

				Info:Destroy()
			end
		end
	end
end

function PromptSetInfo(Prompt)
	if Prompt then
		for _, Info in {"MaxActivationDistance", "RequiresLineOfSight", "HoldDuration", "Enabled", "Parent"} do
			local PromptInfo = nil

			if Info == "RequiresLineOfSight" or Info == "Enabled" then
				PromptInfo = Instance.new("BoolValue")
			elseif Info == "MaxActivationDistance" or Info == "HoldDuration" then
				PromptInfo = Instance.new("NumberValue")
			elseif Info == "Parent" then
				PromptInfo = Instance.new("ObjectValue")
			end

			PromptInfo.Name = "Prompt"..Info
			PromptInfo.Value = Prompt[Info]
			PromptInfo.Parent = Prompt
		end
	end
end

function PromptInFrontOfCamera(PromptPart, LookVectorOffset)
	if PromptPart == nil then
		return warn("PromptInFrontOfCamera No Prompt")
	end

	local Prompt = PromptPart:FindFirstChildWhichIsA("ProximityPrompt")
	local PartOffset = LookVectorOffset or 7

	if game.Workspace:FindFirstChild("PartInFrontOfCamera") then
		if game.Workspace.PartInFrontOfCamera:FindFirstChildWhichIsA("ProximityPrompt") then
			if game.Workspace.PartInFrontOfCamera:FindFirstChildWhichIsA("ProximityPrompt"):FindFirstChild("PromptParent") then
				if game.Workspace.PartInFrontOfCamera:FindFirstChildWhichIsA("ProximityPrompt").PromptParent.Value == PromptPart then
					Prompt = game.Workspace.PartInFrontOfCamera:FindFirstChildWhichIsA("ProximityPrompt")
				else
					PromptSetInfo(Prompt)
				end
			else
				PromptSetInfo(Prompt)
			end
		else
			PromptSetInfo(Prompt)
		end
	else
		PromptSetInfo(Prompt)
	end

	if Prompt == nil then
		return
	end

	local PartInFrontOfCamera = game.Workspace:FindFirstChild("PartInFrontOfCamera")
	if not PartInFrontOfCamera then
		PartInFrontOfCamera = Instance.new("Part", game.Workspace)
		PartInFrontOfCamera.Name = "PartInFrontOfCamera"
		PartInFrontOfCamera.Transparency = 1
		PartInFrontOfCamera.Anchored = true
		PartInFrontOfCamera.CanCollide = true
		PartInFrontOfCamera.CastShadow = false
		PartInFrontOfCamera.Size = Vector3.new(0.5, 0.5, 0.5)
	end

	PartInFrontOfCamera.Position = game.Workspace.CurrentCamera.CFrame.Position + game.Workspace.CurrentCamera.CFrame.LookVector * PartOffset

	if Prompt.Parent ~= PartInFrontOfCamera then
		PromptClearPrompts()
	end

	Prompt.MaxActivationDistance = 100
	Prompt.RequiresLineOfSight = false
	Prompt.HoldDuration = 0
	Prompt.Enabled = true
	Prompt.KeyboardKeyCode = Enum.KeyCode.KeypadZero
	Prompt.Parent = PartInFrontOfCamera
	Prompt:InputHoldBegin()
	Prompt:InputHoldEnd()
end

function CheckResoursesAvailability(CraftName, CraftType)
	local Inventory = require(game.ReplicatedStorage.Shared.InventoryState)
	local CookInfo = require(game.ReplicatedStorage.Shared.Dumplings)
	
	if not CookInfo[CraftName] then
		print("Unknown CraftName")
		return
	end
	
	local MissingItems = false
	
	if CraftType == "Cook" then
		if not Inventory.Items["recipe_" .. CraftName] then
			print("You Don't Have Recipe!")
			return
		end
		
		for Name, Value in CookInfo[CraftName].ingredients do
			if not Inventory.Items[Name] then
				print("You Are Too Poor! " .. Name .. ": 0/" .. Value)
				MissingItems = true
			elseif Inventory.Items[Name] < Value then
				print("You Are Too Poor! " .. Name .. ": " .. Inventory.Items[Name] .. "/" .. Value)
				MissingItems = true
			end
		end
	else
		print("Unknown CraftType")
		return
	end
	
	if MissingItems then
		return
	end
	
	return true
end

AllFunctions.PickUpEvents.Actions = function(FuncInstance)
	if FuncInstance.Value then
		AllFunctions.PickUpEvents.Info.While = task.spawn(function()
			while FuncInstance.Value do
				if not game.Workspace:FindFirstChild("EventObjects") then
					warn("EventObjects Folder Gone")
					break
				end
				
				if AllFunctions.PickUpEvents.Info.CurrentEventLoot
					and AllFunctions.PickUpEvents.Info.CurrentEventLoot.Parent then
					
					if AllFunctions.PickUpEvents.Info.CurrentEventLootPrompt
						and AllFunctions.PickUpEvents.Info.CurrentEventLootPrompt.Parent
						and FuncInstance:GetAttribute("AutoCollect") then
						PromptInFrontOfCamera(AllFunctions.PickUpEvents.Info.CurrentEventLootPrompt.Parent)
					end
					
					if game.Players.LocalPlayer.Character then
						game.Players.LocalPlayer.Character:PivotTo(AllFunctions.PickUpEvents.Info.CurrentEventLoot:GetPivot())
					end
				else
					if #game.Workspace.EventObjects:GetChildren() > 0 then
						for _, EventLoot in game.Workspace.EventObjects:GetChildren() do
							if EventLoot:FindFirstChildWhichIsA("ProximityPrompt", true) then
								AllFunctions.PickUpEvents.Info.CurrentEventLoot = EventLoot
								AllFunctions.PickUpEvents.Info.CurrentEventLootPrompt = EventLoot:FindFirstChildWhichIsA("ProximityPrompt", true)
								
								break
							end
						end
					end
				end
				
				task.wait(0.1)
			end
		end)
	else
		if AllFunctions.PickUpEvents.Info.While then
			task.cancel(AllFunctions.PickUpEvents.Info.While)
			AllFunctions.PickUpEvents.Info.While = nil
		end
	end
end

AllFunctions.AutoCook.Actions = function(FuncInstance)
	if FuncInstance.Value then
		AllFunctions.AutoCook.Info.While = task.spawn(function()
			while FuncInstance.Value do
				if AllFunctions.AutoCook.Info.Oven then					
					if type(FuncInstance:GetAttribute("DumplingName")) == "string"
						and AllFunctions.AutoCook.Info.Dumplings[string.lower(FuncInstance:GetAttribute("DumplingName"))] then
						if not CheckResoursesAvailability(AllFunctions.AutoCook.Info.Dumplings[string.lower(FuncInstance:GetAttribute("DumplingName"))] .. "_dumpling", "Cook") then
							FuncInstance.Value = false
							
							return
						end
						
						if game.Players.LocalPlayer.Character then
							game.Players.LocalPlayer.Character:PivotTo(AllFunctions.AutoCook.Info.Oven:GetPivot())
						end
						
						game.ReplicatedStorage.Remotes.StartCook:FireServer(
							AllFunctions.AutoCook.Info.Oven,
							"recipe_" .. AllFunctions.AutoCook.Info.Dumplings[string.lower(FuncInstance:GetAttribute("DumplingName"))] .. "_dumpling",
							AllFunctions.AutoCook.Info.Oven:GetAttribute("Capacity")
						)
						
						if AllFunctions.AutoCook.Info.Oven:GetAttribute("CookRecipe") then
							AllFunctions.AutoCook.Info.Oven = nil
						end
					else
						print("Write Dumpling Name")
						
						AllFunctions.AutoCook.Info.AllowAutoSell = true
						
						FuncInstance.Value = false
					end
				end
				
				if game.Workspace.HousesFolder:FindFirstChild(game.Players.LocalPlayer.Name .. "_House") then
					if game.Workspace.HousesFolder:FindFirstChild(game.Players.LocalPlayer.Name .. "_House"):FindFirstChild("Placed") then
						for _, Oven in game.Workspace.HousesFolder:FindFirstChild(game.Players.LocalPlayer.Name .. "_House").Placed:GetChildren() do
							if Oven:GetAttribute("BuildCategory") == "Ovens" and not Oven:GetAttribute("CookRecipe") then
								AllFunctions.AutoCook.Info.Oven = Oven
								AllFunctions.AutoCook.Info.AllowAutoSell = false
							end
						end
					end
				end
				
				if not AllFunctions.AutoCook.Info.Oven then
					AllFunctions.AutoCook.Info.AllowAutoSell = true
				end
				
				task.wait(0.1)
			end
		end)
	else
		if AllFunctions.PickUpEvents.Info.While then
			task.cancel(AllFunctions.PickUpEvents.Info.While)
			AllFunctions.PickUpEvents.Info.While = nil
		end
	end
end

local FunctionsFolder = game.ReplicatedFirst:FindFirstChild("AllThings")

if not FunctionsFolder then
	FunctionsFolder = Instance.new("Folder")
	FunctionsFolder.Name = "AllThings"
	FunctionsFolder.IconTint = Color3.fromRGB(250, 255, 255)
end

FunctionsFolder:ClearAllChildren()

for FuncName, Func in AllFunctions do
	local FuncInstance = nil
	
	if Func.Type == "Bool" then
		FuncInstance = Instance.new("BoolValue")
	end
	
	FuncInstance.Name = FuncName
	FuncInstance.Value = Func.Default
	
	if Func.Attributes then
		for AttributeName, AttributeValue in Func.Attributes do
			FuncInstance:SetAttribute(AttributeName, AttributeValue)
		end
	end
	
	local FuncFunction = FuncInstance:GetPropertyChangedSignal("Value"):Connect(function()
		if Func.Actions then
			Func.Actions(FuncInstance)
		else
			print(FuncName .. " Function is Useless")
		end
	end)
	
	FuncInstance:GetPropertyChangedSignal("Parent"):Connect(function()
		if not FuncInstance.Parent and FuncFunction then
			FuncFunction:Disconnect()
			FuncFunction = nil
		end
		
		FuncInstance.Value = Func.Default
	end)
	
	FuncInstance.Parent = FunctionsFolder
end

if FunctionsFolder.Parent ~= game.ReplicatedFirst then
	FunctionsFolder.Parent = game.ReplicatedFirst
end
