local UI = game.Players.LocalPlayer.PlayerGui.FunnyMenu
local PlayerMain = require(game.Players.LocalPlayer.PlayerGui:WaitForChild("Main"):WaitForChild("Client"):WaitForChild("MainClient"))
local PlayerZone = PlayerMain.Zones
local CurrentCamera = game.Workspace.CurrentCamera

local EducatorStats = {
	["Freedom"] = {
		Cooldown = 1.5,
		Speed = 0.5,
		Hitbox = 1,
		
		Modes = {
			["Locker"] = {
				Cooldown = 1.5,
				Speed = 0.25,
				Hitbox = 2
			},
			["PandeMinigame"] = {
				Cooldown = 1.5,
				Speed = 0,
				Hitbox = 0
			}
		}
	},
	["Schoolhouse"] = {
		Cooldown = 3.5,
		Speed = 1,
		Hitbox = 1,
		
		Modes = {
			["Locker"] = {
				Cooldown = 3.5,
				Speed = 0.5,
				Hitbox = 2
			},
			["PandeMinigame"] = {
				Cooldown = 3.5,
				Speed = 0,
				Hitbox = 0
			}
		}
	}
}



function EducatorSpawn(Info)
	task.spawn(function()
		local Educator = game.ReplicatedStorage.Assets.Baldi:Clone()
		Educator.Parent = game.Workspace

		game.Players.LocalPlayer:SetAttribute("EducatorCatched", false)
		
		local EducatorCount = 0
		
		for _, OtherEducator in game.Workspace:GetChildren() do
			if OtherEducator.Name == "Baldi" then
				EducatorCount += 1
			end
		end
		
		Educator:SetAttribute("EducatorNumber", EducatorCount)
		Educator:SetAttribute("DefaultMode", "Schoolhouse")
		Educator:SetAttribute("CurrentMode", Educator:GetAttribute("DefaultMode"))
		Educator:SetAttribute("RageRulerSlaps", 0)
		Educator:SetAttribute("StunTime", 8)
		Educator:SetAttribute("Stunned", false)
		Educator:SetAttribute("CanBeFlashed", true)
		Educator:SetAttribute("StunCooldownFlash", 18)
		Educator:SetAttribute("Atomized", false)
		
		for Name, Properties in EducatorStats do
			for Property, Value in Properties do
				if Property ~= "Modes" then
					Educator:SetAttribute(Property..Name, Value)
				else
					for ModeName, ModeProperties in Value do
						for ModeProperty, ModeValue in ModeProperties do
							Educator:SetAttribute(ModeProperty..Name..ModeName, ModeValue)
						end
					end
				end
			end
		end
		
		local function EducatorProperty(Property, PropertyType)
			if Educator:GetAttribute("CurrentMode") and Educator:GetAttribute("DefaultMode") and Property then
				if (type(Educator:GetAttribute("CurrentMode")) == "string" or type(Educator:GetAttribute("CurrentMode")) == "number")
					and (type(Educator:GetAttribute("DefaultMode")) == "string" or type(Educator:GetAttribute("DefaultMode")) == "number")
					and (type(Property) == "string" or type(Property) == "number") then
					local EducatorAttribute = Educator:GetAttribute(Property..Educator:GetAttribute("CurrentMode"))
					
					if Educator:GetAttribute("CurrentMode") ~= Educator:GetAttribute("DefaultMode") then
						EducatorAttribute = Educator:GetAttribute(Property..Educator:GetAttribute("DefaultMode")..Educator:GetAttribute("CurrentMode"))
					end
					
					if type(EducatorAttribute) == string.lower(PropertyType) then
						return EducatorAttribute
					end
				end
			end
			
			return
		end
		
		
		
		local Waiting = 50

		repeat
			if game.Players.LocalPlayer.Character then
				if game.Players.LocalPlayer.Character.Parent == game.Workspace.GameplayFolder.Characters then
					if game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
						break
					end
				end
			end
			
			Waiting -= 1

			task.wait(0.1)
		until Waiting <= 0
		
		local EducatorSpawnSound = Educator.Baldi.BaldiSpawn

		if Info then
			if Info.Reason == "Revive" or Info.Reason == "Timer" then
				EducatorSpawnSound = Educator.Baldi.BaldiDespawn
			elseif Info.Reason == "First Schoolhouse" then
				EducatorSpawnSound = Educator.Baldi.BaldiSchoolhouseStart
			elseif Info.Reason == "Crystal" then
				EducatorSpawnSound = Educator.Baldi.BaldiCrystal
			elseif Info.Reason == "Second Schoolhouse" then
				EducatorSpawnSound = Educator.Baldi.BaldiEnterFinale
			end
			
			if Info.Spawnpoint then
				Educator:PivotTo(Info.Spawnpoint.CFrame)
			else
				Educator:PivotTo(game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.fromOrientation(0, math.rad(math.random(-60, 60)), 0))
				Educator:PivotTo(Educator.WorldPivot * CFrame.new(0, 0, -200) * CFrame.Angles(0, math.pi, 0))
			end
		else
			Educator:PivotTo(game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.fromOrientation(0, math.rad(math.random(-60, 60)), 0))
			Educator:PivotTo(Educator.WorldPivot * CFrame.new(0, 0, -200) * CFrame.Angles(0, math.pi, 0))
		end

		UI.Events.UIModule:Invoke("PlaySound", EducatorSpawnSound)

		local Waiting = 50

		repeat
			Waiting -= 1

			task.wait(0.1)
		until Waiting <= 0 or EducatorSpawnSound.TimeLength > 0

		task.wait(EducatorSpawnSound.TimeLength + 3)

		if PlayerMain.PlayerDead or PlayerMain.IsGhost then
			Educator:Destroy()

			return
		end
		
		local function EducatorFlash(FlashBeacon)
			if not FlashBeacon then
				return print("EducatorFlash No FlashBeacon")
			end
			
			local UseSound = FlashBeacon:FindFirstChild("FlashBeaconUse", true)

			if not UseSound then
				local Waiting = 50
				
				repeat
					UseSound = FlashBeacon:FindFirstChild("FlashBeaconUse", true)
					
					Waiting -= 1
					
					task.wait(0.1)
				until Waiting <= 0 or UseSound
			end
			
			if not UseSound then
				return print("EducatorFlash No UseSound")
			end
			
			
			if Educator then
				local FlashBeaconValue = Educator:FindFirstChild("FlashBeacon")
				
				if not FlashBeaconValue then
					FlashBeaconValue = Instance.new("ObjectValue", Educator)
					FlashBeaconValue.Name = "FlashBeacon"
				end
				
				FlashBeaconValue.Value = FlashBeacon
			end
			
			UseSound.Played:Connect(function()
				print("Flash attempt")
				
				if not Educator then
					return
				else
					if not Educator.PrimaryPart then
						return
					end
				end
				
				if not Educator:GetAttribute("CanBeFlashed") then
					return print("Educator can't be Flashed")
				end
				
				local LookVector = CFrame.lookAt(FlashBeacon.handle.LookVector.WorldPosition, Educator.PrimaryPart.Position).LookVector
				local Magnitude1 = math.deg((FlashBeacon.handle.LookVector.WorldCFrame.LookVector - LookVector).Magnitude)
				local Magnitude2 = (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - Educator.PrimaryPart.Position).Magnitude
				
				if Magnitude2 < 80 and Magnitude1 < 85.5 and not PlayerMain.Utils.CustomRayCast(
					CurrentCamera.CFrame.Position,
					CFrame.lookAt(game.Workspace.CurrentCamera.CFrame.Position, Educator.PrimaryPart.Position).LookVector * Magnitude2,
					{Educator}) then
					print("Educator Flashed")
					
					Educator:SetAttribute("Stunned", true)
					Educator:SetAttribute("CanBeFlashed", false)
					Educator:SetAttribute("RageRulerSlaps", 3)
					
					local EducatorFlashedSound = Educator.Baldi.StunLines:GetChildren()[math.random(1, #Educator.Baldi.StunLines:GetChildren())]
					EducatorFlashedSound.Volume = 0.75
					
					UI.Events.UIModule:Invoke("PlaySound", EducatorFlashedSound)
					
					task.delay(Educator:GetAttribute("StunCooldownFlash"), function()
						if Educator then
							Educator:SetAttribute("CanBeFlashed", true)
						end
					end)
					
					task.wait(Educator:GetAttribute("StunTime"))
					
					Educator:SetAttribute("Stunned", false)
				end
			end)
		end
		
		local function EducatorAtomize()
			Educator:SetAttribute("Atomized", true)

			if Educator.PrimaryPart then
				local AtomizeSound = Instance.new("Sound", Educator.PrimaryPart)
				AtomizeSound.Name = "Atomize"
				AtomizeSound.SoundId = "rbxassetid://140735995820291"
				AtomizeSound.RollOffMaxDistance = 250
				AtomizeSound.RollOffMinDistance = 50
				AtomizeSound.RollOffMode = Enum.RollOffMode.Linear
				AtomizeSound.PlaybackSpeed = 0.95
				AtomizeSound.Volume = 2.5
				AtomizeSound.SoundGroup = UI.Events.UIModule:Invoke("FindByThread", game.ReplicatedStorage, "Settings.SFX")

				local AtomizeReverb = Instance.new("ReverbSoundEffect", AtomizeSound)
				AtomizeReverb.DecayTime = 3
				AtomizeReverb.Density = 0
				AtomizeReverb.Diffusion = 0
				AtomizeReverb.DryLevel = 3

				UI.Events.UIModule:Invoke("PlaySound", AtomizeSound)
			end

			Educator.PrimaryPart.TextureID = ""
			Educator.PrimaryPart.BrickColor = BrickColor.new("Bright red")
			Educator.PrimaryPart.Material = Enum.Material.Neon

			game.TweenService:Create(Educator.PrimaryPart, TweenInfo.new(3.5, Enum.EasingStyle.Linear), {
				Position = Educator.PrimaryPart.Position + Vector3.new(
					math.random(-100, 100) / 40,
					math.random(0, 100) / 40,
					math.random(-100, 100) / 40
				)
			}):Play()

			local EducatorAtomizeSizeTween = game.TweenService:Create(Educator.PrimaryPart, TweenInfo.new(10, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				Size = Vector3.new(0, 0, 0)
			})

			EducatorAtomizeSizeTween.Completed:Once(function()
				if Educator then
					Educator:Destroy()
					Educator = nil
				end
			end)

			EducatorAtomizeSizeTween:Play()
		end
		
		if game.Players.LocalPlayer.Character then
			game.Players.LocalPlayer.Character.ChildAdded:Connect(function(FlashBeacon)
				if Educator then
					if Educator:FindFirstChild("FlashBeacon") then
						if Educator.FlashBeacon.Value == FlashBeacon then
							return
						end
					end
				end
				
				if FlashBeacon.Name == "FlashBeacon" then
					EducatorFlash(FlashBeacon)
				end
			end)
			
			if game.Players.LocalPlayer.Character:FindFirstChild("FlashBeacon") then
				EducatorFlash(game.Players.LocalPlayer.Character.FlashBeacon)
			end
		end

		local EducatorVector3 = Instance.new("Vector3Value")
		EducatorVector3.Value = Educator.WorldPivot.Position

		game.RunService:BindToRenderStep("EducatorMove"..Educator:GetAttribute("EducatorNumber"), 220, function()
			if game.Players.LocalPlayer:GetAttribute("EducatorCatched") then
				local EducatorGlitch = UI.Events.UIModule:Invoke("FindByThread", game.Players.LocalPlayer.PlayerGui, "Main.BaldiTouch")

				if EducatorGlitch then
					EducatorGlitch.Position = UDim2.new(0.5, math.random(-20, 20), 0.5, math.random(-20, 20))
				end

				if game.Workspace:FindFirstChild("BaldiTouch") then
					game.Workspace.BaldiTouch:PivotTo(CFrame.lookAt(CurrentCamera.CFrame.Position + (CurrentCamera.CFrame.LookVector * 1.5), CurrentCamera.CFrame.Position))
					game.Workspace.BaldiTouch:PivotTo(CFrame.new(game.Workspace.BaldiTouch.PrimaryPart.CFrame.Position - game.Workspace.BaldiTouch.PrimaryPart.CFrame.UpVector * 5)
						* game.Workspace.BaldiTouch.PrimaryPart.CFrame.Rotation)
				end

				return
			end

			if Educator then
				if Educator.PrimaryPart then
					if not Educator:GetAttribute("Atomized") then
						Educator:PivotTo(CFrame.new(EducatorVector3.Value) * Educator.WorldPivot.Rotation)
					else
						game.RunService:UnbindFromRenderStep("EducatorMove"..Educator:GetAttribute("EducatorNumber"))
						
						return
					end
					
					if game.Workspace.GameplayFolder.Debris:FindFirstChild("LaserParticle") then
						for _, LaserParticle in game.Workspace.GameplayFolder.Debris:GetChildren() do
							if LaserParticle.Name == "LaserParticle" then
								if (LaserParticle.Position - Educator.PrimaryPart.Position).Magnitude < 5 and not Educator:GetAttribute("Atomized") then
									EducatorAtomize()
								end
							end
						end
					end

					if PlayerZone.CurrentRoom then
						if PlayerZone.CurrentRoom.Name == "Room100" and not game.Players.LocalPlayer:GetAttribute("EducatorRoom100Access") then
							EducatorDespawn({
								Reason = "Room100"
							})
							return
						elseif PlayerZone.CurrentRoom.Name == "RidgeEnd" or PlayerZone.CurrentRoom.Name == "RidgeEnding" then
							EducatorDespawn({
								Reason = "RidgeEnd"
							})
							return
						elseif PlayerZone.CurrentRoom.Name == "SearchlightsEnding" or PlayerZone.CurrentRoom.Name == "ModifierEnding" then
							EducatorDespawn({
								Reason = "ModifierEnding"
							})
							return
						end
					end
					
					if game.Players.LocalPlayer:GetAttribute("PandeMinigame") then
						Educator:SetAttribute("CurrentMode", "PandeMinigame")
					elseif PlayerMain.LockerState then
						Educator:SetAttribute("CurrentMode", "Locker")
					else
						Educator:SetAttribute("CurrentMode", Educator:GetAttribute("DefaultMode"))
					end
					
					local EducatorHitbox = EducatorProperty("Hitbox", "Number")
					
					if not EducatorHitbox then
						return
					end
					
					if not game.Players.LocalPlayer.Character then
						return
					else
						if not game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
							return
						end
					end
					
					if (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - Educator.PrimaryPart.Position).Magnitude < (3 * EducatorHitbox)
						and not PlayerMain.PlayerDead
						and not PlayerMain.IsGhost
						and not game.Workspace:HasTag("TemporaryImmunity")
						and not game.Players.LocalPlayer:HasTag("GodMode")
						and not Educator:GetAttribute("Stunned")
						and not Educator:GetAttribute("Atomized") then
						local EducatorNumber = Educator:GetAttribute("EducatorNumber")

						Educator:Destroy()
						Educator = nil
						
						game.Players.LocalPlayer:SetAttribute("EducatorsBeforeDeath", 1)

						for _, OtherEducator in game.Workspace:GetChildren() do
							if OtherEducator.Name == "Baldi" then
								OtherEducator:Destroy()

								game.Players.LocalPlayer:SetAttribute("EducatorsBeforeDeath", game.Players.LocalPlayer:GetAttribute("EducatorsBeforeDeath") + 1)
							end
						end

						game.Players.LocalPlayer:SetAttribute("EducatorCatched", true)

						local EducatorTouch = game.ReplicatedStorage.Assets.BaldiTouch:Clone()
						EducatorTouch.PrimaryPart.PivotOffset = CFrame.new(0, 0, 0) * CFrame.fromOrientation(0, 0, 0)
						EducatorTouch:PivotTo(CFrame.lookAt(CurrentCamera.CFrame.Position + (CurrentCamera.CFrame.LookVector * 1.5), CurrentCamera.CFrame.Position))
						EducatorTouch:PivotTo(CFrame.new(EducatorTouch.PrimaryPart.CFrame.Position - EducatorTouch.PrimaryPart.CFrame.UpVector * 5)
							* EducatorTouch.PrimaryPart.CFrame.Rotation)
						EducatorTouch.Parent = game.Workspace

						game.Lighting.BaldiColour.Enabled = true

						local EducatorGlitch = UI.Events.UIModule:Invoke("FindByThread", game.Players.LocalPlayer.PlayerGui, "Main.BaldiTouch")

						if EducatorGlitch then
							EducatorGlitch.Visible = true
						end

						PlayerMain.CameraModule.Switch("HeadFollow")
						game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 0

						UI.Events.UIModule:Invoke("PlaySound", EducatorTouch.PrimaryPart.LopeeTouch)

						task.wait(1)

						game.RunService:UnbindFromRenderStep("EducatorMove"..EducatorNumber)

						if EducatorGlitch then
							EducatorGlitch.BackgroundTransparency = 0
							EducatorGlitch.ImageTransparency = 1
						end

						game.ReplicatedStorage.Settings.SFX.Volume = 0
						game.ReplicatedStorage.Settings.Music.Volume = 0
						game.Lighting.BaldiColour.Enabled = false
						
						PlayerMain.DeathScreen.BaldiDeath = true

						local DamageEvent = UI.Events.UIModule:Invoke("FindByThread", game.ReplicatedStorage, "Events.LocalDamage")

						if DamageEvent then
							DamageEvent:FireServer(1000, "TheEducator", nil, "TheEducator", true)
						end

						task.wait(2)


						if EducatorGlitch then
							EducatorGlitch.Visible = false
							EducatorGlitch.BackgroundTransparency = 1
							EducatorGlitch.ImageTransparency = 0.75
						end

						EducatorTouch:Destroy()

						game.Players.LocalPlayer:SetAttribute("EducatorCatched", false)
						
						if not game.Players.LocalPlayer:GetAttribute("Dead") then
							PlayerMain.CameraModule.Switch("PlayerControl")
							
							if game.Players.LocalPlayer.Character then
								if game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
									game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = PlayerMain.CameraModule.GetWalkSpeed()
								end
							end
						end
						
						if not game.Workspace:FindFirstChild("NewDeathCutsceneModel") then
							local Waiting = 50
							
							repeat
								Waiting -= 1

								task.wait(0.1)
							until Waiting <= 0 or game.Workspace:FindFirstChild("NewDeathCutsceneModel")
						end
						
						local EducatorModelDeath = UI.Events.UIModule:Invoke("FindByThread", game.Workspace, "NewDeathCutsceneModel.deathModel.Baldi")
						
						if EducatorModelDeath then
							EducatorModelDeath.Transparency = 0
						end
						
						PlayerMain.DeathScreen.BaldiDeath = nil
					end
				end
			end
		end)

		while Educator and not game.Players.LocalPlayer:GetAttribute("EducatorCatched") do
			if Educator:FindFirstChild("Baldi") then
				if Educator.PrimaryPart.Transparency == 1 or Educator:GetAttribute("Atomized") then
					break
				end
		
				local EducatorSpeed = EducatorProperty("Speed", "Number")
				local EducatorCooldown = EducatorProperty("Cooldown", "Number")

				if EducatorSpeed and EducatorCooldown and not Educator:GetAttribute("Stunned") and not Educator:GetAttribute("Atomized") then
					if EducatorSpeed > 0 then
						UI.Events.UIModule:Invoke("PlaySound", Educator.Baldi.RulerSound)

						Educator:PivotTo(CFrame.lookAt(Educator.PrimaryPart.Position, CurrentCamera.CFrame.Position))
						
						local EducatorSpeedMultiplier = 25
						
						if type(Educator:GetAttribute("RageRulerSlaps")) == "number" then
							if Educator:GetAttribute("RageRulerSlaps") > 0 then
								EducatorSpeedMultiplier = 40
								
								Educator:SetAttribute("RageRulerSlaps", Educator:GetAttribute("RageRulerSlaps") - 1)
							end
						end

						game.TweenService:Create(EducatorVector3, TweenInfo.new(0.25, Enum.EasingStyle.Linear), {
							Value = EducatorVector3.Value + (Educator.PrimaryPart.CFrame.LookVector * (EducatorSpeedMultiplier * EducatorSpeed))
						}):Play()
					end
					
					task.wait(EducatorCooldown)
				else
					task.wait()
				end
			else
				if not game.Players.LocalPlayer:GetAttribute("EducatorsBeforeDeath") then
					game.Players.LocalPlayer:SetAttribute("EducatorsBeforeDeath", 0)
				end
				
				game.Players.LocalPlayer:SetAttribute("EducatorsBeforeDeath", game.Players.LocalPlayer:GetAttribute("EducatorsBeforeDeath") + 1)
				
				break
			end
		end
	end)
end

function EducatorDespawn(Info, EducatorNumber)
	for _, Educator in game.Workspace:GetChildren() do
		if Educator.Name == "Baldi" then
			if EducatorNumber == nil or (Educator:GetAttribute("EducatorNumber") == EducatorNumber) then
				game.RunService:UnbindFromRenderStep("EducatorMove"..Educator:GetAttribute("EducatorNumber"))
				
				task.spawn(function()
					Educator.PrimaryPart.Transparency = 1

					local EducatorDespawnSound = Educator.Baldi.BaldiSchoolhousePrep
					
					if Info then
						if Info.Reason == "First Schoolhouse" or Info.Reason == "Timer" then
							EducatorDespawnSound = Educator.Baldi.BaldiSchoolhousePrep
						elseif Info.Reason == "First Schoolhouse Complete" then
							EducatorDespawnSound = Educator.Baldi.BaldiSchoolhouseComplete
						elseif Info.Reason == "Room100" then
							EducatorDespawnSound = Educator.Baldi.BaldiRoom100
						elseif Info.Reason == "RidgeEnd" then
							EducatorDespawnSound = Educator.Baldi.BaldiDespawn
						elseif Info.Reason == "Second Schoolhouse Complete" or Info.Reason == "ModifierEnding" then
							EducatorDespawnSound = Educator.Baldi.BaldiFinaleWin
						end
					end

					UI.Events.UIModule:Invoke("PlaySound", EducatorDespawnSound)

					local Waiting = 50

					repeat
						Waiting -= 1

						task.wait(0.1)
					until Waiting <= 0 or EducatorDespawnSound.TimeLength > 0

					task.wait(EducatorDespawnSound.TimeLength)

					Educator:Destroy()
				end)
			end
		end
	end
end

game.Players.LocalPlayer.CharacterAdded:Connect(function()
	if type(game.Players.LocalPlayer:GetAttribute("EducatorsBeforeDeath")) == "number" and game.Players.LocalPlayer:GetAttribute("EducatorChase") then
		if game.Players.LocalPlayer:GetAttribute("EducatorsBeforeDeath") > 0 then
			for i = 1, game.Players.LocalPlayer:GetAttribute("EducatorsBeforeDeath") do
				print("Educator Respawn After Revive")
				
				EducatorSpawn({
					Reason = "Revive"
				})
			end
			
			game.Players.LocalPlayer:SetAttribute("EducatorsBeforeDeath", 0)
		end
	end
end)

game.Players.LocalPlayer:GetAttributeChangedSignal("Dead"):Connect(function()
	if game.Players.LocalPlayer:GetAttribute("Dead") then
		for _, Educator in game.Workspace:GetChildren() do
			if Educator.Name == "Baldi" then
				game.RunService:UnbindFromRenderStep("EducatorMove"..Educator:GetAttribute("EducatorNumber"))

				Educator:Destroy()
			end
		end
		
		game.Players.LocalPlayer:SetAttribute("EducatorCatched", false)
	end
end)

local RidgeCutsceneEvent = UI.Events.UIModule:Invoke("FindByThread", game.ReplicatedStorage, "Events.RidgeCutscene")

if RidgeCutsceneEvent then
	RidgeCutsceneEvent.OnClientEvent:Connect(function()
		game.Players.LocalPlayer:SetAttribute("EducatorRoom100Access", true)
		
		if PlayerMain.PlayerDead or PlayerMain.IsGhost or not game.Players.LocalPlayer:GetAttribute("EducatorChase") then
			return
		end
		
		if not PlayerMain.InCutscene then
			local Waiting = 50
			
			repeat
				Waiting -= 1
				
				task.wait(0.1)
			until Waiting <= 0 or not PlayerMain.InCutscene
		end
		
		if PlayerMain.PlayerDead or PlayerMain.IsGhost or not game.Players.LocalPlayer:GetAttribute("EducatorChase") then
			return
		end
		
		repeat
			if PlayerMain.PlayerDead or PlayerMain.IsGhost or not game.Players.LocalPlayer:GetAttribute("EducatorChase") then
				break
			end
			
			task.wait(0.1)
		until not PlayerMain.InCutscene
		
		if PlayerMain.PlayerDead or PlayerMain.IsGhost or not game.Players.LocalPlayer:GetAttribute("EducatorChase") then
			return
		end
		
		if not PlayerZone.CurrentRoom then
			return
		end
		
		EducatorSpawn({
			Reason = "Crystal",
			Spawnpoint = PlayerZone.CurrentRoom:FindFirstChild("BaldiSpawner")
		})
	end)
end

UI.Events.Summon.Event:Connect(function(Entity, EventReason)
	if Entity ~= "Educator" then
		return
	end
	
	if EventReason == "Modifier" then
		local EducatorExist = false

		for _, Educator in game.Workspace:GetChildren() do
			if Educator.Name == "Baldi" and Educator.PrimaryPart.Transparency ~= 1 then
				EducatorExist = true
			end
		end

		if not EducatorExist then
			EducatorSpawn({Reason = EventReason})
		end
	elseif type(EventReason) == "string" then
		if string.find(EventReason, "Timer:") then
			if tonumber(string.split(EventReason, " ")[2]) then
				EducatorSpawn({
					Reason = EventReason
				})

				task.delay(tonumber(string.split(EventReason, " ")[2]), function()
					EducatorDespawn({
						Reason = EventReason
					})
				end)
			end
		end
	end
end)

UI.Events.Despawn.Event:Connect(function(Entity, EventReason)
	if Entity ~= "Educator" then
		return
	end
	
	EducatorDespawn({Reason = EventReason})
end)

UI.Modifiers.Educator:GetPropertyChangedSignal("Value"):Connect(function()
	if UI.Modifiers.Educator.Value then
		UI.Events.Summon:Fire("Educator", "Modifier")
	else
		UI.Events.Despawn:Fire("Educator", "Modifier")
	end
end)
