function FindByThread(PathStart, Thread)
	if PathStart and Thread then
		local PickedFolder = PathStart

		for _, Path in string.split(Thread, ".") do
			local PathInstance = Path
			local SpecialInstance = nil
			local SpecialMethod = nil

			if string.find(PathInstance, ":") then
				PathInstance = string.split(Path, ":")[1]
				SpecialInstance = string.split(string.split(string.split(Path, ":")[2], "(")[2], ")")[1]
				SpecialMethod = string.split(string.split(Path, ":")[2], "(")[1]
			end

			if PathInstance == "LocalPlayer" then
				PickedFolder = game.Players.LocalPlayer
			elseif PathInstance == "CFrame" then
				PickedFolder = PickedFolder.CFrame

				return PickedFolder
			else
				local IsProperty = pcall(function()
					PickedFolder[PathInstance] = PickedFolder[PathInstance]
				end)

				if PickedFolder:FindFirstChild(PathInstance) or IsProperty then
					PickedFolder = PickedFolder[PathInstance]
				else
					print("FindByThread not found: "..PathInstance)

					return
				end
			end

			if SpecialInstance then
				if SpecialMethod == "FindFirstChildWhichIsA" then
					PickedFolder = PickedFolder:FindFirstChildWhichIsA(SpecialInstance)
				elseif SpecialMethod == "GetChildren" then
					PickedFolder = PickedFolder:GetChildren()
				end
			end
		end

		return PickedFolder
	end

	return
end

local function PlaySound(Sound)
	if Sound then
		if Sound:GetAttribute("ID") then
			Sound.SoundId = Sound:GetAttribute("ID")
		end

		Sound:Play()
	end
end

function EducatorSpawn(Info)
	task.spawn(function()
		local Educator = game.ReplicatedStorage.Assets.Baldi:Clone()
		Educator.Parent = game.Workspace

		local EducatorInfo = {
			PlayerCatched = false
		}
		
		local EducatorCount = 0
		
		for _, OtherEducator in game.Workspace:GetChildren() do
			if OtherEducator.Name == "Baldi" then
				EducatorCount += 1
			end
		end
		
		Educator:SetAttribute("EducatorNumber", EducatorCount)
		Educator:SetAttribute("DefaultMode", "Schoolhouse")
		Educator:SetAttribute("CurrentMode", Educator:GetAttribute("DefaultMode"))
		
		for ModeName, ModeStats in EducatorStats do
			print(ModeName)
			for _, StatName, Value in ModeStats do
				print(StatName, Value)
				Educator:SetAttribute(StatName..ModeName, Value)
			end
		end
		
	end)
end

function EducatorDespawn(Info, EducatorNumber)
	for _, Educator in game.Workspace:GetChildren() do
		if Educator.Name == "Baldi" then
			if EducatorNumber == nil or (Educator:GetAttribute("EducatorNumber") == EducatorNumber) then
				game.RunService:UnbindFromRenderStep("EducatorMove"..Educator:GetAttribute("EducatorNumber"))
				
				task.spawn(function()
					Educator.PrimaryPart.Transparency = 1

					local EducatorDespawnSound = Educator.Baldi.BaldiSchoolhousePrep
					
					if Info then
						if Info.Reason == "First Schoolhouse" then
							EducatorDespawnSound = Educator.Baldi.BaldiSchoolhousePrep
						elseif Info.Reason == "First Schoolhouse Complete" then
							EducatorDespawnSound = Educator.Baldi.BaldiSchoolhouseComplete
						elseif Info.Reason == "Room100" then
							EducatorDespawnSound = Educator.Baldi.BaldiRoom100
						elseif Info.Reason == "RidgeEnd" then
							EducatorDespawnSound = Educator.Baldi.BaldiDespawn
						elseif Info.Reason == "Second Schoolhouse Complete" or Info.Reason == "ModifierEnding" then
							EducatorDespawnSound = Educator.Baldi.BaldiFinaleWin
						end
					end

					PlaySound(EducatorDespawnSound)

					local Waiting = 50

					repeat
						Waiting -= 1

						task.wait(0.1)
					until Waiting <= 0 or EducatorDespawnSound.TimeLength > 0

					task.wait(EducatorDespawnSound.TimeLength)

					Educator:Destroy()
				end)
			end
		end
	end
end

