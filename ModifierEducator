function FindByThread(PathStart, Thread)
	if PathStart and Thread then
		local PickedFolder = PathStart

		for _, Path in string.split(Thread, ".") do
			local PathInstance = Path
			local SpecialInstance = nil
			local SpecialMethod = nil

			if string.find(PathInstance, ":") then
				PathInstance = string.split(Path, ":")[1]
				SpecialInstance = string.split(string.split(string.split(Path, ":")[2], "(")[2], ")")[1]
				SpecialMethod = string.split(string.split(Path, ":")[2], "(")[1]
			end

			if PathInstance == "LocalPlayer" then
				PickedFolder = game.Players.LocalPlayer
			elseif PathInstance == "CFrame" then
				PickedFolder = PickedFolder.CFrame

				return PickedFolder
			else
				local IsProperty = pcall(function()
					PickedFolder[PathInstance] = PickedFolder[PathInstance]
				end)

				if PickedFolder:FindFirstChild(PathInstance) or IsProperty then
					PickedFolder = PickedFolder[PathInstance]
				else
					print("FindByThread not found: "..PathInstance)

					return
				end
			end

			if SpecialInstance then
				if SpecialMethod == "FindFirstChildWhichIsA" then
					PickedFolder = PickedFolder:FindFirstChildWhichIsA(SpecialInstance)
				elseif SpecialMethod == "GetChildren" then
					PickedFolder = PickedFolder:GetChildren()
				end
			end
		end

		return PickedFolder
	end

	return
end

local function PlaySound(Sound)
	if Sound then
		if Sound:GetAttribute("ID") then
			Sound.SoundId = Sound:GetAttribute("ID")
		end

		Sound:Play()
	end
end

function EducatorSpawn(Info)
	task.spawn(function()
		local Educator = game.ReplicatedStorage.Assets.Baldi:Clone()
		Educator.Parent = game.Workspace

		local EducatorInfo = {
			PlayerCatched = false
		}
		
		local EducatorCount = 0
		
		for _, OtherEducator in game.Workspace:GetChildren() do
			if OtherEducator.Name == "Baldi" then
				EducatorCount += 1
			end
		end
		
		Educator:SetAttribute("EducatorNumber", EducatorCount)
		Educator:SetAttribute("DefaultMode", "Schoolhouse")
		Educator:SetAttribute("CurrentMode", Educator:GetAttribute("DefaultMode"))
		Educator:SetAttribute("Stunned", false)
		Educator:SetAttribute("Atomized", false)
		
		for Name, Properties in EducatorStats do
			for Property, Value in Properties do
				if Property ~= "Modes" then
					Educator:SetAttribute(Property..Name, Value)
				else
					for ModeName, ModeProperties in Value do
						for ModeProperty, ModeValue in ModeProperties do
							Educator:SetAttribute(ModeProperty..Name..ModeName, ModeValue)
						end
					end
				end
			end
		end
		
		local function EducatorProperty(Property, PropertyType)
			if Educator:GetAttribute("CurrentMode") and Educator:GetAttribute("DefaultMode") and Property then
				if (type(Educator:GetAttribute("CurrentMode")) == "string" or type(Educator:GetAttribute("CurrentMode")) == "number")
					and (type(Educator:GetAttribute("DefaultMode")) == "string" or type(Educator:GetAttribute("DefaultMode")) == "number")
					and (type(Property) == "string" or type(Property) == "number") then
					if type(Educator:GetAttribute(Property..Educator:GetAttribute("CurrentMode"))) == string.lower(PropertyType) then
						if Educator:GetAttribute("CurrentMode") == Educator:GetAttribute("DefaultMode") then
							return Educator:GetAttribute(Property..Educator:GetAttribute("CurrentMode"))
						else
							return Educator:GetAttribute(Property..Educator:GetAttribute("DefaultMode")..Educator:GetAttribute("CurrentMode"))
						end
					end
				end
			end
			
			return
		end
		
		
		
		local Waiting = 50

		repeat
			if game.Players.LocalPlayer.Character then
				if game.Players.LocalPlayer.Character.Parent == game.Workspace.GameplayFolder.Characters then
					if game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
						break
					end
				end
			end
			
			Waiting -= 1

			task.wait(0.1)
		until Waiting <= 0
		
		local EducatorSpawnSound = Educator.Baldi.BaldiSpawn

		if Info then
			if Info.Reason == "Revive" then
				EducatorSpawnSound = Educator.Baldi.BaldiDespawn
			elseif Info.Reason == "First Schoolhouse" then
				EducatorSpawnSound = Educator.Baldi.BaldiSchoolhouseStart
			elseif Info.Reason == "Crystal" then
				EducatorSpawnSound = Educator.Baldi.BaldiCrystal
			elseif Info.Reason == "Second Schoolhouse" then
				EducatorSpawnSound = Educator.Baldi.BaldiEnterFinale
			end
			
			if Info.Spawnpoint then
				Educator:PivotTo(Info.Spawnpoint.CFrame)
			else
				Educator:PivotTo(game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.fromOrientation(0, math.rad(math.random(-60, 60)), 0))
				Educator:PivotTo(Educator.WorldPivot * CFrame.new(0, 0, -200) * CFrame.Angles(0, math.pi, 0))
			end
		else
			Educator:PivotTo(game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.fromOrientation(0, math.rad(math.random(-60, 60)), 0))
			Educator:PivotTo(Educator.WorldPivot * CFrame.new(0, 0, -200) * CFrame.Angles(0, math.pi, 0))
		end

		PlaySound(EducatorSpawnSound)

		local Waiting = 50

		repeat
			Waiting -= 1

			task.wait(0.1)
		until Waiting <= 0 or EducatorSpawnSound.TimeLength > 0

		task.wait(EducatorSpawnSound.TimeLength + 1)

		if PlayerMain.PlayerDead or PlayerMain.IsGhost then
			Educator:Destroy()

			return
		end
		
		local function EducatorFlash()
			
		end
		
		local function EducatorAtomize()
			
		end

		local EducatorVector3 = Instance.new("Vector3Value")
		EducatorVector3.Value = Educator.WorldPivot.Position

		game.RunService:BindToRenderStep("EducatorMove"..Educator:GetAttribute("EducatorNumber"), 220, function()
			if EducatorInfo.PlayerCatched then
				local EducatorGlitch = FindByThread(game.Players.LocalPlayer.PlayerGui, "Main.BaldiTouch")

				if EducatorGlitch then
					EducatorGlitch.Position = UDim2.new(0.5, math.random(-20, 20), 0.5, math.random(-20, 20))
				end

				if game.Workspace:FindFirstChild("BaldiTouch") then
					game.Workspace.BaldiTouch:PivotTo(CFrame.lookAt(CurrentCamera.CFrame.Position + (CurrentCamera.CFrame.LookVector * 1.5), CurrentCamera.CFrame.Position))
					game.Workspace.BaldiTouch:PivotTo(CFrame.new(game.Workspace.BaldiTouch.PrimaryPart.CFrame.Position - game.Workspace.BaldiTouch.PrimaryPart.CFrame.UpVector * 5)
						* game.Workspace.BaldiTouch.PrimaryPart.CFrame.Rotation)
				end

				return
			end

			if Educator then
				if Educator.PrimaryPart then
					Educator:PivotTo(CFrame.new(EducatorVector3.Value) * Educator.WorldPivot.Rotation)

					if PlayerZone.CurrentRoom then
						if PlayerZone.CurrentRoom.Name == "Room100" and not game.Players.LocalPlayer:GetAttribute("EducatorRoom100Access") then
							EducatorDespawn({
								Reason = "Room100"
							})
							return
						elseif PlayerZone.CurrentRoom.Name == "RidgeEnd" or PlayerZone.CurrentRoom.Name == "RidgeEnding" then
							EducatorDespawn({
								Reason = "RidgeEnd"
							})
							return
						elseif PlayerZone.CurrentRoom.Name == "SearchlightsEnding" or PlayerZone.CurrentRoom.Name == "ModifierEnding" then
							EducatorDespawn({
								Reason = "ModifierEnding"
							})
							return
						end
					end
					
					if game.Players.LocalPlayer:GetAttribute("PandeMinigame") then
						Educator:SetAttribute("CurrentMode", "PandeMinigame")
					elseif PlayerMain.LockerState then
						Educator:SetAttribute("CurrentMode", "Locker")
					else
						Educator:SetAttribute("CurrentMode", Educator:GetAttribute("DefaultMode"))
					end
					
					local EducatorHitbox = EducatorProperty("Hitbox", "Number")
					
					if not EducatorHitbox then
						return
					end
					
					if not game.Players.LocalPlayer.Character then
						return
					else
						if not game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
							return
						end
					end
					
					if (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - Educator.PrimaryPart.Position).Magnitude < (2.5 * EducatorHitbox) and not PlayerMain.PlayerDead and not PlayerMain.IsGhost and not game.Workspace:HasTag("TemporaryImmunity") and not game.Players.LocalPlayer:HasTag("GodMode") then
						local EducatorNumber = Educator:GetAttribute("EducatorNumber")

						Educator:Destroy()
						Educator = nil
						
						game.Players.LocalPlayer:SetAttribute("EducatorsBeforeDeath", 1)
						
						for _, OtherEducator in game.Workspace:GetChildren() do
							if OtherEducator.Name == "Baldi" then
								OtherEducator:Destroy()

								game.Players.LocalPlayer:SetAttribute("EducatorsBeforeDeath", (game.Players.LocalPlayer:GetAttribute("EducatorsBeforeDeath") or 0) + 1)
							end
						end

						EducatorInfo.PlayerCatched = true

						local EducatorTouch = game.ReplicatedStorage.Assets.BaldiTouch:Clone()
						EducatorTouch.PrimaryPart.PivotOffset = CFrame.new(0, 0, 0) * CFrame.fromOrientation(0, 0, 0)
						EducatorTouch:PivotTo(CFrame.lookAt(CurrentCamera.CFrame.Position + (CurrentCamera.CFrame.LookVector * 1.5), CurrentCamera.CFrame.Position))
						EducatorTouch:PivotTo(CFrame.new(EducatorTouch.PrimaryPart.CFrame.Position - EducatorTouch.PrimaryPart.CFrame.UpVector * 5)
							* EducatorTouch.PrimaryPart.CFrame.Rotation)
						EducatorTouch.Parent = game.Workspace

						game.Lighting.BaldiColour.Enabled = true

						local EducatorGlitch = FindByThread(game.Players.LocalPlayer.PlayerGui, "Main.BaldiTouch")

						if EducatorGlitch then
							EducatorGlitch.Visible = true
						end

						PlayerMain.CameraModule.Switch("HeadFollow")
						game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 0

						PlaySound(EducatorTouch.PrimaryPart.LopeeTouch)

						task.wait(1)

						game.RunService:UnbindFromRenderStep("EducatorMove"..EducatorNumber)

						if EducatorGlitch then
							EducatorGlitch.BackgroundTransparency = 0
							EducatorGlitch.ImageTransparency = 1
						end

						game.ReplicatedStorage.Settings.SFX.Volume = 0
						game.ReplicatedStorage.Settings.Music.Volume = 0
						game.Lighting.BaldiColour.Enabled = false
						
						PlayerMain.DeathScreen.BaldiDeath = true

						local DamageEvent = FindByThread(game.ReplicatedStorage, "Events.LocalDamage")

						if DamageEvent then
							DamageEvent:FireServer(1000, "TheEducator", nil, "TheEducator", true)
						end

						task.wait(2)


						if EducatorGlitch then
							EducatorGlitch.Visible = false
							EducatorGlitch.BackgroundTransparency = 1
							EducatorGlitch.ImageTransparency = 0.75
						end

						EducatorTouch:Destroy()

						EducatorInfo.PlayerCatched = false
						
						if not game.Players.LocalPlayer:GetAttribute("Dead") then
							PlayerMain.CameraModule.Switch("PlayerControl")
							
							if game.Players.LocalPlayer.Character then
								if game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
									game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = PlayerMain.CameraModule.GetWalkSpeed()
								end
							end
						end
						
						local EducatorModelDeath = FindByThread(game.Workspace, "NewDeathCutsceneModel.deathModel.Baldi")
						
						repeat
							EducatorModelDeath = FindByThread(game.Workspace, "NewDeathCutsceneModel.deathModel.Baldi")
							
							Waiting -= 1

							task.wait(0.1)
						until Waiting <= 0 or EducatorModelDeath
						
						if EducatorModelDeath then
							EducatorModelDeath.Transparency = 0
						end
						
						PlayerMain.DeathScreen.BaldiDeath = nil
					end
				end
			end
		end)

		while Educator and not EducatorInfo.PlayerCatched do
			if Educator:FindFirstChild("Baldi") then
				if Educator.PrimaryPart.Transparency == 1 then
					break
				end
		
				local EducatorSpeed = EducatorProperty("Speed", "Number")
				local EducatorCooldown = EducatorProperty("Cooldown", "Number")

				if EducatorSpeed and EducatorCooldown then
					if EducatorSpeed > 0 then
						PlaySound(Educator.Baldi.RulerSound)

						Educator:PivotTo(CFrame.lookAt(Educator.PrimaryPart.Position, CurrentCamera.CFrame.Position))

						game.TweenService:Create(EducatorVector3, TweenInfo.new(0.75, Enum.EasingStyle.Linear), {
							Value = EducatorVector3.Value + (Educator.PrimaryPart.CFrame.LookVector * (25 * EducatorSpeed))
						}):Play()
					end
					
					task.wait(EducatorCooldown)
				else
					task.wait()
				end
			else
				game.Players.LocalPlayer:SetAttribute("EducatorsBeforeDeath", 1)
				
				for _, OtherEducator in game.Workspace:GetChildren() do
					if OtherEducator.Name == "Baldi" then
						OtherEducator:Destroy()

						game.Players.LocalPlayer:SetAttribute("EducatorsBeforeDeath", (game.Players.LocalPlayer:GetAttribute("EducatorsBeforeDeath") or 0) + 1)
					end
				end
				
				break
			end
		end
	end)
end

function EducatorDespawn(Info, EducatorNumber)
	for _, Educator in game.Workspace:GetChildren() do
		if Educator.Name == "Baldi" then
			if EducatorNumber == nil or (Educator:GetAttribute("EducatorNumber") == EducatorNumber) then
				game.RunService:UnbindFromRenderStep("EducatorMove"..Educator:GetAttribute("EducatorNumber"))
				
				task.spawn(function()
					Educator.PrimaryPart.Transparency = 1

					local EducatorDespawnSound = Educator.Baldi.BaldiSchoolhousePrep
					
					if Info then
						if Info.Reason == "First Schoolhouse" then
							EducatorDespawnSound = Educator.Baldi.BaldiSchoolhousePrep
						elseif Info.Reason == "First Schoolhouse Complete" then
							EducatorDespawnSound = Educator.Baldi.BaldiSchoolhouseComplete
						elseif Info.Reason == "Room100" then
							EducatorDespawnSound = Educator.Baldi.BaldiRoom100
						elseif Info.Reason == "RidgeEnd" then
							EducatorDespawnSound = Educator.Baldi.BaldiDespawn
						elseif Info.Reason == "Second Schoolhouse Complete" or Info.Reason == "ModifierEnding" then
							EducatorDespawnSound = Educator.Baldi.BaldiFinaleWin
						end
					end

					PlaySound(EducatorDespawnSound)

					local Waiting = 50

					repeat
						Waiting -= 1

						task.wait(0.1)
					until Waiting <= 0 or EducatorDespawnSound.TimeLength > 0

					task.wait(EducatorDespawnSound.TimeLength)

					Educator:Destroy()
				end)
			end
		end
	end
end

game.Players.LocalPlayer.CharacterAdded:Connect(function()
	if type(game.Players.LocalPlayer:GetAttribute("EducatorsBeforeDeath")) == "number" and game.Players.LocalPlayer:GetAttribute("EducatorChase") then
		if game.Players.LocalPlayer:GetAttribute("EducatorsBeforeDeath") > 0 then
			for i = 1, game.Players.LocalPlayer:GetAttribute("EducatorsBeforeDeath") do
				EducatorSpawn({
					Reason = "Revive"
				})
			end
			
			game.Players.LocalPlayer:SetAttribute("EducatorsBeforeDeath", 0)
		end
	end
end)

game.Players.LocalPlayer:GetAttributeChangedSignal("Dead"):Connect(function()
	if game.Players.LocalPlayer:GetAttribute("Dead") then
		for _, Educator in game.Workspace:GetChildren() do
			if Educator.Name == "Baldi" then
				game.RunService:UnbindFromRenderStep("EducatorMove"..Educator:GetAttribute("EducatorNumber"))

				Educator:Destroy()
			end
		end
	end
end)

local RidgeCutsceneEvent = FindByThread(game.ReplicatedStorage, "Events.RidgeCutscene")

if RidgeCutsceneEvent then
	RidgeCutsceneEvent.OnClientEvent:Connect(function()
		game.Players.LocalPlayer:SetAttribute("EducatorRoom100Access", true)
		
		if PlayerMain.PlayerDead or PlayerMain.IsGhost or not game.Players.LocalPlayer:GetAttribute("EducatorChase") then
			return
		end
		
		if not PlayerMain.InCutscene then
			local Waiting = 50
			
			repeat
				Waiting -= 1
				
				task.wait(0.1)
			until Waiting <= 0 or not PlayerMain.InCutscene
		end
		
		if PlayerMain.PlayerDead or PlayerMain.IsGhost or not game.Players.LocalPlayer:GetAttribute("EducatorChase") then
			return
		end
		
		repeat
			if PlayerMain.PlayerDead or PlayerMain.IsGhost or not game.Players.LocalPlayer:GetAttribute("EducatorChase") then
				break
			end
			
			task.wait(0.1)
		until not PlayerMain.InCutscene
		
		if PlayerMain.PlayerDead or PlayerMain.IsGhost or not game.Players.LocalPlayer:GetAttribute("EducatorChase") then
			return
		end
		
		if not PlayerZone.CurrentRoom then
			return
		end
		
		EducatorSpawn({
			Reason = "Crystal",
			Spawnpoint = PlayerZone.CurrentRoom:FindFirstChild("BaldiSpawner")
		})
	end)
end

game.Players.LocalPlayer:GetAttributeChangedSignal("EducatorChase"):Connect(function()
	if game.Players.LocalPlayer:GetAttribute("EducatorChase") then
		local EducatorExist = false
		
		for _, Educator in game.Workspace:GetChildren() do
			if Educator.Name == "Baldi" and Educator.PrimaryPart.Transparency ~= 1 then
				EducatorExist = true
			end
		end
		
		if not EducatorExist then
			EducatorSpawn()
		end
	else
		EducatorDespawn()
	end
end)

game.Players.LocalPlayer:SetAttribute("EducatorChase", true)
