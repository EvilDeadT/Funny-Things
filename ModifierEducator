local RidgeCutsceneEvent = FindByThread(game.ReplicatedStorage, "Events.RidgeCutscene")

if RidgeCutsceneEvent then
	RidgeCutsceneEvent.OnClientEvent:Connect(function()
		game.Players.LocalPlayer:SetAttribute("EducatorRoom100Access", true)
		
		if PlayerMain.PlayerDead or PlayerMain.IsGhost or not game.Players.LocalPlayer:GetAttribute("EducatorChase") then
			return
		end
		
		if not PlayerMain.InCutscene then
			local Waiting = 50
			
			repeat
				if PlayerMain.InCutscene then
					break
				end
				
				Waiting -= 1
				
				task.wait(0.1)
			until Waiting <= 0
		end
		
		if PlayerMain.PlayerDead or PlayerMain.IsGhost or not game.Players.LocalPlayer:GetAttribute("EducatorChase") then
			return
		end
		
		repeat
			if PlayerMain.PlayerDead or PlayerMain.IsGhost or not game.Players.LocalPlayer:GetAttribute("EducatorChase") then
				break
			end
			
			task.wait(0.1)
		until not PlayerMain.InCutscene
		
		if PlayerMain.PlayerDead or PlayerMain.IsGhost or not game.Players.LocalPlayer:GetAttribute("EducatorChase") then
			return
		end
		
		if not PlayerZone.CurrentRoom then
			return
		end
		
		EducatorSpawn({
			Reason = "Crystal",
			Spawnpoint = PlayerZone.CurrentRoom:FindFirstChild("BaldiSpawner")
		})
	end)
end

game.Players.LocalPlayer:GetAttributeChangedSignal("EducatorChase"):Connect(function()
	if game.Players.LocalPlayer:GetAttribute("EducatorChase") then
		local EducatorExist = false
		
		for _, Educator in game.Workspace:GetChildren() do
			if Educator.Name == "Baldi" then
				EducatorExist = true
			end
		end
		
		if not EducatorExist then
			EducatorSpawn()
		end
	else
		EducatorDespawn()
	end
end)

game.Players.LocalPlayer:SetAttribute("EducatorChase", true)
