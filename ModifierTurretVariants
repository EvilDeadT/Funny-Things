	local function TurretDesiredLocationIdle(TurretVerticalPos, TurretHorisontalPos)
		if not Turret:GetAttribute("Active") then
			return
		end

		if TurretAimBaseJoint_2 then
			TurretAimBaseJoint_2:Pause()
			TurretAimBaseJoint_2 = nil
		end
		if TurretAimPivot then
			TurretAimPivot:Pause()
			TurretAimPivot = nil
		end

		if (v35 ~= TurretVerticalPos or v36 ~= TurretHorisontalPos) and not TurretInfo.Sound.MovingLoop.Playing then
			PlaySound(TurretInfo.Sound.MovingLoop)
		end
		
		local v1 = math.rad(TurretVerticalPos)
		local v2 = math.rad(TurretHorisontalPos)
		v35 = v1
		v36 = v2
		TurretAimBaseJoint_2 = game.TweenService:Create(TurretInfo.Model.BaseJoint_2, TweenInfo.new(Turret:GetAttribute("SearchSpeedTime"), Enum.EasingStyle.Linear), {
			C1 = CFrame.new(-0.02, 0, 0) * CFrame.Angles(0, v2, 0)
		})
		TurretAimPivot = game.TweenService:Create(TurretInfo.Model.Pivot, TweenInfo.new(Turret:GetAttribute("SearchSpeedTime"), Enum.EasingStyle.Linear), {
			C1 = CFrame.new(0.5, 0.5, 0.75) * CFrame.Angles(v1, 0, 0)
		})

		TurretAimBaseJoint_2:Play()
		TurretAimPivot:Play()

		task.wait(Turret:GetAttribute("SearchSpeedTime"))

		if v1 ~= v1 or v2 ~= v2 then
			return
		end

		TurretInfo.Sound.MovingLoop:Stop()
	end
	
