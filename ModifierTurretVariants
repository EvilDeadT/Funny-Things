	local function TurretDesiredLocationShoot(Info)
		if Info == nil then
			return
		end

		if (Turret:GetAttribute("MagazinesLeft") <= 0 and not game.ReplicatedStorage.GameSettings.Modifier:FindFirstChild("TurretUpgrades")) or not Turret:GetAttribute("Active") or Target.Value or Info.Target == nil then
			return
		end
		
		if Info.Target == game.Players.LocalPlayer and not PlayerMain.PainterDead then
			Turret.Target.Value = game.Players.LocalPlayer.Character.HumanoidRootPart
		elseif Info.Target:IsA("Model") then
			Turret.Target.Value = Info.Target.PrimaryPart or Info.Target
		end

		Turret:SetAttribute("Shooting", true)

		task.wait(Turret:GetAttribute("TrackingTime"))

		for i = 1, Turret:GetAttribute("MaxBullets") do
			TurretShoot()

			task.wait(1 / Turret:GetAttribute("FireRate"))
		end
		
		Turret:SetAttribute("MagazinesLeft", Turret:GetAttribute("MagazinesLeft") - 1)
		Turret:SetAttribute("Shooting", false)
		
		task.wait(0.5)

		Turret.Target.Value = nil

		if Turret:GetAttribute("MagazinesLeft") <= 0 and not game.ReplicatedStorage.GameSettings.Modifier:FindFirstChild("TurretUpgrades") then
			Turret:SetAttribute("Reloading", true)
			Turret:SetAttribute("Active", false)

			task.wait(3)

			PlaySound(TurretInfo.Sound.Reload)

			task.wait(4)

			Turret:SetAttribute("MagazinesLeft", Turret:GetAttribute("MaxMagazines"))
			Turret:SetAttribute("Reloading", false)

			if Turret:GetAttribute("PlayerInRoom") and not Turret:GetAttribute("Disabled") then
				Turret:SetAttribute("Active", true)
			end
		end
	end
	
	local LastTurretVerticalPos = nil
	local LastTurretHorisontaPos = nil

	local function TurretDesiredLocationIdle(TurretVerticalPos, TurretHorisontalPos, TurretHorisontalStatus)
		if not Turret:GetAttribute("Active") then
			return
		end

		if TurretAimBaseJoint_2 then
			TurretAimBaseJoint_2:Pause()
			TurretAimBaseJoint_2 = nil
		end
		if TurretAimPivot then
			TurretAimPivot:Pause()
			TurretAimPivot = nil
		end
		if TurretIdleTimer then
			task.cancel(TurretIdleTimer)
			TurretIdleTimer = nil
		end

		if (LastTurretVerticalPos ~= TurretVerticalPos or LastTurretHorisontaPos ~= TurretHorisontalPos) and not TurretInfo.Sound.MovingLoop.Playing then
			PlaySound(TurretInfo.Sound.MovingLoop)
		end
		
		local CurrentVerticalPos = math.rad(TurretVerticalPos)
		local CurrentHorisontalPos = math.rad(TurretHorisontalPos)
		local CurrectCenterPos = math.rad((Turret:GetAttribute("MaxLeft") + Turret:GetAttribute("MaxRight")) / 2)
		LastTurretVerticalPos = TurretVerticalPos
		LastTurretHorisontaPos = TurretHorisontalPos
		
		local TurretAimSpeed = Turret:GetAttribute("SearchSpeedTime") * (math.abs(Turret:GetAttribute("MaxLeft") - Turret:GetAttribute("MaxRight")) / 100)
		
		TurretAimBaseJoint_2 = game.TweenService:Create(TurretInfo.Model.BaseJoint_2, TweenInfo.new(TurretAimSpeed / 2, Enum.EasingStyle.Linear), {
			C1 = CFrame.new(-0.02, 0, 0) * CFrame.Angles(0, CurrectCenterPos, 0)
		})
		TurretAimPivot = game.TweenService:Create(TurretInfo.Model.Pivot, TweenInfo.new(TurretAimSpeed / 2, Enum.EasingStyle.Linear), {
			C1 = CFrame.new(0.5, 0.5, 0.75) * CFrame.Angles(CurrentVerticalPos, 0, 0)
		})

		TurretAimBaseJoint_2:Play()
		TurretAimPivot:Play()
		
		TurretIdleTimer = task.delay(TurretAimSpeed / 2, function()
			TurretAimBaseJoint_2 = game.TweenService:Create(TurretInfo.Model.BaseJoint_2, TweenInfo.new(TurretAimSpeed / 2, Enum.EasingStyle.Linear), {
				C1 = CFrame.new(-0.02, 0, 0) * CFrame.Angles(0, CurrentHorisontalPos, 0)
			})
			TurretAimPivot = game.TweenService:Create(TurretInfo.Model.Pivot, TweenInfo.new(TurretAimSpeed / 2, Enum.EasingStyle.Linear), {
				C1 = CFrame.new(0.5, 0.5, 0.75) * CFrame.Angles(CurrentVerticalPos, 0, 0)
			})

			TurretAimBaseJoint_2:Play()
			TurretAimPivot:Play()
		end)

		task.wait(TurretAimSpeed)

		TurretInfo.Sound.MovingLoop:Stop()
	end
	
