	local function TurretPlayerDamage(DamageType)
		local DamageEvent = FindByThread(game.ReplicatedStorage, "Events.LocalDamage")
		
		if not DamageEvent then
			return
		end
		
		if DamageType == "BulletHit" then
			DamageEvent:FireServer(Turret:GetAttribute("DamageHit"), "DefenseSystem", 1)
			
			if Turret:GetAttribute("PoisonDamage") and Turret:GetAttribute("PoisonSpeed") and Turret:GetAttribute("PoisonDuration") then
				local HealthMode = FindByThread(game.Players.LocalPlayer, "PlayerFolder.HealthMode")
				
				if HealthMode then
					if HealthMode.Value ~= "Poison" then
						PlayerHealthMode = HealthMode.Value
						
						HealthMode.Value = "Poison"
					end
				end
				
				game.Players.LocalPlayer:SetAttribute("PoisonDamage", Turret:GetAttribute("PoisonDamage"))
				game.Players.LocalPlayer:SetAttribute("PoisonDuration", math.clamp(
					(game.Players.LocalPlayer:GetAttribute("PoisonDuration") or 0) + Turret:GetAttribute("PoisonDuration"),
					0,
					50
					))

				if game.Players.LocalPlayer:GetAttribute("PoisonTimer") == nil then
					game.Players.LocalPlayer:SetAttribute("PoisonTimer", 4 / Turret:GetAttribute("PoisonSpeed"))
				end

				task.spawn(function()
					while game.Players.LocalPlayer:GetAttribute("PoisonDuration") > 0 do
						task.wait(0.01)

						game.Players.LocalPlayer:SetAttribute("PoisonDuration", ((game.Players.LocalPlayer:GetAttribute("PoisonDuration") * 100) - 1) / 100)
						game.Players.LocalPlayer:SetAttribute("PoisonTimer", ((game.Players.LocalPlayer:GetAttribute("PoisonTimer") * 100) - 1) / 100)

						if game.Players.LocalPlayer:GetAttribute("PoisonTimer") <= 0 then
							TurretPlayerDamage("Poison")

							game.Players.LocalPlayer:SetAttribute("PoisonTimer", 4 / Turret:GetAttribute("PoisonSpeed"))
						end
					end
					
					if HealthMode then
						HealthMode.Value = PlayerHealthMode
					end

					game.Players.LocalPlayer:SetAttribute("PoisonDamage", nil)
					game.Players.LocalPlayer:SetAttribute("PoisonDuration", nil)
					game.Players.LocalPlayer:SetAttribute("PoisonTimer", nil)
				end)
			end
		elseif DamageType == "Poison" then
			print(PlayerMain.Health.CurrentHealth)
			if not Turret:GetAttribute("PoisonFatal") then
				if PlayerMain.Health.CurrentHealth - Turret:GetAttribute("PoisonDamage") > 0 then
