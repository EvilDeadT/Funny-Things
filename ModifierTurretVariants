						DetectedPlayer = true
					end

					if ObjectInRaycast.Instance:IsDescendantOf(game.Workspace.GameplayFolder.Monsters) then
						for _, Monster in game.Workspace.GameplayFolder.Monsters:GetChildren() do
							if ObjectInRaycast.Instance:IsDescendantOf(Monster) then
								DetectedMonster = Monster
							end
						end
					end
				end
			end
			if DetectedPlayer and not TurretAttack then
				TurretAttack = true

				TurretDesiredLocationShoot({
					Target = game.Players.LocalPlayer
				})

				if game.ReplicatedStorage.GameSettings.Modifier:FindFirstChild("ArtPortfolio") then
					for i = 1, math.random(1, 2) do
						PlayerMain.SpecialLocalEffects.Effects.PainterPopup("rbxassetid://74954245678736")
					end
				end
			end
			if DetectedMonster and not MonsterAttacked[DetectedMonster] then
				MonsterAttacked[DetectedMonster] = true

				task.delay(1, function()
					MonsterAttacked[DetectedMonster] = nil
				end)

				TurretDesiredLocationShoot({
					Target = DetectedMonster
				})
			end
		end)
	end)
	
	TurretInfo.Anim.Open:GetMarkerReachedSignal("OpeningSound"):Connect(function()
		PlaySound(TurretInfo.Sound.Spawn)
	end)

	Turret:GetAttributeChangedSignal("Shooting"):Connect(function()
		if not Turret:GetAttribute("Shooting") then
			return
		end

		if TurretAimBaseJoint_2 then
			TurretAimBaseJoint_2:Pause()
			TurretAimBaseJoint_2 = nil
		end
		if TurretAimPivot then
			TurretAimPivot:Pause()
			TurretAimPivot = nil
		end
		if TurretIdleTimer then
			task.cancel(TurretIdleTimer)
			TurretIdleTimer = nil
		end

		PlaySound(TurretInfo.Model.BaseJoint.TurretAlerted)

		if not Turret:GetAttribute("BeamsDisabled") then
			for i = 1, 5 do
				for _, Beam in TurretInfo.Model.AllBeams do
					Beam.Enabled = not Beam.Enabled
				end

				task.wait(Turret:GetAttribute("TrackingTime") / 6)
			end

			for _, Beam in TurretInfo.Model.AllBeams do
				Beam.Enabled = Turret:GetAttribute("Active")
			end
		end
	end)

	local function TurretUpdateMainPosition(NewPart)
		local v1, v2, _ = TurretInfo.Model.Root.CFrame:ToObjectSpace(NewPart):ToOrientation()
		local sum = v2 + math.pi
		if sum > math.pi then
			sum = sum - 6.283185307179586
		elseif sum < -3.141592653589793 then
			sum = sum + 6.283185307179586
		end
		return -v1, -sum
	end

	Target:GetPropertyChangedSignal("Value"):Connect(function()
		local TurretTarget = Target.Value
		if TurretTarget == game.Players.LocalPlayer.Character.HumanoidRootPart then
			if PlayerMain.Data.GameSettings.DeafMode.Value == 1 then
				PlayerMain.SubTitles.new("A turret has locked on to me!", 4):Show()
			end
		else
			TurretAttack = false
			
			if TurretTarget then
				if TurretTarget:IsA("Model") then
					return
				end
			end
		end

		game.RunService:UnbindFromRenderStep("track"..UniqueTurretTag)

		if TurretTarget then
			game.RunService:BindToRenderStep("track"..UniqueTurretTag, 251, function()
				local OrienX, OrienY, OrienZ = TurretInfo.Model.Root.CFrame:ToObjectSpace((CFrame.lookAt(TurretInfo.Model.BaseJoint.Position, TurretTarget.Position))):ToOrientation()
				local sum = OrienY + math.pi
				
				if sum > math.pi then
					sum = sum - 6.283185307179586
				elseif sum < -3.141592653589793 then
					sum = sum + 6.283185307179586
				end
				
				game.TweenService:Create(TurretInfo.Model.BaseJoint_2, TweenInfo.new(Turret:GetAttribute("TrackingSpeed"), Enum.EasingStyle.Linear), {
					C1 = CFrame.new(-0.02, 0, 0) * CFrame.Angles(0, -sum, 0)
				}):Play()
				game.TweenService:Create(TurretInfo.Model.Pivot, TweenInfo.new(Turret:GetAttribute("TrackingSpeed"), Enum.EasingStyle.Linear), {
					C1 = CFrame.new(0.5, 0.5, 0.75) * CFrame.Angles(-OrienX, 0, 0)
				}):Play()
			end)
		end
	end)
	
	local Horisontal = "max"

	Turret:GetAttributeChangedSignal("Active"):Connect(function()
		if Turret:GetAttribute("Active") then
			if TurretAimBaseJoint_2 then
				TurretAimBaseJoint_2:Pause()
				TurretAimBaseJoint_2 = nil
			end
			if TurretAimPivot then
				TurretAimPivot:Pause()
				TurretAimPivot = nil
			end
			if TurretIdleTimer then
				task.cancel(TurretIdleTimer)
				TurretIdleTimer = nil
			end
			
			TurretInfo.Model.BaseJoint_2.C1 = CFrame.new(-0.02, 0, 0)
			TurretInfo.Model.Pivot.C1 = CFrame.new(0.5, 0.5, 0.75)
			
			TurretInfo.Anim.Close:Stop()
			TurretInfo.Anim.Open:Play()
			TurretInfo.Anim.OffIdle:Stop()
			TurretInfo.Anim.OnIdle:Play()
			
			task.spawn(function()
				while Turret:GetAttribute("Active") do
					local TurretHorisontal = nil

					if Target.Value or Turret:GetAttribute("Shooting") then
						task.wait(0.3)
					end

					local TurretVertical = math.random(Turret:GetAttribute("MaxUp"), Turret:GetAttribute("MaxDown"))

					if Horisontal == "max" then
						TurretHorisontal = Turret:GetAttribute("MaxLeft")
						Horisontal = "min"
					elseif Horisontal == "min" then
						TurretHorisontal = Turret:GetAttribute("MaxRight")
						Horisontal = "max"
					end
					
					TurretDesiredLocationIdle(TurretVertical, TurretHorisontal, Horisontal)
					
					local SearchTime = Turret:GetAttribute("SearchSpeedTime") * 10
					
					while SearchTime > 0 do						
						if Turret:GetAttribute("Active") then
							SearchTime -= 1
							
							if SearchTime > 0 then
								task.wait(0.1)
							end
						else
							SearchTime = 0
						end
					end
				end
			end)

			while Turret:GetAttribute("Active") do
				local TurretRandomBeepTime = math.random(5, 7) * 10
				
				while TurretRandomBeepTime > 0 do
					task.wait(0.1)
					
					if Turret:GetAttribute("Active") then
						TurretRandomBeepTime -= 1
					else
						TurretRandomBeepTime = 0
					end
				end

				if not Turret:GetAttribute("Active") then
					break
				end

				local BeepSound = LoadSound(TurretInfo.Sound.RandomBeeps, TurretInfo.Model.BaseJoint, true)
				PlaySound(BeepSound)

				game.Debris:AddItem(BeepSound, 3)
			end
		else
			if TurretAimBaseJoint_2 then
				TurretAimBaseJoint_2:Pause()
				TurretAimBaseJoint_2 = nil
			end
			if TurretAimPivot then
				TurretAimPivot:Pause()
				TurretAimPivot = nil
			end
			if TurretIdleTimer then
				task.cancel(TurretIdleTimer)
				TurretIdleTimer = nil
			end
			
			TurretInfo.Model.BaseJoint_2.C1 = CFrame.new(-0.02, 0, 0)
			TurretInfo.Model.Pivot.C1 = CFrame.new(0.5, 0.5, 0.75)
			
			game.RunService:UnbindFromRenderStep(UniqueTurretTag)
			game.RunService:UnbindFromRenderStep("track"..UniqueTurretTag)
			
			for _, Beam in TurretInfo.Model.AllBeams do
				Beam.Enabled = false
			end
			
			TurretInfo.Model.BeamMesh.Transparency = 1
			TurretInfo.Model.BeamMesh.Attachment0.SpotLight.Enabled = false
			TurretInfo.Model.BeamMesh.Beam.Enabled = false
			
			TurretInfo.Anim.Close:Play()

			PlaySound(TurretInfo.Sound.Despawn)
			TurretInfo.Sound.MovingLoop:Stop()

			task.wait(1)

			if Turret:GetAttribute("Active") then
				return
			end

			TurretInfo.Anim.OffIdle:Play()
			TurretInfo.Anim.OnIdle:Stop()
		end
	end)
	
	Turret:GetAttributeChangedSignal("Disabled"):Connect(function()
		if Turret:GetAttribute("Disabled") then
			Turret:SetAttribute("Active", false)
		else
			if Turret:GetAttribute("PlayerInRoom") and not Turret:GetAttribute("Reloading") then
				Turret:SetAttribute("Active", true)
			end
		end
	end)
	
	local TurretUnactiveTimer = nil
	
	Turret:GetAttributeChangedSignal("PlayerInRoom"):Connect(function()
		if Turret:GetAttribute("PlayerInRoom") then
			if TurretUnactiveTimer then
				task.cancel(TurretUnactiveTimer)
				TurretUnactiveTimer = nil
			end
			
			if not Turret:GetAttribute("Disabled") and not Turret:GetAttribute("Reloading") then
				Turret:SetAttribute("Active", true)
			end
		else
			TurretUnactiveTimer = task.delay(3, function()
				if not Turret:GetAttribute("Disabled") then
					if Turret:GetAttribute("Shooting") then
						Turret:GetAttributeChangedSignal("Shooting"):Wait()
					end
					
					if not Turret:GetAttribute("PlayerInRoom") and not Turret:GetAttribute("Disabled") and not Turret:GetAttribute("Shooting") then
						Turret:SetAttribute("Active", false)
					end
				end
			end)
		end
	end)
end

game.RunService.RenderStepped:Connect(function()
	for _, Room in game.Workspace.GameplayFolder.Rooms:GetChildren() do
		if TurretCustomRoomPosition[Room.Name] and not Room:GetAttribute("TurretCustomPosition") then
			CreateCustomRoomPosition(Room)
		end
		
		if Room:FindFirstChild("Interactables") then
			for _, Turret in Room.Interactables:GetChildren() do
				if string.find(Turret.Name, "TurretSpawn") and Turret:IsA("BasePart") and not Turret:GetAttribute("CustomMade") and not Turret:GetAttribute("CustomChecked") then
					CreateCustomTurret(Turret, Room, {
						Variant = TurretVariants[math.random(1, #TurretVariants)]
					})

					Turret:Destroy()
				elseif string.find(Turret.Name, "Turret") and Turret:GetAttribute("CustomMade") then
					if Room.Interactables:FindFirstChild("TurretControls") then
						if Room.Interactables.TurretControls:FindFirstChildWhichIsA("ProximityPrompt", true) then
							Turret:SetAttribute("Disabled", false)
						else
							Turret:SetAttribute("Disabled", true)
						end
					end

					Turret:SetAttribute("PlayerInRoom", PlayerZone.CurrentRoom == Room)
				end
			end
		end
	end
end)
