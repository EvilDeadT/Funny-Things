local function PlaySound(Sound)
	if Sound then
		if Sound:GetAttribute("ID") then
			Sound.SoundId = Sound:GetAttribute("ID")
		end

		Sound:Play()
	end
end

local function LoadSound(SelectedSound, SoundParent, RandomSound)
	if type(SelectedSound) == "table" then
		if RandomSound then
			SelectedSound = SelectedSound[math.random(1, #SelectedSound)]
		end
	end

	if type(SelectedSound) ~= "table" then
		SelectedSound = SelectedSound:Clone()
		if SoundParent then
			SelectedSound.Parent = SoundParent
		end

		if SelectedSound:GetAttribute("ID") then
			SelectedSound.SoundId = SelectedSound:GetAttribute("ID")
		end
	end

	return SelectedSound
end

function FindByThread(PathStart, Thread)
	if PathStart and Thread then
		local PickedFolder = PathStart

		for _, Path in string.split(Thread, ".") do
			local PathInstance = Path
			local SpecialInstance = nil
			local SpecialMethod = nil

			if string.find(PathInstance, ":") then
				PathInstance = string.split(Path, ":")[1]
				SpecialInstance = string.split(string.split(string.split(Path, ":")[2], "(")[2], ")")[1]
				SpecialMethod = string.split(string.split(Path, ":")[2], "(")[1]
			end

			if PathInstance == "LocalPlayer" then
				PickedFolder = game.Players.LocalPlayer
			elseif PathInstance == "CFrame" then
				PickedFolder = PickedFolder.CFrame

				return PickedFolder
			else
				local IsProperty = pcall(function()
					PickedFolder[PathInstance] = PickedFolder[PathInstance]
				end)
				
				if PickedFolder:FindFirstChild(PathInstance) or IsProperty then
					PickedFolder = PickedFolder[PathInstance]
				else
					print("FindByThread not found: "..PathInstance)

					return
				end
			end

			if SpecialInstance then
				if SpecialMethod == "FindFirstChildWhichIsA" then
					PickedFolder = PickedFolder:FindFirstChildWhichIsA(SpecialInstance)
				elseif SpecialMethod == "GetChildren" then
					PickedFolder = PickedFolder:GetChildren()
				end
			end
		end

		return PickedFolder
	end

	return
end

function CreateCustomRoomPosition(Room)
	if not Room:FindFirstChild("Entrances") then
		return
	end
	
	if #Room.Entrances:GetChildren() ~= 1 then
		return
	end
	
	local CollisionPart = Room.Entrances:GetChildren()[1]:FindFirstChild("CollisionPart")
	
	if not CollisionPart then
		return
	end
	
	Room:SetAttribute("TurretCustomPosition", true)
	
	local function CreateCustomObject(Category, CategoryObjects)
		for Name, Properties in CategoryObjects do
			if not CollisionPart then
				return print("CreateCustomObject No CollisionPart")
			end
			
			local NewInstance = Instance.new(Properties.ClassName)
			NewInstance.Name = Name
			NewInstance.Position = CollisionPart.Position + ((Properties.Position.X * CollisionPart.CFrame.LookVector)
				+ (Properties.Position.Y * CollisionPart.CFrame.UpVector)
				+ (Properties.Position.Z * CollisionPart.CFrame.RightVector))
			NewInstance.Orientation = Vector3.new(
				CollisionPart.Orientation.X + Properties.Orientation.X,
				CollisionPart.Orientation.Y + Properties.Orientation.Y,
				CollisionPart.Orientation.Z + Properties.Orientation.Z
			)
			
			if Properties.Size then
				NewInstance.Size = Properties.Size
			end
			
			if Properties.MeshId then
				NewInstance:ApplyMesh(game.InsertService:CreateMeshPartAsync(Properties.MeshId,
					Properties.CollisionFidelity or Enum.CollisionFidelity.Box,
					Properties.RenderFidelity or Enum.RenderFidelity.Automatic)
				)
			end
			
			NewInstance:SetAttribute("ObjectCategory", Category)
			
			local RestrictedProperties = {
				"ClassName",
				"Parent",
				"Position",
				"Orientation",
				"MeshId",
				"CollisionFidelity",
				"RenderFidelity"
			}
			
			for Property, Value in Properties do
				if not table.find(RestrictedProperties, Property) then
					if Property == "Attributes" then
						for AttributeName, AttributeValue in Value do
							NewInstance:SetAttribute(AttributeName, AttributeValue)
						end
					else
						NewInstance[Property] = Value
					end
				end
			end

			NewInstance.Parent = FindByThread(Room, Properties.Parent)
		end
	end
	
	for Category, CategoryObjects in TurretCustomRoomPosition[Room.Name] do
		if Category == "Gauntlet" and (Room:GetAttribute("SpecialTag") == "Gauntlet" or Room:GetAttribute("MonsterRoomType") == "Gauntlet") then
			CreateCustomObject(Category, CategoryObjects)
		end
	end
end

function CreateCustomTurret(TurretOriginalPart, TurretRoom, Info)
	local function FindInfoByVariant(SearchInfo)
		local SearchTable = SearchInfo.SearchStart or TurretVariantsInfo
		local SelectedVariant = "Default"
		local SelectedPowerVariant = "Default"

		if SearchTable[SearchInfo.Variant] then
			if SearchTable[SearchInfo.Variant][SearchInfo.PowerVariant] then
				if SearchInfo.DesiredInfo == nil then
					SelectedVariant = SearchInfo.Variant
					SelectedPowerVariant = SearchInfo.PowerVariant
				else
					if SearchTable[SearchInfo.Variant][SearchInfo.PowerVariant][SearchInfo.DesiredInfo] then
						if SearchInfo.SearchInfo == nil and SearchTable[SearchInfo.Variant][SearchInfo.PowerVariant][SearchInfo.DesiredInfo] then
							SelectedVariant = SearchInfo.Variant
							SelectedPowerVariant = SearchInfo.PowerVariant
						elseif SearchInfo.SearchInfo ~= nil and SearchTable[SearchInfo.Variant][SearchInfo.PowerVariant][SearchInfo.SearchInfo] then
							if SearchInfo.SearchInfo2 == nil and SearchTable[SearchInfo.Variant][SearchInfo.PowerVariant][SearchInfo.SearchInfo][SearchInfo.DesiredInfo] then
								SelectedVariant = SearchInfo.Variant
								SelectedPowerVariant = SearchInfo.PowerVariant
							elseif SearchInfo.SearchInfo2 ~= nil and SearchTable[SearchInfo.Variant][SearchInfo.PowerVariant][SearchInfo.SearchInfo][SearchInfo.SearchInfo2] then
								if SearchTable[SearchInfo.Variant][SearchInfo.PowerVariant][SearchInfo.SearchInfo][SearchInfo.SearchInfo2][SearchInfo.DesiredInfo] then
									SelectedVariant = SearchInfo.Variant
									SelectedPowerVariant = SearchInfo.PowerVariant
								end
							end
						end

					else
						if SearchInfo.PowerVariant == "Default" and SearchTable[SearchInfo.Variant].Default then
							if SearchInfo.SearchInfo == nil and SearchTable[SearchInfo.Variant].Default[SearchInfo.DesiredInfo] then
								SelectedVariant = SearchInfo.Variant
							elseif SearchInfo.SearchInfo ~= nil and SearchTable[SearchInfo.Variant].Default[SearchInfo.SearchInfo] then
								if SearchInfo.SearchInfo2 == nil and SearchTable[SearchInfo.Variant].Default[SearchInfo.SearchInfo][SearchInfo.DesiredInfo] then
									SelectedVariant = SearchInfo.Variant
								elseif SearchInfo.SearchInfo2 ~= nil and SearchTable[SearchInfo.Variant].Default[SearchInfo.SearchInfo][SearchInfo.SearchInfo2] then
									if SearchTable[SearchInfo.Variant].Default[SearchInfo.SearchInfo][SearchInfo.SearchInfo2][SearchInfo.DesiredInfo] then
										SelectedVariant = SearchInfo.Variant
									end
								end
							end
						elseif SearchInfo.PowerVariant ~= "Default" and SearchTable.Default[SearchInfo.PowerVariant] then
							if SearchInfo.SearchInfo == nil and SearchTable.Default[SearchInfo.PowerVariant][SearchInfo.DesiredInfo] then
								SelectedPowerVariant = SearchInfo.PowerVariant
							elseif SearchInfo.SearchInfo ~= nil and SearchTable.Default[SearchInfo.PowerVariant][SearchInfo.SearchInfo] then
								if SearchInfo.SearchInfo == nil and SearchTable.Default[SearchInfo.PowerVariant][SearchInfo.SearchInfo][SearchInfo.DesiredInfo] then
									SelectedPowerVariant = SearchInfo.PowerVariant
								elseif SearchInfo.SearchInfo ~= nil and SearchTable.Default[SearchInfo.PowerVariant][SearchInfo.SearchInfo][SearchInfo.SearchInfo2] then
									if SearchTable.Default[SearchInfo.PowerVariant][SearchInfo.SearchInfo][SearchInfo.SearchInfo2][SearchInfo.DesiredInfo] then
										SelectedPowerVariant = SearchInfo.PowerVariant
									end
								end
							end
						end
					end
				end
			end
		end

		if SearchInfo.ReturnInfo then
			if SearchInfo.SearchInfo then
				if SearchInfo.SearchInfo2 then
					return SearchTable[SelectedVariant][SelectedPowerVariant][SearchInfo.SearchInfo][SearchInfo.SearchInfo2][SearchInfo.DesiredInfo]
				else
					return SearchTable[SelectedVariant][SelectedPowerVariant][SearchInfo.SearchInfo][SearchInfo.DesiredInfo]
				end
			else
				return SearchTable[SelectedVariant][SelectedPowerVariant][SearchInfo.DesiredInfo]
			end
		end

		return {
			Variant = SelectedVariant,
			PowerVariant = SelectedPowerVariant
		}
	end
	
	if TurretOriginalPart == nil then
		return print("CreateCustomTurrer No TurretOriginalPart")
	end

	if TurretRoom == nil then
		return print("CreateCustomTurrer No TurretRoom")
	end

	local TurretInfo = {
		Variant = "Default",
		PowerVariant = "Default",
	}

	TurretCount += 1

	local Turret = game.ReplicatedStorage.Assets.Turret:Clone()
	Turret:PivotTo(TurretOriginalPart.CFrame)
	Turret.Parent = TurretRoom:FindFirstChild("Interactables") or TurretRoom
	
	if Info then
		for Property, Value in TurretInfo do
			if Info[Property] then
				TurretInfo[Property] = Info[Property]
				Turret:SetAttribute(Property, Info[Property])
			end
		end
	end

	if TurretVariantsInfo[TurretInfo.Variant] == nil then
		return print("CreateCustomTurret No Info For Variant: "..TurretInfo.Variant)
	end
	
	local TurretShootEvent = nil
	
	if TurretOriginalPart:FindFirstChild("Shoot") then
		if TurretOriginalPart.Shoot:IsA("UnreliableRemoteEvent") then
			TurretShootEvent = TurretOriginalPart.Shoot
			TurretShootEvent.Parent = Turret
		end
	end
	
	local Target = Instance.new("ObjectValue", Turret)
	Target.Name = "Target"
	
	Turret:SetAttribute("CustomMade", true)
	Turret:SetAttribute("Active", false)
	Turret:SetAttribute("Reloading", false)
	
	if TurretOriginalPart:GetAttribute("ObjectCategory") == "Gauntlet" then
		Turret:SetAttribute("Disabled", false)
		
		
	else
		Turret:SetAttribute("Disabled", false)
	end

	Turret:SetAttribute("BeamsDisabled", game.ReplicatedStorage.GameSettings.Modifier:FindFirstChild("TurretUpgrades") ~= nil)

	TurretOriginalPart:SetAttribute("CustomChecked", true)
	
	for VariantName, VariantValue in TurretVariantsInfo do
		for PowerVariantName, PowerVariantValue in VariantValue do
			for AssetCategoryName, AssetCategoryValue in PowerVariantValue do
				if type(AssetCategoryValue) == "table" then
					if TurretInfo[AssetCategoryName] == nil then
						TurretInfo[AssetCategoryName] = {}
					end
					
					for AssetName, AssetValue in AssetCategoryValue do
						if TurretInfo[AssetCategoryName][AssetName] == nil then
							local IsInstance = pcall(function()
								AssetValue.Name = AssetValue.Name
							end)
							
							if IsInstance and type(AssetValue) ~= "table" then
								if AssetValue:IsA("Animation") then
									TurretInfo[AssetCategoryName][AssetName] = Turret.AnimationController.Animator:LoadAnimation(FindInfoByVariant({
										Variant = TurretInfo.Variant,
										PowerVariant = TurretInfo.PowerVariant,
										SearchInfo = AssetCategoryName,
										DesiredInfo = AssetName,
										ReturnInfo = true
									}))
								elseif AssetValue:IsA("Sound") then
									TurretInfo[AssetCategoryName][AssetName] = LoadSound(FindInfoByVariant({
										Variant = TurretInfo.Variant,
										PowerVariant = TurretInfo.PowerVariant,
										SearchInfo = AssetCategoryName,
										DesiredInfo = AssetName,
										ReturnInfo = true
									}))
								elseif AssetValue == "BasePart" then
									TurretInfo[AssetCategoryName][AssetName] = FindByThread(FindInfoByVariant({
										Variant = TurretInfo.Variant,
										PowerVariant = TurretInfo.PowerVariant,
										SearchInfo = AssetCategoryName,
										DesiredInfo = AssetName,
										ReturnInfo = true
									}))
								else
									TurretInfo[AssetCategoryName][AssetName] = FindInfoByVariant({
										Variant = TurretInfo.Variant,
										PowerVariant = TurretInfo.PowerVariant,
										SearchInfo = AssetCategoryName,
										DesiredInfo = AssetName,
										ReturnInfo = true
									})
								end
							else
								if type(AssetName) == "table" then
									for AssetManyName, AssetManyValue in AssetValue do
										TurretInfo[AssetCategoryName][AssetName] = FindByThread(Turret, FindInfoByVariant({
											Variant = TurretInfo.Variant,
											PowerVariant = TurretInfo.PowerVariant,
											SearchInfo = AssetCategoryName,
											SearchInfo2 = AssetName,
											DesiredInfo = AssetManyName,
											ReturnInfo = true
										}))
									end
								elseif type(AssetCategoryName) == "string" then
									local SelectedAsset = FindInfoByVariant({
										Variant = TurretInfo.Variant,
										PowerVariant = TurretInfo.PowerVariant,
										SearchInfo = AssetCategoryName,
										DesiredInfo = AssetName,
										ReturnInfo = true
									})
									
									if type(SelectedAsset) == "table" or type(SelectedAsset) == "userdata" then
										TurretInfo[AssetCategoryName][AssetName] = SelectedAsset
									else
										TurretInfo[AssetCategoryName][AssetName] = FindByThread(Turret, SelectedAsset)
									end
								else
									TurretInfo[AssetCategoryName][AssetName] = FindInfoByVariant({
										Variant = TurretInfo.Variant,
										PowerVariant = TurretInfo.PowerVariant,
