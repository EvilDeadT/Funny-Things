local UI = game.Players.LocalPlayer.PlayerGui.FunnyMenu
local CurrentSelectedModifier = nil
local ListFocus = false
local SelectedModifiers = {}

local function ModifierButtonsColors()
	for _, ModifierButton in UI.ModifiersFrame.ModifierList.List:GetChildren() do
		if ModifierButton:IsA("TextButton") then
			if table.find(SelectedModifiers, ModifierButton.Name) then
				
				if CurrentSelectedModifier == ModifierButton.Name then
					ModifierButton.BackgroundColor3 = Color3.fromRGB(194, 76, 80)
				else
					ModifierButton.BackgroundColor3 = Color3.fromRGB(255, 99, 102)
				end
				ModifierButton.Title.TextColor3 = Color3.fromRGB(255, 255, 255)
			else
				if CurrentSelectedModifier == ModifierButton.Name then
					ModifierButton.BackgroundColor3 = Color3.fromRGB(138, 54, 56)
					ModifierButton.Title.TextColor3 = Color3.fromRGB(255, 255, 255)
				else
					ModifierButton.BackgroundColor3 = Color3.fromRGB(48, 18, 20)
					ModifierButton.Title.TextColor3 = Color3.fromRGB(113, 113, 113)
				end
			end
		end
	end
	
	for _, ModifierButton in UI.ModifiersFrame.ModifierList.List:GetChildren() do
		if ModifierButton:IsA("TextButton") then
			if table.find(SelectedModifiers, ModifierButton.Name) then
				for Category, CategoryModifiers in AllModifiers do
					if CategoryModifiers[ModifierButton.Name] then
						if CategoryModifiers[ModifierButton.Name].Incompatible then
							for _, Incompatible in CategoryModifiers[ModifierButton.Name].Incompatible do
								if table.find(SelectedModifiers, Incompatible) then
									warn("Somehow picked "..ModifierButton.Name.." and "..Incompatible.." modifiers")
									table.remove(SelectedModifiers, table.find(SelectedModifiers, Incompatible))
								end
								
								if UI.ModifiersFrame.ModifierList.List:FindFirstChild(Incompatible) then
									if CurrentSelectedModifier == Incompatible then
										UI.ModifiersFrame.ModifierList.List[Incompatible].BackgroundColor3 = Color3.fromRGB(0, 0, 0)
										UI.ModifiersFrame.ModifierList.List[Incompatible].Title.TextColor3 = Color3.fromRGB(218, 218, 218)
									else
										UI.ModifiersFrame.ModifierList.List[Incompatible].BackgroundColor3 = Color3.fromRGB(0, 0, 0)
										UI.ModifiersFrame.ModifierList.List[Incompatible].Title.TextColor3 = Color3.fromRGB(57, 57, 57)
									end
								end
							end
						end
					end
				end
			end
		end
	end
end

function ModifiersListUpdate()
	local function ModifierButtonPress(Button, InstantPick)
		local ModifierStats = nil

		for Category, CategoryModifiers in AllModifiers do
			if CategoryModifiers[Button.Name] then
				ModifierStats = CategoryModifiers[Button.Name]
				break
			end
		end
		
		if CurrentSelectedModifier ~= Button.Name and not InstantPick then
			CurrentSelectedModifier = Button.Name
			
			UI.ModifiersFrame.ModifierBanner.Title.TitleText.Text = ModifierStats.Name or "NO NAME"
			UI.ModifiersFrame.ModifierBanner.Description.DescriptionText.Text = ModifierStats.Description or "NO DESCRIPTION"
			if ModifierStats.Banner then
				UI.ModifiersFrame.ModifierBanner.Banner.BackgroundText.Text = ""
				UI.ModifiersFrame.ModifierBanner.Banner.BannerImage.Image = "rbxassetid://"..ModifierStats.Banner
			else
				UI.ModifiersFrame.ModifierBanner.Banner.BackgroundText.Text = "No Image"
				UI.ModifiersFrame.ModifierBanner.Banner.BannerImage.Image = ""
			end
			if type(ModifierStats.Percent) == "number" then
				UI.ModifiersFrame.ModifierBanner.Percent.Percentage.Text = ModifierStats.Percent.."%"

				if ModifierStats.Percent > 0 then
					UI.ModifiersFrame.ModifierBanner.Percent.Percentage.Text = "+"..UI.ModifiersFrame.ModifierBanner.Percent.Percentage.Text
				end
			else
				UI.ModifiersFrame.ModifierBanner.Percent.Percentage.Text = "--"
			end
		else
			if Button.BackgroundColor3 ~= Color3.fromRGB(0, 0, 0) then
				if not table.find(SelectedModifiers, Button.Name) then
					table.insert(SelectedModifiers, Button.Name)
				else
					table.remove(SelectedModifiers, table.find(SelectedModifiers, Button.Name))
				end
			end
		end
		
		ModifierButtonsColors()
		
		local Percent = 0
		
		for _, Modifier in SelectedModifiers do
			for Category, CategoryModifiers in AllModifiers do
				if CategoryModifiers[Modifier] then
					if type(CategoryModifiers[Modifier].Percent) == "number" then
						Percent += CategoryModifiers[Modifier].Percent
					end
				end
			end
		end
		
		UI.ModifiersFrame.Percent.Percentage.Text = Percent.."%"
		if Percent > 0 then
			UI.ModifiersFrame.Percent.Percentage.Text = "+"..UI.ModifiersFrame.Percent.Percentage.Text
		end
	end
	
	for _, ModifierButton in UI.ModifiersFrame.ModifierList.List:GetChildren() do
		if ModifierButton:IsA("TextButton") then
			ModifierButton:Destroy()
		end
	end
	
	for Category, CategoryModifiers in AllModifiers do
		for Name, Modifier in CategoryModifiers do
			local ModifierValue = Instance.new("BoolValue", UI.Modifiers)
			ModifierValue.Name = Name
			ModifierValue.Value = false

			local ModifierButton = game.ReplicatedStorage.CustomAssets.Player.UI.Modifiers.ModifierButton:Clone()
			ModifierButton.Name = Name
			ModifierButton.Title.Text = Modifier.Name
			if Modifier.Icon then
				ModifierButton.Icon.Image = "rbxassetid://"..Modifier.Icon
			end
			if type(Modifier.Percent) == "number" then
				if Modifier.Percent == 0 and Modifier.SubModifiers then
					ModifierButton.Percent.Percentage.Text = "??%"
				else
					ModifierButton.Percent.Percentage.Text = Modifier.Percent.."%"

					if Modifier.Percent > 0 then
						ModifierButton.Percent.Percentage.Text = "+"..ModifierButton.Percent.Percentage.Text
					end
				end
			end
			
			if Modifier.SubModifiers then
				for SubName, SubModifier in Modifier.SubModifiers do
					ModifierValue:SetAttribute(SubName, false)
				end
			end
			
			ModifierButton.LayoutOrder = Modifier.LayoutOrder or 0
			
			ModifierButton.Parent = UI.ModifiersFrame.ModifierList.List

			ModifierButton.MouseButton1Click:Connect(function()
				ModifierButtonPress(ModifierButton, false)
			end)
			ModifierButton.MouseButton2Click:Connect(function()
				ModifierButtonPress(ModifierButton, true)
			end)
		end
	end

	UI.ModifiersFrame.ModifierList.List.CanvasSize = UDim2.fromOffset(0, UI.ModifiersFrame.ModifierList.List.UIListLayout.AbsoluteContentSize.Y)
end

ModifiersListUpdate()

for _, Frame in UI.ModifiersFrame.ModifierBanner:GetChildren() do
	if Frame:IsA("Frame") and Frame:FindFirstChildWhichIsA("TextLabel") then
		Frame:FindFirstChildWhichIsA("TextLabel").Text = ""
	end
end

function UIAct(Type, Status)
	if not UI.ScriptStatuses.UIAnim.Value then
		if Type == "ModifiersFrame" then
			if Status == "Open" then
				UI.ScriptStatuses.UIAnim.Value = true

				local BlackScreenTween = game.TweenService:Create(UI.BlackScreen, TweenInfo.new(0.1, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, 0, true), {
					BackgroundTransparency = 0
				})
				BlackScreenTween.Completed:Connect(function()
					UI.ScriptStatuses.UIAnim.Value = false
				end)
				BlackScreenTween:Play()

				task.wait(0.1)

				UI.ModifiersFrame.Visible = true
				UI.Main.Visible = false
			elseif Status == "Apply Modifiers" then
				for _, Modifier in UI.Modifiers:GetChildren() do
					if table.find(SelectedModifiers, Modifier.Name) then
						Modifier.Value = true
					else
						Modifier.Value = false
					end
				end
			elseif Status == "Close" then
				UI.ScriptStatuses.UIAnim.Value = true
				
				local BlackScreenTween = game.TweenService:Create(UI.BlackScreen, TweenInfo.new(0.1, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, 0, true), {
					BackgroundTransparency = 0
				})
				BlackScreenTween.Completed:Connect(function()
					UI.ScriptStatuses.UIAnim.Value = false
				end)
				BlackScreenTween:Play()

				task.wait(0.1)
				
				UI.ModifiersFrame.Visible = false
				UI.Main.Visible = true
			end
		end
	end
end

UI.ModifiersFrame.ModifierList.List.MouseEnter:Connect(function()
	ListFocus = true
end)

UI.ModifiersFrame.ModifierList.List.MouseLeave:Connect(function()
	ListFocus = false
end)

game.UserInputService.InputBegan:Connect(function(Input)
	if Input.UserInputType == Enum.UserInputType.MouseButton1 and not ListFocus then
		CurrentSelectedModifier = nil
		
		for _, Frame in UI.ModifiersFrame.ModifierBanner:GetChildren() do
			if Frame:IsA("Frame") and Frame:FindFirstChildWhichIsA("TextLabel") then
				Frame:FindFirstChildWhichIsA("TextLabel").Text = ""
			end
		end
		UI.ModifiersFrame.ModifierBanner.Banner.BannerImage.Image = ""
		
		ModifierButtonsColors()
	end
end)

UI.ModifiersFrame.ModifierList.List.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
	UI.ModifiersFrame.ModifierList.List.CanvasSize = UDim2.fromOffset(0, UI.ModifiersFrame.ModifierList.List.UIListLayout.AbsoluteContentSize.Y)
end)



UI.ModifiersFrame.LobbyInfo.Buttons.Apply.MouseButton1Click:Connect(function()
