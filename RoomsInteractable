local UI = game.Players.LocalPlayer.PlayerGui.FunnyMenu
local PlayerMain = require(game.Players.LocalPlayer.PlayerGui:WaitForChild("Main"):WaitForChild("Client"):WaitForChild("MainClient"))
local InteractableAssets = {}

UI.Events.RoomAssetInteraction.Event:Connect(function(Asset, Type)
	if table.find(InteractableAssets, Asset) then
		return print(Asset.Name.." Already Interactable")
	end
	
	table.insert(InteractableAssets, Asset)
	
	local InteractAnim = {}
	local InteractSound = {}
	
	for _, Category in game.ReplicatedStorage.CustomAssets.RoomAssets.Sounds:GetChildren() do
		for _, Sound in Category:GetChildren() do
			if string.find(Sound.Name, Asset.Name) and Sound:IsA("Sound") then
				InteractSound[string.split(Sound.Name, Asset.Name)[2]] = Sound:Clone()
				InteractSound[string.split(Sound.Name, Asset.Name)[2]].Name = string.split(Sound.Name, Asset.Name)[2]

				if type(Sound:GetAttribute("UsageParent")) == "string" or type(Sound:GetAttribute("UsageParent")) == "number" then
					InteractSound[string.split(Sound.Name, Asset.Name)[2]].Parent = UI.Events.UIModule:Invoke("FindByThread", Asset, Sound:GetAttribute("UsageParent"))
				end
			end
		end
	end

	for _, Category in game.ReplicatedStorage.CustomAssets.RoomAssets.Animations:GetChildren() do
		for _, Anim in Category:GetChildren() do
			if string.find(Anim.Name, Asset.Name) and Anim:IsA("Animation") then
				InteractAnim[string.split(Anim.Name, Asset.Name)[2]] = Asset.AnimationController.Animator:LoadAnimation(Anim)
			end
		end
	end
	
	if Asset.Name == "NormalDoor" or Asset.Name == "BigDoor" then
		local Prompt = Asset.Root:FindFirstChildWhichIsA("ProximityPrompt")
		Prompt:SetAttribute("Hidden", true)
		Prompt:SetAttribute("Custom", true)
		
		local function AutoPromptHold()
			task.spawn(function()
				if Prompt then
					while Prompt do
						if Prompt and not Asset:GetAttribute("NoUsage") then
							if not Prompt.Enabled then
								break
							end
						else
							break
						end

						Prompt:InputHoldBegin()
						task.wait()
					end
				end
			end)
		end

		local function DoorOpen()
			Prompt.Enabled = false
			InteractAnim.Open:Play()
		end

		local function DoorClose()
			InteractAnim.Open:AdjustSpeed(-1)
			Asset.CollisionPart.CanCollide = true

			if not Asset:GetAttribute("NoUsage") then
				Prompt.Enabled = true
				AutoPromptHold()
			end
		end
		
		Prompt.Triggered:Connect(function()
			if not Asset:GetAttribute("NoUsage") then
				Asset.OpenValue.Value = true
			end
		end)
		
		if Asset:FindFirstChild("NormalDoor") then
			Asset.NormalDoor:Destroy()
		end
		
		if Type ~= "ProgressDoor" then
			if Asset:FindFirstChild("Enter") then
				Asset.Enter:Destroy()
			end
			
			if Asset:FindFirstChild("Exit") then
				Asset.Exit:Destroy()
			end
		end
		
		if Asset.Name == "BigDoor" then
			InteractAnim.Open:GetMarkerReachedSignal("Valve"):Connect(function(AnimValue)
				if (AnimValue ~= "Forward" or not Asset.OpenValue.Value) and (AnimValue ~= "Backward" or Asset.OpenValue.Value) then
					return
				end
				
				InteractSound.Valve:Play()
			end)
		end
		
		InteractAnim.Open:GetMarkerReachedSignal("Pause"):Connect(function()
			if Asset.OpenValue.Value then
				InteractAnim.Open:AdjustSpeed(0)
			end
		end)
		
		InteractAnim.Open:GetMarkerReachedSignal("Opened"):Connect(function()
			if Asset.OpenValue.Value and not Asset:GetAttribute("Stuck") then
				Asset.CollisionPart.CanCollide = false
				Asset.CollisionPart.CanQuery = false
			end
		end)
		
		InteractAnim.Open:GetMarkerReachedSignal("Sound"):Connect(function(AnimValue)
			if Asset.Name == "NormalDoor" then
				if (AnimValue ~= "Forward" or not Asset.OpenValue.Value) and (AnimValue ~= "Backward" or Asset.OpenValue.Value) then
					return
				end
			elseif Asset.Name == "BigDoor" then
				if (AnimValue == "Forward" and not Asset.OpenValue.Value) or (AnimValue == "Backward" and Asset.OpenValue.Value) then
					return
				end
			end
			
			if InteractSound.Open then
				InteractSound.Open:Play()
			elseif InteractSound.Open1 and InteractSound.Open2 then
				InteractSound["Open"..math.random(1, 2)]:Play()
			end
		end)
		
		AutoPromptHold()
		
		Asset.OpenValue:GetPropertyChangedSignal("Value"):Connect(function()
			if Asset.OpenValue.Value then
				DoorOpen()
			else
				DoorClose()
			end
		end)

		if Asset.OpenValue.Value then
			DoorOpen()
		else
			DoorClose()
		end
	elseif Asset.Name == "Locker" or Asset.Name == "BaldiLocker" then
		local MoveFunction = nil
		
		local Prompt = Asset:FindFirstChildWhichIsA("ProximityPrompt")
		Prompt:SetAttribute("Display", "Locker")
		Prompt:SetAttribute("Custom", true)
		
		local function BruteExit()
			
		end
		
		local function LockerExit()
			if PlayerMain.Locker.CantExit then
				return
			end
			
			if MoveFunction then
				MoveFunction:Disconnect()
				MoveFunction = nil
			end
			
			if PlayerMain.IsTeleporting then
				return
			end
			
			Asset.Folder.OpenValue.Value = "exit"
			Asset.Folder.PlayerIn.Value = false
			
			Asset.LockerCollision.CollisionGroup = "Default"
			
			PlayerMain.Locker = nil
			PlayerMain.Claustrophobia.FadeOut()
			PlayerMain.Main.Animations.LockerExit:Play()
			PlayerMain.Animations.LockerIdle:Stop()
			PlayerMain.CameraModule.Switch("HeadFollow")
			
			PlayerMain.Animations.LockerExit:GetMarkerReachedSignal("Finished"):Once(function(p12)
				PlayerMain.Animations.LockerExit:Stop(0)
				game.Players.LocalPlayer.Character:PivotTo(game.Players.LocalPlayer.Character.UpperTorso.CFrame)
				game.Players.LocalPlayer.Character.HumanoidRootPart.Anchored = false
				game.Players.LocalPlayer.Character.Humanoid.AutoRotate = true
			end)
			
			game.TweenService:Create(game.Workspace.CurrentCamera, TweenInfo.new(0.2), {
				FieldOfView = 90
			}):Play()
			
			PlayerMain.Animations.LockerExit.Stopped:Wait()
			
			if PlayerMain.Swimming.State then
				game.Players.LocalPlayer.Character.Humanoid.PlatformStand = true
				PlayerMain.Swimming.BodyVel.Enabled = true
				PlayerMain.CameraModule.Switch("Swimming")
			else
				PlayerMain.CameraModule.Switch("PlayerControl")
			end
			
			PlayerMain.CantOverrideCFrame = nil
			PlayerMain.Interactions.Base.AllDisabled = false
			game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = PlayerMain.CameraModule.GetWalkSpeed()
			
			task.wait(0.2)
			
			Prompt.Enabled = true
			PlayerMain.Toolbar.CanEquip = true
			PlayerMain.LockerState = false
		end
		
		local function LockerEnter()
			if game.Workspace:HasTag("LockersLocked") then
				return
			end
			
			if PlayerMain.LockedOut then
				PlayerMain.SubTitles.new("You need to calm down first", 3):Show()
				return
			end
			
			Prompt.Enabled = false
			
			Asset.Folder.PlayerIn.Value = true
			Asset.Folder.OpenValue.Value = "enter"
			
			PlayerMain.Locker = Asset
			PlayerMain.Interactions.Base.AllDisabled = true
			PlayerMain.Toolbar.CanEquip = false
			PlayerMain.CameraModule.Switch("HeadFollow")
			PlayerMain.LockerState = true
			PlayerMain.CantOverrideCFrame = true
			
			game.Players.LocalPlayer.PlayerFolder.HidInLocker.Value = true
			game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 0
			game.Players.LocalPlayer.Character.Humanoid.AutoRotate = false
			game.Players.LocalPlayer.Character:PivotTo(Asset.Start.CFrame)
			
			local Success, ErrorReason = pcall(function()
				PlayerMain.Toolbar.UnSelect()
			end)
			if not Success then
				warn(ErrorReason)
			end
			
			task.defer(function()
				repeat
					game.Players.LocalPlayer.Character.HumanoidRootPart.Anchored = true
					game.Players.LocalPlayer.Character.HumanoidRootPart.Anchored = false
					game.RunService.Heartbeat:Wait()
				until not Asset.Folder.PlayerIn.Value or game.Players.LocalPlayer.Character.HumanoidRootPart.Position == Asset.Start.Position
			end)
			
			if PlayerMain.Swimming.State then
				PlayerMain.Swimming.BodyVel.Enabled = false
				if PlayerMain.Swimming.CurrentlyPlaying then
					PlayerMain.Swimming.Main.Animations[PlayerMain.Swimming.CurrentlyPlaying]:Stop()
				end
				PlayerMain.Swimming.CurrentlyPlaying = nil
				PlayerMain.Swimming.BodyVel.VectorVelocity = Vector3.new(0, 0, 0)
				if PlayerMain.CameraModule.SwimTween then
					PlayerMain.CameraModule.SwimTween:Cancel()
				end
				game.Players.LocalPlayer.Character:PivotTo(game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 0.65, 0))
			end
			
			task.spawn(function()
				while Asset.Folder.PlayerIn.Value do
					task.wait(0.01)
					if not Asset or not Asset:FindFirstChild("Folder") or not Asset.Folder:FindFirstChild("PlayerIn") or not Asset.Folder.PlayerIn.Value then
						break
					end
					if not ((game.Players.LocalPlayer.Character.HumanoidRootPart.Position - Asset.Root.Position).Magnitude > 9) then
						continue
					end
					print("while player in locker he went too far away")
					LockerExit()
				end
			end)
			
			PlayerMain.Animations.LockerEnter:Play()
			PlayerMain.Animations.LockerEnter:GetMarkerReachedSignal("Finished"):Once(function()
				game.Players.LocalPlayer.Character:PivotTo(Asset.Start.CFrame)
				PlayerMain.Animations.LockerIdle:Play()
				game.Players.LocalPlayer.Character.HumanoidRootPart.Anchored = true
			end)
			
			Asset.LockerCollision.CollisionGroup = "Player"
			
			game.TweenService:Create(game.Workspace.CurrentCamera, TweenInfo.new(0.9), {
				FieldOfView = 50
			}):Play()
			
			PlayerMain.Animations.LockerEnter.Stopped:Wait()
			
			task.wait(0.3)
			
			PlayerMain.LockerPeek = true
			PlayerMain.CameraModule.Switch("LockerCamera")
			PlayerMain.Claustrophobia.Start(Asset, 10, 15)
			
			task.wait(0.2)
			
			MoveFunction = game.Players.LocalPlayer.Character.Humanoid:GetPropertyChangedSignal("MoveDirection"):Connect(function()
				LockerExit()
			end)
		end
		
		Prompt.Triggered:Connect(function()
			if not (PlayerMain.PlayerDead or PlayerMain.IsGhost or PlayerMain.HangerImmunity) then
				LockerEnter()
			end
		end)
		
		InteractAnim.Enter:GetMarkerReachedSignal("LockerOpen"):Connect(function()
			InteractSound.Enter:Play()
		end)
		
		InteractAnim.Enter:GetMarkerReachedSignal("LockerClose"):Connect(function()
			InteractSound.Exit:Play()
		end)
		
		InteractAnim.Exit:GetMarkerReachedSignal("LockerOpen"):Connect(function()
			InteractSound.Enter:Play()
		end)
		
		InteractAnim.Exit:GetMarkerReachedSignal("LockerClose"):Connect(function()
			InteractSound.Exit:Play()
		end)

		Asset.Folder.OpenValue:GetPropertyChangedSignal("Value"):Connect(function()
			if Asset.Folder.OpenValue.Value == "enter" then
				InteractAnim.Enter:Play()
			elseif Asset.Folder.OpenValue.Value == "exit" and not InteractSound.Close.IsPlaying then
				InteractAnim.Exit:Play()
			end
		end)
	elseif Asset.Name == "ItemLocker" or Asset.Name == "BaldiItemLocker" then
		local InteractCooldown = false
		
		local Prompt = Asset.Door:FindFirstChildWhichIsA("ProximityPrompt")
		Prompt:SetAttribute("Display", "Item Locker")
		Prompt:SetAttribute("Custom", true)
		
		local function DoorOpen()
			InteractSound.Open:Play()
			InteractAnim.Open:Play()
			InteractAnim.Open:AdjustSpeed(2)
		end

		local function DoorClose()
			InteractSound.Close:Play()
			InteractAnim.Open:Play(0.1, 1, -1)
			InteractAnim.Open:AdjustSpeed(2)
		end
		
		Prompt.Triggered:Connect(function()
			if not InteractCooldown and not Asset:GetAttribute("NoUsage") then
				InteractCooldown = true
				Asset.Closed.Value = not Asset.Closed.Value
				
				task.wait(0.3)
				
				InteractCooldown = false
			end
		end)
		
		if Asset:FindFirstChild("SpawnLocations") then
			for _, SpawnLocation in Asset.SpawnLocations:GetChildren() do
				if SpawnLocation:IsA("BasePart") then
					SpawnLocation.Transparency = 1
				end
			end
		end
		
		InteractAnim.Open:GetMarkerReachedSignal("Pause"):Connect(function()
			InteractAnim.Open:AdjustSpeed(0)
			InteractCooldown = false
		end)
		
		Asset.Closed:GetPropertyChangedSignal("Value"):Connect(function()
			if not Asset.Closed.Value then
				DoorOpen()
			else
				DoorClose()
			end
		end)

		if not Asset.Closed.Value then
			DoorOpen()
		else
			DoorClose()
		end
	else
		if Asset:FindFirstChild("Drawers") then
			for _, Drawer in Asset.Drawers:GetChildren() do
				if Drawer:IsA("BasePart") and Drawer:FindFirstChild("Drawer") then
					InteractAnim[Drawer].Open = game.TweenService:Create(Drawer, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),{
						CFrame = Drawer.CFrame * CFrame.new(0, 0, -1.3)
					})
					InteractAnim[Drawer].Close = game.TweenService:Create(Drawer, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In),{
						CFrame = Drawer.CFrame
					})
					
					InteractSound[Drawer].Open = game.ReplicatedStorage.CustomAssets.RoomAssets.Sounds.Furniture.DrawerOpen:Clone()
					InteractSound[Drawer].Open.Parent = Drawer.Drawer.HighLight
					InteractSound[Drawer].Close = game.ReplicatedStorage.CustomAssets.RoomAssets.Sounds.Furniture.DrawerClose:Clone()
					InteractSound[Drawer].Close.Parent = Drawer.Drawer.HighLight
					
					local InteractCooldown = false

					local Prompt = Drawer.Drawer.HighLight:FindFirstChildWhichIsA("ProximityPrompt")
					Prompt:SetAttribute("Display", "Drawer")
					Prompt:SetAttribute("Custom", true)
					
					local function DrawerOpen()
						InteractAnim[Drawer].Open:Play()
						InteractSound[Drawer].Open:Play()
					end

					local function DrawerClose()
						InteractAnim[Drawer].Close:Play()
						InteractSound[Drawer].Close:Play()
					end
					
					Prompt.Triggered:Connect(function()
						if not InteractCooldown and not Asset:GetAttribute("NoUsage") then
							InteractCooldown = true
							Drawer.Drawer.OpenValue.Value = not Drawer.Drawer.OpenValue.Value

							task.wait(0.5)

							InteractCooldown = false
						end
					end)
					
					Drawer.Drawer.OpenValue:GetPropertyChangedSignal("Value"):Connect(function()
						if Drawer.Drawer.OpenValue.Value then
							DrawerOpen()
						else
							DrawerClose()
						end
					end)

					if Drawer.Drawer.OpenValue.Value then
						DrawerOpen()
					else
						DrawerClose()
					end
				end
			end
		end
	end
end)
