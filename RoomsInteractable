local UI = game.Players.LocalPlayer.PlayerGui.FunnyMenu
local InteractableAssets = {}

UI.Events.RoomAssetInteraction.Event:Connect(function(Asset, Type)
	if table.find(InteractableAssets, Asset) then
		return print(Asset.Name.." Already Interactable")
	end
	
	table.insert(InteractableAssets, Asset)
	
	local InteractAnim = {}
	local InteractSound = {}
	
	for _, Category in game.ReplicatedStorage.CustomAssets.RoomAssets.Sounds:GetChildren() do
		for _, Sound in Category:GetChildren() do
			if string.find(Sound.Name, Asset.Name) and Sound:IsA("Sound") then
				InteractSound[string.split(Sound.Name, Asset.Name)[2]] = Sound:Clone()
				InteractSound[string.split(Sound.Name, Asset.Name)[2]].Name = string.split(Sound.Name, Asset.Name)[2]

				if type(Sound:GetAttribute("UsageParent")) == "string" or type(Sound:GetAttribute("UsageParent")) == "number" then
					InteractSound[string.split(Sound.Name, Asset.Name)[2]].Parent = UI.Events.UIModule:Invoke("FindByThread", Asset, Sound:GetAttribute("UsageParent"))
				else
					return error("No UsageParent For "..Sound.Name..". Asset: "..Asset.Name)
				end
			end
		end
	end

	for _, Category in game.ReplicatedStorage.CustomAssets.RoomAssets.Animations:GetChildren() do
		for _, Anim in Category:GetChildren() do
			if string.find(Anim.Name, Asset.Name) and Anim:IsA("Animation") then
				InteractAnim[string.split(Anim.Name, Asset.Name)[2]] = Asset.AnimationController.Animator:LoadAnimation(Anim)
			end
		end
	end
	
	if Asset.Name == "NormalDoor" or Asset.Name == "BigDoor" then
		local Prompt = Asset.Root:FindFirstChildWhichIsA("ProximityPrompt")
		Prompt.Triggered:Connect(function()
			if not Asset:GetAttribute("NoUsage") then
				Asset.OpenValue.Value = true
			end
		end)
		
		if Asset.Name == "BigDoor" then
			InteractAnim.Open:GetMarkerReachedSignal("Valve"):Connect(function(AnimValue)
				if (AnimValue ~= "Forward" or not Asset.OpenValue.Value) and (AnimValue ~= "Backward" or Asset.OpenValue.Value) then
					return
				end
				
				InteractSound.Valve:Play()
			end)
		end
		
		InteractAnim.Open:GetMarkerReachedSignal("Pause"):Connect(function()
			if Asset.OpenValue.Value then
				InteractAnim.Open:AdjustSpeed(0)
			end
		end)
		
		InteractAnim.Open:GetMarkerReachedSignal("Opened"):Connect(function()
			if Asset.OpenValue.Value and not Asset:GetAttribute("Stuck") then
				Asset.CollisionPart.CanCollide = false
				Asset.CollisionPart.CanQuery = false
			end
		end)
		
		InteractAnim.Open:GetMarkerReachedSignal("Sound"):Connect(function(AnimValue)
			if Asset.Name == "NormalDoor" then
				if (AnimValue ~= "Forward" or not Asset.OpenValue.Value) and (AnimValue ~= "Backward" or Asset.OpenValue.Value) then
					return
				end
			elseif Asset.Name == "BigDoor" then
				if (AnimValue == "Forward" and not Asset.OpenValue.Value) or (AnimValue ~= "Backward" or Asset.OpenValue.Value) then
					return
				end
			end
			
			if InteractSound.Open then
				InteractSound.Open:Play()
			elseif InteractSound.Open1 and InteractSound.Open2 then
				InteractSound["Open"..math.random(1, 2)]:Play()
			end
		end)
		
		if Asset:FindFirstChild("NormalDoor") then
			Asset.NormalDoor:Destroy()
		end
		
		if Type ~= "ProgressDoor" then
			if Asset:FindFirstChild("Enter") then
				Asset.Enter:Destroy()
			end
			
			if Asset:FindFirstChild("Exit") then
				Asset.Exit:Destroy()
			end
		end
		
		local function AutoPromptHold()
			task.spawn(function()
				if Prompt then
					while Prompt do
						if Prompt and not Asset:GetAttribute("NoUsage") then
							if not Prompt.Enabled then
								break
							end
						else
							break
						end

						Prompt:InputHoldBegin()
						task.wait()
					end
				end
			end)
		end
		
		AutoPromptHold()
		
		local function DoorOpen()
			Prompt.Enabled = false
			InteractAnim.Open:Play()
		end
		
		local function DoorClose()
			InteractAnim.Open:AdjustSpeed(-1)
			Asset.CollisionPart.CanCollide = true

			if not Asset:GetAttribute("NoUsage") then
				Prompt.Enabled = true
				AutoPromptHold()
			end
		end
		
		Asset.OpenValue:GetPropertyChangedSignal("Value"):Connect(function()
			if Asset.OpenValue.Value then
				DoorOpen()
			else
				DoorClose()
			end
		end)

		if Asset.OpenValue.Value then
			DoorOpen()
		else
			DoorClose()
		end
	elseif Asset.Name == "ItemLocker" or Asset.Name == "BaldiItemLocker" then
		local InteractCooldown = false
		
		local Prompt = Asset.Door:FindFirstChildWhichIsA("ProximityPrompt")
		Prompt.Triggered:Connect(function()
			if not InteractCooldown and not Asset:GetAttribute("NoUsage") then
				InteractCooldown = true
				Asset.Closed.Value = not Asset.Closed.Value
				
				task.wait(0.3)
				
				InteractCooldown = false
			end
		end)
		
		InteractAnim.Open:GetMarkerReachedSignal("Pause"):Connect(function() --[[ Line: 34 | Upvalues: p2 (copy) ]]
			InteractAnim.Open:AdjustSpeed(0)
			InteractCooldown = false
		end)
		
		local function DoorOpen()
			InteractSound.Open:Play()
			InteractAnim.Open:Play()
			InteractAnim.Open:AdjustSpeed(2)
		end

		local function DoorClose()
			InteractSound.Close:Play()
			InteractAnim.Open:Play(0.1, 1, -1)
			InteractAnim.Open:AdjustSpeed(2)
		end
		
		Asset.Closed:GetPropertyChangedSignal("Value"):Connect(function()
			if Asset.Closed.Value then
				DoorOpen()
			else
				DoorClose()
			end
		end)

		if Asset.Closed.Value then
			DoorOpen()
		else
			DoorClose()
		end
	end
end)
